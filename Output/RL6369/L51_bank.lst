                   15557     ;------------------------------------------------------------------------------
                   15558     ;  This file is part of the BL51 / LX51 Banked Linker/Locater package
                   15559     ;  Copyright (c) 1988 - 2001 Keil Elektronik GmbH and Keil Software, Inc.
                   15560     ;  Version 2.21 (Code and Variable Banking for Classic 8051 Derivatives)
                   15561     ;------------------------------------------------------------------------------
                   15562     ;************************ Configuration Section *******************************
                   15563     ; Define maximum Number of Banks                                              *
  0010             15564     ?B_NBANKS       EQU  0x10;                  *
                   15565     ;                         ; following values are allowed: 2, 4, 8, 16, 32, 64 *
                   15566     ;                         ; for BL51 the maximum value for ?B_BANKS is 32     *
                   15567     ;                         ; for LX51 the maximum value for ?B_BANKS is 64     *
                   15568     ;                                                                             *
  0001             15569     ?B_MODE         EQU  1    ; 0 for Bank-Switching via 8051 Port                *
                   15570     ;                         ; 1 for Bank-Switching via XDATA Port               *
                   15571     ;                         ; 4 for user-provided bank switch code              *
                   15572     ;                                                                             *
  0000             15573     ?B_RTX          EQU  0    ; 0 for applications without real-time OS           *
                   15574     ;                         ; 1 for applications using the RTX-51 real-time OS  *
                   15575     ;                                                                             *
  0000             15576     ?B_VAR_BANKING  EQU  0    ; Variable Banking via L51_BANK (far memory support)*
                   15577     ;                         ; 0 Variable Banking does not use L51_BANK.A51      *
                   15578     ;                         ; 1 Variable Banking uses this L51_BANK.A51 module  *
                   15579     ; Notes: ?B_VAR_BANKING uses the 'far' and 'far const' C51 memory types to    *
A51 MACRO ASSEMBLER  L51_BANK                                                             10/13/2026 18:29:40 PAGE    59

                   15580     ;        extent the space for variables in RAM and/or ROM of classic 8051     *
                   15581     ;        device.  The same hardware as for code banking is used.  Program     *
                   15582     ;        code banking and variable banking share the same hardware I/O pins.  *
                   15583     ;        The C51 Compiler must be used with the VARBANKING directive.         *
                   15584     ;        Variable Banking is only supported with the LX51 linker/locater.     *
                   15585     ;                                                                             *
  00FF             15586     ?B_RST_BANK     EQU  0xFF ; specifies the active code bank number after CPU   *
                   15587     ;                         ; Reset.  Used to reduce the entries in the         *
                   15588     ;                         ; INTERBANK CALL TABLE.  The value 0xFF disables    *
                   15589     ;                         ; this LX51 linker/locater optimization.            *
                   15590     ; Note:  Interbank Call Table optimization is only possible with LX51.        *
                   15591     ;                                                                             *
                   15592     ;-----------------------------------------------------------------------------*
                   15593     ;                                                                             *
                             ENDIF;                                                                        *
                   15606     ;                                                                             *
                   15607     IF  ?B_MODE = 1;                                                              *
                   15608     ;-----------------------------------------------------------------------------*
                   15609     ; if ?BANK?MODE is 1 define the following values                              *
                   15610     ; For Bank-Switching via XDATA Port define XDATA Port Address / Bits          *
  FFFF             15611     ?B_XDATAPORT    EQU     0FFFFH   ; default is XDATA Port Address 0FFFFH       *
  0000             15612     ?B_FIRSTBIT     EQU     0        ; default is Bit 0                           *
                   15613     ;-----------------------------------------------------------------------------*
                   15614     ENDIF;                                                                        *
                   15615     ;                                                                             *
                             ENDIF;                                                                        *
                   15674     ;                                                                             *
                             ENDIF;                                                                        *
                   15695     ;                                                                             *
                   15696     ;******************************************************************************
                   15697     ;                                                                             *
                   15698     ; THEORY OF OPERATION                                                         *
                   15699     ; -------------------                                                         *
                   15700     ; The section below describes the code generated by BL51 or LX51 and the      *
                   15701     ; operation of the L51_BANK.A51 module.  BL51/LX51 generates for each         *
                   15702     ; function that is located in a code memory bank and called from the common   *
                   15703     ; area or a different code bank and entry into the INTRABANK CALL TABLE.  The *
                   15704     ; INTRABANK CALL TABLE is located in the SEGMENT ?BANK?SELECT and listed in   *
                   15705     ; the Linker MAP file. The entries in that TABLE have the following format:   *
                   15706     ;                                                                             *
                   15707     ;   ?FCT?1:  MOV  DPTR,#FCT     ; Load Address of target FCT                  *
                   15708     ;            JMP  ?B_BANKn      ; Switch to Bank and Jump to Target Code      *
                   15709     ;                                                                             *
                   15710     ; Instead of directly calling the function FCT, the Linker changes the entry  *
                   15711     ; to ?FCT?1.  This entry selects the bank where the function FCT is located   *
                   15712     ; and calls that function via the routines defined in this L51_BANK.A51 file. *
                   15713     ; The L51_BANK.A51 file contains two sets of functions for each bank:         *
                   15714     ;                                                                             *
                   15715     ; ?B_BANKn    is a routine which saves the entry of the ?B_SWITCHn function   *
                   15716     ;             for the current active bank on the STACK and switches to the    *
                   15717     ;             bank 'n'.  Then it jumps to the address specified by the DPTR   *
                   15718     ;             register.  It is allowed to modify the following registers in   *
                   15719     ;             the ?B_BANKn routine:  A, B, R0, DPTR, PSW                      *
                   15720     ;                                                                             *
                   15721     ; ?B_SWITCHn  is a function which selects the bank 'n'.  This function is     *
                   15722     ;             used at the end of a user function to return to the calling     *
                   15723     ;             code bank.  Only the following registers may be altered in the  *
                   15724     ;             ?B_SWITCHn function:  R0, DPTR                                  *
                   15725     ;                                                                             *
                   15726     ; The current active bank is stored in ?B_CURRENTBANK.  RTX-51 uses this      *
                   15727     ; variable to restore the code bank after a task switch.  To get correct      *
                   15728     ; results, ?B_CURRENTBANK must be set to the code bank before the hardware    *
                   15729     ; switch is done, or the code banking sequences must be interrupt protected.  *
                   15730     ;******************************************************************************
                   15731     
                   15732                     NAME    ?BANK?SWITCHING
A51 MACRO ASSEMBLER  L51_BANK                                                             10/13/2026 18:29:40 PAGE    60

                   15733     
                   15734                     PUBLIC  ?B_NBANKS, ?B_MODE, ?B_CURRENTBANK, ?B_MASK
                   15735                     PUBLIC  ?B_FACTOR, ?B_RST_BANK
                             ENDIF
                   15739     
                   15740     ; Standard SFR Symbols required in L51_BANK.A51
  00E0             15741     ACC     DATA    0E0H
  00F0             15742     B       DATA    0F0H
  0082             15743     DPL     DATA    82H
  0083             15744     DPH     DATA    83H
  00A8             15745     IE      DATA    0A8H
  00AF             15746     EA      BIT     IE.7
                   15747     
                   15748     
                   15749     ; generate Mask and Bank Number Information
                             ELSEIF  ?B_NBANKS <= 16
  000F             15757       MASK          EQU     00001111B
                             ENDIF
                   15763     
                             ENDIF  ; close block IF ?B_MODE = 0 *******************************************
                   16017     
