 358          void OsdFontPut1Bit(BYTE ucRow, BYTE ucCol, BYTE ucIcon, BYTE ucColor, BYTE ucPage)
 359          {
 360   1          WORD xdata usOsdAddr = (WORD)ucRow * g_ucOsdWidth + ucCol;
 361   1          BYTE xdata ucByte0 = 0x4C;
 362   1              if(ucPage == 1)
 363   1              {
 364   2                      ucByte0 = 0x6C;
 365   2              }
 366   1      #if(_OSD_ROTATE_FUNCTION == _OSD_ROTATE_SOFTWARE)
                  if(GET_OSD_ROTATE_STATUS() == _OSD_ROTATE_DEGREE_90)
                  {
                      usOsdAddr = (WORD)((g_ucOsdWidth - ucRow - 1) + g_ucOsdWidth * ucCol);
                      ucByte0 = 0x4E;
                  }
                  else if(GET_OSD_ROTATE_STATUS() == _OSD_ROTATE_DEGREE_270)
                  {
                      usOsdAddr = (WORD)(g_ucOsdHeight - 1 - ucCol) * g_ucOsdWidth + ucRow;
                      ucByte0 = 0x4E;
                  }
              #endif
 378   1      
 379   1          ScalerOsdCommandAllByte(usOsdAddr + g_usFontSelectStart, ucByte0, ucIcon, ucColor);
 380   1      }
