                  if((GET_OSD_ROTATE_STATUS() == _OSD_ROTATE_DEGREE_90) ||
                     (GET_OSD_ROTATE_STATUS() == _OSD_ROTATE_DEGREE_270))
                  {
                      ucOsdWidth = g_ucOsdHeight;
                  }
                  else
              #endif
 401   1          {
 402   2              ucOsdWidth = g_ucOsdWidth;
 403   2          }
 404   1      
 405   1          while(*pucArray != _END_)
 406   1          {
 407   2              if(*pucArray == _NEXT_)
 408   2              {
 409   3                  ucRow++;
