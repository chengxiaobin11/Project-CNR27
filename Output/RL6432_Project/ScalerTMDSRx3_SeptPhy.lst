 136          //--------------------------------------------------
 137          // Description  : Set Config of TMDS Mac Deonly mode
 138          // Input Value  : None
 139          // Output Value : enumInputPort, enumDeonlyConfig
 140          //--------------------------------------------------
 141          void ScalerTMDSRx3SetDeOnlyModeConfig(EnumDeOnlyConfig enumDeonlyConfig)
 142          {
 143   1          // De only enable?
 144   1          if((enumDeonlyConfig & _DE_ONLY_DISABLE) == _DE_ONLY_DISABLE)
 145   1          {
 146   2              ScalerSetBit(P72_A7_TMDS_PWDCTL, ~_BIT7, 0x00);
 147   2          }
 148   1          else if((enumDeonlyConfig & _DE_ONLY_ENABLE) == _DE_ONLY_ENABLE)
 149   1          {
 150   2              ScalerSetBit(P72_A7_TMDS_PWDCTL, ~_BIT7, _BIT7);
 151   2          }
 152   1      
 153   1          // Set HS
 154   1          if((enumDeonlyConfig & _DE_ONLY_HS_8T) == _DE_ONLY_HS_8T)
 155   1          {
 156   2              ScalerSetBit(P72_AB_TMDS_ACC2, ~_BIT7, _BIT7);
 157   2          }
 158   1          else if((enumDeonlyConfig & _DE_ONLY_HS_72T) == _DE_ONLY_HS_72T)
 159   1          {
 160   2              ScalerSetBit(P72_AB_TMDS_ACC2, ~_BIT7, 0x00);
 161   2          }
 162   1      }
 163          
 164          //--------------------------------------------------
 165          // Description  : Get Config of TMDS Mac Deonly mode
 166          // Input Value  : None
 167          // Output Value : EnumDeOnlyConfig
 168          //--------------------------------------------------
 169          EnumDeOnlyConfig ScalerTMDSRx3GetDeOnlyModeConfig(void)
C51 COMPILER V9.60.0.0   SCALERTMDSRX3_SEPTPHY                                             09/18/2026 20:38:29 PAGE 4   

 170          {
 171   1          EnumDeOnlyConfig enumDeConfig = _DE_NO_INDICATED;
 172   1      
 173   1          if(ScalerGetBit(P72_A7_TMDS_PWDCTL, _BIT7) == _BIT7)
 174   1          {
 175   2              enumDeConfig = _DE_ONLY_ENABLE;
 176   2          }
 177   1          else
 178   1          {
 179   2              enumDeConfig = _DE_ONLY_DISABLE;
 180   2          }
 181   1      
 182   1          if(ScalerGetBit(P72_AB_TMDS_ACC2, _BIT7) == _BIT7)
 183   1          {
 184   2              enumDeConfig |= _DE_ONLY_HS_8T;
 185   2          }
 186   1          else
 187   1          {
 188   2              enumDeConfig |= _DE_ONLY_HS_72T;
 189   2          }
 190   1      
 191   1          return enumDeConfig;
 192   1      }
