 863          // Description  : TMDS Read Request Outcome Case Processing(EXINT0 Only)
 864          // Input Value  : None
 865          // Output Value : None
 866          //--------------------------------------------------
 867          void ScalerTMDSRx3ReadRequestProc_EXINT0(BYTE ucRROutCome) using 1
 868          {
 869   1          // Get Read Request Outcome Case
 870   1          switch(ucRROutCome)
 871   1          {
 872   2              case _HDMI_2_0_READ_REQUEST_ACK_DONE:
 873   2              case _HDMI_2_0_READ_REQUEST_ACK_STOP:
 874   2      
 875   2                  break;
 876   2      
 877   2              case _HDMI_2_0_READ_REQUEST_NACK1:
 878   2      
 879   2                  if(GET_HDMI_2_0_RX3_RR_ENABLE() == _TRUE)
 880   2                  {
 881   3                      // FW Manual Enable Read Request
 882   3                      ScalerSetBit_EXINT(P72_1B_HDMI_CTRL_1B, ~_BIT7, _BIT7);
 883   3                  }
 884   2      
 885   2                  break;
 886   2      
 887   2              case _HDMI_2_0_READ_REQUEST_NACK2:
 888   2      
 889   2      #if(_WD_TIMER_INT_SUPPORT == _ON)
 890   2                  if(GET_HDMI_2_0_RX3_RR_ENABLE() == _TRUE)
 891   2                  {
 892   3                      // Enable Read Request Retry
 893   3                      ScalerTimerWDActivateTimerEvent_EXINT0(10, _SCALER_WD_TIMER_EVENT_RX3_HDMI_RR_RETRY);
 894   3                  }
 895   2      #endif
 896   2      
 897   2                  break;
 898   2      
 899   2              default:
 900   2      
 901   2                  break;
