 210          //--------------------------------------------------
 211          // Description  : Detect TMDS video mode
 212          // Input Value  : bWait => Whether to wait then read
 213          // Output Value : TMDS video type
 214          //--------------------------------------------------
 215          BYTE ScalerTMDSRx3TMDSVideoDetect(bit bWait)
 216          {
 217   1          BYTE ucTemp = _TMDS_VIDEO_DATA_NONE;
 218   1      
 219   1          if(bWait == _WAIT)
 220   1          {
 221   2              // Wait at least 1 frame for HW auto update TMDS video RGBHV valid value
 222   2              ScalerTimerPollingFlagProc(45, P72_A4_TMDS_CTRL, _BIT3, _TRUE);
 223   2      
 224   2              // Wait for HW update DE flag
 225   2              if(ScalerTimerPollingFlagProc(20, P72_A4_TMDS_CTRL, (_BIT7 | _BIT6 | _BIT5), _TRUE) == _TRUE)
 226   2              {
 227   3                  // H/Vsync received
 228   3                  if(ScalerGetBit(P72_A4_TMDS_CTRL, (_BIT4 | _BIT3)) == (_BIT4 | _BIT3))
 229   3                  {
 230   4                      ucTemp = _TMDS_VIDEO_DATA_RGBHV;
 231   4                  }
C51 COMPILER V9.60.0.0   SCALERTMDSRX3_SEPTPHY                                             09/18/2026 20:38:29 PAGE 5   

 232   3                  else
 233   3                  {
 234   4                      ucTemp = _TMDS_VIDEO_DATA_DE_ONLY;
 235   4                  }
 236   3              }
 237   2              else
 238   2              {
 239   3                  ucTemp = _TMDS_VIDEO_DATA_NONE;
 240   3              }
 241   2      
 242   2              CLR_TMDS_RX3_RGBHV_DETECTING();
 243   2      
 244   2              return ucTemp;
 245   2          }
 246   1          else
 247   1          {
 248   2              // R/G/B data detected
 249   2              if(ScalerGetBit(P72_A4_TMDS_CTRL, (_BIT7 | _BIT6 | _BIT5)) == (_BIT7 | _BIT6 | _BIT5))
 250   2              {
 251   3                  // H/Vsync received
 252   3                  if(ScalerGetBit(P72_A4_TMDS_CTRL, (_BIT4 | _BIT3)) == (_BIT4 | _BIT3))
 253   3                  {
 254   4                      ucTemp = _TMDS_VIDEO_DATA_RGBHV;
 255   4                  }
 256   3                  else
 257   3                  {
 258   4                      ucTemp = _TMDS_VIDEO_DATA_DE_ONLY;
 259   4                  }
 260   3              }
 261   2              else
 262   2              {
 263   3                  ucTemp = _TMDS_VIDEO_DATA_NONE;
 264   3              }
 265   2      
 266   2              // Clear video Detection Flag
 267   2              ScalerSetBit(P72_A4_TMDS_CTRL, ~(_BIT7 | _BIT6 | _BIT5 | _BIT4 | _BIT3), (_BIT7 | _BIT6 | _BIT5 | 
             -_BIT4 | _BIT3));
 268   2      
 269   2              SET_TMDS_RX3_RGBHV_DETECTING();
 270   2      
 271   2              // Activate TMDS video Detection Event
 272   2              ScalerTimerActiveTimerEvent(45, _SCALER_TIMER_EVENT_RX3_TMDS_VIDEO_DETECT);
 273   2      
 274   2              return ucTemp;
 275   2          }
 276   1      }
