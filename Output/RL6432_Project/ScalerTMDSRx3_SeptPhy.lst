 824   1          ScalerSetBit(P72_01_HDMI_CTRL_01, ~_BIT3, _BIT3);
 825   1      
 826   1          ScalerTimerCancelTimerEvent(_SCALER_TIMER_EVENT_RX3_HDMI2_SCRAMBLE_DETECT_TIMEOUT);
 827   1      }
