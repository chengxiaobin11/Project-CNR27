 554          //--------------------------------------------------
 555          // Description  : Get Color Depth
 556          // Input Value  : None
 557          // Output Value : Received Color Depth
 558          //--------------------------------------------------
 559          BYTE ScalerTMDSRx3HdmiGetColorDepth(void)
 560          {
 561   1          if(GET_COLOR_SPACE() == _COLOR_SPACE_YCBCR422)
 562   1          {
 563   2              return _COLOR_DEPTH_12_BITS;
 564   2          }
 565   1      
 566   1          if(GET_HDMI_RX3_GCP_RECEIVED() == _TRUE)
 567   1          {
 568   2              if(ScalerGetBit(P72_B4_TMDS_DPC0, 0x07) == 0x05)
 569   2              {
 570   3                  return _COLOR_DEPTH_10_BITS;
 571   3              }
 572   2              else if(ScalerGetBit(P72_B4_TMDS_DPC0, 0x07) == 0x06)
 573   2              {
 574   3                  return _COLOR_DEPTH_12_BITS;
 575   3              }
 576   2              else if(ScalerGetBit(P72_B4_TMDS_DPC0, 0x07) == 0x07)
 577   2              {
 578   3                  return _COLOR_DEPTH_16_BITS;
 579   3              }
 580   2          }
 581   1      
 582   1          return _COLOR_DEPTH_8_BITS;
 583   1      }
