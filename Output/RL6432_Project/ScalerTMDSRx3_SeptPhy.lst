 815          void ScalerTMDSRx3ScrambleStatusReset(void)
 816          {
 817   1          // Set Scramble Detect Manual Mode
 818   1          ScalerSetBit(P72_38_HDMI_CTRL_38, ~(_BIT4 | _BIT2 | _BIT1), 0x00);
 819   1      
 820   1          // Disable Scrambling Status
