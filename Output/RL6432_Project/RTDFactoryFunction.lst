              void RTDBurnInEdidMenu(void)
              {
                BYTE Port=0;
                cnt=0;//must set to 0
              #if(Project_ID == ID_DX_HK2556E01_1P2H_SG2361B023_FHD60HZ_20240118)
                RTDBurnInGetEdidInfo(_OSD_INPUT_D3);
                RTDBurnInGetEdidInfo(_OSD_INPUT_D1);
              #elif(_PCB_TYPE == _RL6432__156PIN__HKMRT2556E01__2H1DP__LVDS)
                  RTDBurnInGetEdidInfo(_OSD_INPUT_D0);
                RTDBurnInGetEdidInfo(_OSD_INPUT_D3);
                RTDBurnInGetEdidInfo(_OSD_INPUT_D1);
              #elif(_PCB_TYPE == _RL6463__128PIN__HKMRT2525E02__1A2H__LVDS && _DEF_HDMI_SWAP)
                RTDBurnInGetEdidInfo(_OSD_INPUT_A0);
                RTDBurnInGetEdidInfo(_OSD_INPUT_D1);
                RTDBurnInGetEdidInfo(_OSD_INPUT_D0);
              #elif(_PCB_TYPE == _RL6463__128PIN__HKMRT2525E02__1A2H__LVDS)
              #if _VGA1_SUPPORT
                RTDBurnInGetEdidInfo(_OSD_INPUT_A0);
              #endif
              #if _HDMI1_SUPPORT
                RTDBurnInGetEdidInfo(_OSD_INPUT_D1);
              #endif
              #if _HDMI0_SUPPORT
                RTDBurnInGetEdidInfo(_OSD_INPUT_D0);
              #endif
              #elif 0//(_PCB_TYPE == _RL6432__156PIN__HKMRT2557E17_1T1P1H_LVDS)
                RTDBurnInGetEdidInfo(_OSD_INPUT_D0);
                RTDBurnInGetEdidInfo(_OSD_INPUT_D1);
                //RTDBurnInGetEdidInfo(_OSD_INPUT_D3);
              #else
                for(Port=0;Port<=(_OSD_INPUT_AMOUNT-_SOURCE_AUTO_ON);Port++)
                {
                  RTDBurnInGetEdidInfo(Port);
                }
              
              #endif
              
                
              }
