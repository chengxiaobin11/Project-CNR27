 228   1          else if(ucInputPort == _A2_INPUT_PORT)
 229   1          {
 230   2      #if(_A2_VGA_CONNECTOR_TYPE == _VGA_CONNECTOR_YPBPR)
                      pData[0] = _FALSE;
              #endif
 233   2          }
 234   1      
 235   1          if(pData[0] == _TRUE)
 236   1          {
 237   2              if(ScalerSyncProcHSSyncStableDetect() == _TRUE)
 238   2              {
 239   3                  if(ScalerSyncProcStableCheck() == _TRUE)
 240   3                  {
 241   4                      return _TRUE;
 242   4                  }
 243   3              }
 244   2              else
 245   2              {
 246   3                  // Inverse CS_RAW signal for repeat check status
 247   3                  ScalerSetBit(P0_48_SYNC_INVERT, ~_BIT3, ((~(ScalerGetBit(P0_48_SYNC_INVERT, _BIT3))) & _BIT3))
             -;
 248   3      
 249   3                  if(ScalerSyncProcHSSyncStableDetect() == _TRUE)
 250   3                  {
 251   4                      if(ScalerSyncProcStableCheck() == _TRUE)
 252   4                      {
 253   5                          return _TRUE;
 254   5                      }
 255   4                  }
 256   3              }
 257   2          }
 258   1      
 259   1      #if(_SOG_SUPPORT == _ON)
                  // Enable DC Restore
                  ScalerADCDCRestoreEn(_ENABLE);
              
                  // SOG power up
                  ScalerSetBit(P0_C6_ADC_POWER, ~_BIT5, _BIT5);
              
                  // Wait for SOG Stable
                  ScalerTimerDelayXms(5);
              
                  if(ScalerSyncProcSogSyncCheck() == _TRUE)
                  {
                      if(ScalerSyncProcStableCheck() == _TRUE)
                      {
                          if(ScalerSyncProcRecheckSOGSyncStable() == _TRUE)
                          {
                              // Sync is valid
                              return _TRUE;
                          }
                      }
                  }
              
                  // Disable DC Restore
                  ScalerADCDCRestoreEn(_DISABLE);
              
                  // SOG power down
                  ScalerSetBit(P0_C6_ADC_POWER, ~_BIT5, 0x00);
              
                  // Disable De-composite circuit
                  ScalerSetBit(P0_47_SYNC_SELECT, ~_BIT5, 0x00);
