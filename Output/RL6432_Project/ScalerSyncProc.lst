 197          //--------------------------------------------------
 198          bit ScalerSyncProcPreDetect(BYTE ucInputPort)
 199          {
 200   1          // Vcck for power on
 201   1          ScalerSetBit(P0_C7_ADC_VOLT_SEL, ~_BIT2, 0x00);
 202   1      
 203   1          // Debounce counter reference 14.318MHz sync process clock, minimum pulse width is 171ns
 204   1          // n / 14.318 / 1000 = 171 => n = 2
 205   1          ScalerSyncProcSetDebounce(0x02);
 206   1      
 207   1          // Enable sync pulse detect
 208   1          ScalerSyncProcPulseDetectEnable(_ENABLE);
 209   1      
 210   1          // Clamp trigger edge and clamp setting for initial setting
 211   1          ScalerSetDataPortByte(P0_5C_SYNC_PROC_PORT_ADDR, _P0_5D_PT_04_CLAMP_CTRL0, 0x02);
 212   1          ScalerSetDataPortByte(P0_5C_SYNC_PROC_PORT_ADDR, _P0_5D_PT_05_CLAMP_CTRL1, 0x01);
 213   1      
 214   1          pData[0] = _TRUE;
 215   1      
 216   1          if(ucInputPort == _A0_INPUT_PORT)
 217   1          {
 218   2      #if(_A0_VGA_CONNECTOR_TYPE == _VGA_CONNECTOR_YPBPR)
                      pData[0] = _FALSE;
              #endif
 221   2          }
 222   1          else if(ucInputPort == _A1_INPUT_PORT)
 223   1          {
 224   2      #if(_A1_VGA_CONNECTOR_TYPE == _VGA_CONNECTOR_YPBPR)
                      pData[0] = _FALSE;
              #endif
 227   2          }
