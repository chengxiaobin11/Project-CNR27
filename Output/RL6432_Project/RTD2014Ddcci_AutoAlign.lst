                  SET_COLOR_TEMP_TYPE_USER_R(g_pucDdcciRxBuf[6]);
                  SET_COLOR_TEMP_TYPE_USER_G(g_pucDdcciRxBuf[7]);
                  SET_COLOR_TEMP_TYPE_USER_B(g_pucDdcciRxBuf[8]);
                  
                  UserAdjustContrast(GET_OSD_CONTRAST());
                    RTDDdccireply(_TRUE);
                }
                  
                
                /***********************************SAVE****************************/
