                  {
                      UserCommonAdjustUltraVivid(_FUNCTION_ON, UserCommonInterfaceGetColorFormat(), enumDBApply);
                  }
                  else
              #endif
                  {
                      if(GET_OSD_ULTRA_VIVID_STATUS() == _ULTRA_VIVID_OFF)
                      {
