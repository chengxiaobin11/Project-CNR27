                      data_count++;
                      }
                      if(wave_H_count<=1||wave_H_count>=25)
                      { 
                        data_count=0; f_guide=0;
                      }
                       wave_H_count=0;
                     }
                     }
                }
                
                if(data_count>=32)
                 {
                     data_count=0;
                     f_guide=0;
                     wave_H_count=0;
                     f_resaveok=1;
                 }
