C51 COMPILER V9.60.0.0   RTD2014USERINTERFACE                                              09/21/2026 15:33:35 PAGE 16  

 898          void UserAdjustBacklight(BYTE usBacklight)
 899          {
 900   1        usBacklight = GetOsdValue(_MENU_FUN_BACKLIGHT);
 901   1      
 902   1      /*
 903   1      #if(_OSD_POWER_SAVING_MODE)
 904   1          if(GET_OSD_POWER_SAVING())
 905   1          {
 906   1            usBacklight = 20;
 907   1          }
 908   1      #endif
 909   1      
 910   1      
 911   1          switch(GET_OSD_COLOR_EFFECT())
 912   1          {
 913   1            case _COLOREFFECT_MOVIE :
 914   1              usBacklight = _ECO_MOVIE_BACKLIGHT;
 915   1              break;
 916   1              
 917   1            case _COLOREFFECT_GAME:
 918   1              usBacklight = _ECO_GAME_BACKLIGHT;
 919   1              break;
 920   1              
 921   1            case _COLOREFFECT_PHOTO :
 922   1              usBacklight = _ECO_TEXT_BACKLIGHT;
 923   1              break;
 924   1              
 925   1            case _COLOREFFECT_STANDARD :
 926   1              usBacklight = usBacklight;
 927   1              break;
 928   1              
 929   1      #if(_EOC_RTS_FPS_SUPPORT == _ON)
 930   1            case _COLOREFFECT_FPS:
 931   1              usBacklight = _ECO_FPS_BACKLIGHT;
 932   1              break;
 933   1              
 934   1            case _COLOREFFECT_RTS :
 935   1              usBacklight = _ECO_RTS_BACKLIGHT;
 936   1              break;    
 937   1      
 938   1      #endif
 939   1        
 940   1            default:
 941   1              break;
 942   1          }
 943   1          
 944   1      #if(_HDR10_SUPPORT == _ON)
 945   1      
 946   1          if(GET_OSD_HDR_MODE() != _OFF)
 947   1          {
 948   1            if(GET_HDR10_EOTF_SETTING() == _HDR_TARGET_STATUS_SMPTE_ST_2084)
 949   1            {
 950   1              usBacklight = 100;
 951   1      
 952   1            }
 953   1          }
 954   1      #endif
 955   1      */
 956   1          
 957   1      #if(_MPRT_SUPPORT == _ON)
              
                if((GET_OSD_MPRT()!=_OFF)&&(SysModeGetModeState() ==_MODE_STATUS_ACTIVE)&&(GET_INPUT_TIMING_VFREQ()> _MPR
C51 COMPILER V9.60.0.0   RTD2014USERINTERFACE                                              09/21/2026 15:33:35 PAGE 17  

             -T_MIN_FRAME_RATE)&&(GET_OSD_FREE_SYNC_STATUS() == _OFF))
                {
                    usBacklight = tBacklight_Table_Value_MPRT(usBacklight);
                }
                else
              #endif    
 965   1      
 966   1      #if(_ADJ_BACKLIGHT_BY_TABLE==_ON)
                usBacklight = tBacklight_Table[usBacklight];
              #else
 969   1        usBacklight = tBacklight_Table_Value(usBacklight);
 970   1      #endif
 971   1      
 972   1      #if(_BACKLIGHT_PWM_INVERSE == _ON)
                usBacklight = 255 - usBacklight;
              #endif
 975   1      
 976   1        PCB_BACKLIGHT_PWM(usBacklight);
 977   1      
 978   1      }
