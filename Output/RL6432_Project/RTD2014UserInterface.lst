                tcc_time++;
                
                if(tcc_time>9)
                {
                  f_time1ms=1;
                  tcc_time=0;
                  ir_up_time++;
                }
                
                if(IR_STATUS==1)
                {
                  f_count_H=1;
                  wave_H_count++;
                  if(wave_H_count>60)
                  {
                    wave_H_count=60;
                    data_count=0;
                    f_guide=0;
                  }
                }
                else
                {
                  if(f_count_H==1)
                  {
                     f_count_H=0;
