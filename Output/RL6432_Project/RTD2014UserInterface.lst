              EnumEdidSelection UserInterfaceGetMultiHdmiEdidIndex(BYTE ucInputPort)
              {
              #if(_HDMI_EMBEDDED_EDID_SUPPORT == _ON)
              
                  EnumEdidSelection enumIndex = _EDID_INDEX_0;
                  BYTE ucHdmiVer = OsdFuncGetHdmiPortVersion(ucInputPort);
              
              #if(_HDMI_FREESYNC_SUPPORT == _ON)
                  if((GET_OSD_FREE_SYNC_STATUS() == _ON))
                  {
                      enumIndex += ((_HDMI_HDR10_SUPPORT == _ON) ? 0x06 : 0x03);
                  }
              #endif
              
              #if(_HDMI_HDR10_SUPPORT == _ON)
                  if((UserInterfaceHDRGetHDR10ModeStatus(ucInputPort) != _HDR10_MODE_OFF))
                  {
                      enumIndex += 0x03;
                  }
              #endif
              
                  switch(ucHdmiVer)
                  {
C51 COMPILER V8.12   RTD2014USERINTERFACE                                                  09/16/2026 20:28:57 PAGE 31  

                      case _HDMI_1P4:
                          break;
              
                      case _HDMI_2P0:
                          enumIndex += 0x01;
                          break;
              
                      case _HDMI_2P1:
                          enumIndex += 0x02;
                          break;
              
                      default:
                          break;
                  }
                  return enumIndex;
              
              #else
              
                  return UserAdjustGetHdmiExternalEdidIndex(ucInputPort);
              
              #endif
