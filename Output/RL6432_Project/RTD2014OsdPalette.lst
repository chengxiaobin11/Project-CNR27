 336   1      
 337   1          for(ucI = 0; ucI < 16; ucI++)
 338   1          {
 339   2              ScalerOsdSetColorPalette(ucAddr + ucI, *(pucColorPaletteArray + (ucI * 3)), *(pucColorPaletteArray
             - + (ucI * 3) + 1), *(pucColorPaletteArray + (ucI * 3) + 2));
 340   2          }
 341   1      }
