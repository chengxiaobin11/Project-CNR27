 397   1          ScalerMcuDdcciSendData(g_pucDdcciTxBuf);
 398   1          ScalerMcuDdcciReleaseScl();
 399   1        
 400   1        
 401   1      #else
                  g_pucDdcciTxBuf[0]=0x6F;
