 389          void RTDDdccireply(BYTE Flag)
 390          {
 391   1      #if  _Def_AutoAlign_Type==1
 392   1          g_pucDdcciTxBuf[0]=0x6E;
 393   1          g_pucDdcciTxBuf[1]=0x82;
 394   1          g_pucDdcciTxBuf[2]=0x02;
 395   1          g_pucDdcciTxBuf[3]=Flag;
