 391          void RTDDdccireply(BYTE Flag)
 392          {
 393   1      #if  _Def_AutoAlign_Type==1
 394   1          g_pucDdcciTxBuf[0]=0x6E;
 395   1          g_pucDdcciTxBuf[1]=0x82;
 396   1          g_pucDdcciTxBuf[2]=0x02;
 397   1          g_pucDdcciTxBuf[3]=Flag;
 398   1          g_pucDdcciTxBuf[4] = UserCommonDdcciCalCheckSum();
 399   1          ScalerMcuDdcciSendData(g_pucDdcciTxBuf);
 400   1          ScalerMcuDdcciReleaseScl();
 401   1        
 402   1        
 403   1      #else
                  g_pucDdcciTxBuf[0]=0x6F;
                  g_pucDdcciTxBuf[1]=0x82;
                  g_pucDdcciTxBuf[2]=0x02;
                  g_pucDdcciTxBuf[3]=Flag;
                  g_pucDdcciTxBuf[4] = UserCommonDdcciCalCheckSum();
                  ScalerMcuDdcciSendData(g_pucDdcciTxBuf);
              #endif
 411   1      }
