              //--------------------------------------------------
              // Description  : Control PMIC to Directed Voltage
              // Input Value  : bPowerDirection : _PD_POWER_SNK / _PD_POWER_SRC
              //                usVoltage : 300 ~ 2100 (Unit = 10mV)
              //                usCurrent : 0 ~ 500 (Unit = 10mA)
              // Output Value : Control result (Fail/Success)
              //--------------------------------------------------
              EnumTypeCPmicControlResult ExternalDeviceInterfaceTypeCPmicVoltageCurrentSetting(EnumTypeCPmicDirection en
             -umPowerDirection, WORD usVoltage, WORD usCurrent)
              {
              #if(_TYPE_C_EMB_PD3_1_EPR_SUPPORT == _ON)
                  if(usVoltage > 2800) // maximum 28V
C51 COMPILER V9.60.0.0   TYPEC_PMIC_MPS_MP4248                                             09/18/2026 20:40:24 PAGE 6   

                  {
                      usVoltage = 2800;
                  }
              #else
                  if(usVoltage > 2000) // maximum 20V
                  {
                      usVoltage = 2000;
                  }
              #endif
              
                  // -------------------------
                  // Operation Mode Setting
                  // -------------------------
                  g_pstPmicMp4248Data.ucOperation = _MP4248_MODE_ON;
              
                  if(ScalerTypeCPmicIICWrite(_TYPE_C_RX0_PMIC_SLAVE_ADDRESS, _MP4248_OPEARTION, _MP4248_SUBADDR_LENGTH, 
             -_MP4248_DATA_LENGTH_1, (BYTE *)(&g_pstPmicMp4248Data.ucOperation)) == _FAIL)
                  {
                      return _TYPE_C_PMIC_CONTROL_FAIL;
                  }
              
                  if(enumPowerDirection == _TYPE_C_PMIC_DIRECTION_SRC)
                  {
                      // ---------------------
                      // Voltage Setting
                      // ---------------------
              
                      if(usVoltage <= (300))
                      {
                          g_pstPmicMp4248Data.ucVoutCommand_h = HIBYTE(_MP4248_OUTPUT_VOL_3V);
                          g_pstPmicMp4248Data.ucVoutCommand_l = LOBYTE(_MP4248_OUTPUT_VOL_3V);
                      }
                      else if(usVoltage <= (500))
                      {
                          g_pstPmicMp4248Data.ucVoutCommand_h = HIBYTE(_MP4248_OUTPUT_VOL_5V);
                          g_pstPmicMp4248Data.ucVoutCommand_l = LOBYTE(_MP4248_OUTPUT_VOL_5V);
                      }
                      else if(usVoltage <= (900))
                      {
                          g_pstPmicMp4248Data.ucVoutCommand_h = HIBYTE(_MP4248_OUTPUT_VOL_9V);
                          g_pstPmicMp4248Data.ucVoutCommand_l = LOBYTE(_MP4248_OUTPUT_VOL_9V);
                      }
                      else if(usVoltage <= (1200))
                      {
                          g_pstPmicMp4248Data.ucVoutCommand_h = HIBYTE(_MP4248_OUTPUT_VOL_12V);
                          g_pstPmicMp4248Data.ucVoutCommand_l = LOBYTE(_MP4248_OUTPUT_VOL_12V);
                      }
                      else if(usVoltage <= (1500))
                      {
                          g_pstPmicMp4248Data.ucVoutCommand_h = HIBYTE(_MP4248_OUTPUT_VOL_15V);
                          g_pstPmicMp4248Data.ucVoutCommand_l = LOBYTE(_MP4248_OUTPUT_VOL_15V);
                      }
                      else if(usVoltage <= (2000))
                      {
                          g_pstPmicMp4248Data.ucVoutCommand_h = HIBYTE(_MP4248_OUTPUT_VOL_20V);
                          g_pstPmicMp4248Data.ucVoutCommand_l = LOBYTE(_MP4248_OUTPUT_VOL_20V);
                      }
              #if(_TYPE_C_EMB_PD3_1_EPR_SUPPORT == _ON)
                      else if(usVoltage <= (2800))
                      {
                          g_pstPmicMp4248Data.ucVoutCommand_h = HIBYTE(_MP4248_OUTPUT_VOL_28V);
                          g_pstPmicMp4248Data.ucVoutCommand_l = LOBYTE(_MP4248_OUTPUT_VOL_28V);
C51 COMPILER V9.60.0.0   TYPEC_PMIC_MPS_MP4248                                             09/18/2026 20:40:24 PAGE 7   

                      }
              #endif
              
                      if((ScalerTypeCPmicIICWrite(_TYPE_C_RX0_PMIC_SLAVE_ADDRESS, _MP4248_VOUT_COMMAND, _MP4248_SUBADDR_
             -LENGTH, _MP4248_DATA_LENGTH_1, (BYTE *)(&g_pstPmicMp4248Data.ucVoutCommand_l)) == _FAIL) ||
                         (ScalerTypeCPmicIICWrite(_TYPE_C_RX0_PMIC_SLAVE_ADDRESS, _MP4248_VOUT_COMMAND + 1, _MP4248_SUBA
             -DDR_LENGTH, _MP4248_DATA_LENGTH_1, (BYTE *)(&g_pstPmicMp4248Data.ucVoutCommand_h)) == _FAIL))
                      {
                          return _TYPE_C_PMIC_CONTROL_FAIL;
                      }
              
                      // ---------------------
                      // Current Setting
                      // ---------------------
              
                      if(usCurrent <= 100) // < 1A (unit: 10mA)
                      {
                          g_pstPmicMp4248Data.ucMfrCurrentLimit = ((g_pstPmicMp4248Data.ucMfrCurrentLimit & _BIT7) | _MP
             -4248_OUTPUT_CURRENT_LIMIT_1_0A);
                      }
                      else if(usCurrent <= 150)
                      {
                          g_pstPmicMp4248Data.ucMfrCurrentLimit = ((g_pstPmicMp4248Data.ucMfrCurrentLimit & _BIT7) | _MP
             -4248_OUTPUT_CURRENT_LIMIT_1_5A);
                      }
                      else if(usCurrent <= 200)
