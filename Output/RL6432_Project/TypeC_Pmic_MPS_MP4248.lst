             -LENGTH, _MP4248_DATA_LENGTH_1, (BYTE *)(&g_pstPmicMp4248Data.ucVoutCommand_h)) == _FAIL))
                  {
                      return _TYPE_C_PMIC_CONTROL_FAIL;
                  }
              
                  return _TYPE_C_PMIC_CONTROL_SUCCESS;
              }
              
