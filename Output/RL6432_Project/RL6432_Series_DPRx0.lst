 261   1      #endif
 262   1      
 263   1      #if(_DP_HDCP_2_2_SUPPORT == _ON)
 264   1          // Clear HDCP2.2 Handshaked Related IRQ
 265   1          ScalerSetBit(PB7_A4_AUX_RESERVE4, ~(_BIT7 | _BIT6 | _BIT5 | _BIT4 | _BIT3 | _BIT2 | _BIT1 | _BIT0), (_
             -BIT7 | _BIT6 | _BIT5 | _BIT4 | _BIT3));
 266   1          ScalerSetBit(PB7_A5_AUX_RESERVE5, ~(_BIT2 | _BIT1 | _BIT0), (_BIT1 | _BIT0));
 267   1      
 268   1          // Enable HDCP2.2 Handshaked Related IRQ
 269   1          ScalerSetBit(PB7_A3_AUX_RESERVE3, ~(_BIT7 | _BIT6 | _BIT5 | _BIT4 | _BIT3), (_BIT7 | _BIT6 | _BIT5 | _
             -BIT4 | _BIT3));
 270   1          ScalerSetBit(PB7_A5_AUX_RESERVE5, ~(_BIT5 | _BIT4 | _BIT2 | _BIT1 | _BIT0), (_BIT5 | _BIT4));
 271   1      
 272   1          // Source Read 692DFh(HPrime) INT
 273   1          ScalerSetByte(PB7_B7_AUX_IRQ_ADDR1_MSB, 0x06);
 274   1          ScalerSetByte(PB7_B8_AUX_IRQ_ADDR1_MSB1, 0x92);
 275   1          ScalerSetByte(PB7_B9_AUX_IRQ_ADDR1_LSB, 0xDF);
 276   1      #endif
 277   1      
 278   1      #if((_DP_TX_SUPPORT == _ON) && (_D0_DP_MST_PORT_SUPPORT == _ON))
                  // Clear HDCP AKSV IRQ
                  ScalerSetBit(PB7_A5_AUX_RESERVE5, ~(_BIT2 | _BIT1 | _BIT0), _BIT2);
              
                  // Enable HDCP AKSV IRQ
                  ScalerSetBit(PB7_A5_AUX_RESERVE5, ~(_BIT6 | _BIT2 | _BIT1 | _BIT0), _BIT6);
              #endif
 285   1      
 286   1          // Source Read 022xxh INT
 287   1          ScalerSetByte(PB7_B4_AUX_IRQ_ADDR0_MSB, 0x30);
 288   1          ScalerSetByte(PB7_B5_AUX_IRQ_ADDR0_MSB1, 0x22);
 289   1          ScalerSetByte(PB7_B6_AUX_IRQ_ADDR0_LSB, 0x00);
 290   1      
 291   1          // Clear Read DPCD 022xxh INT Flag
