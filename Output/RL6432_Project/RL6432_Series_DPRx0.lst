              //--------------------------------------------------
              void ScalerDpRx0LinkRateChangeRebuildPhy(void)
              {
                  SET_DP_RX0_AUX_MANUAL_MODE();
              
                  if((GET_DP_RX0_LINK_TRAINING_STATUS() == _DP_NORMAL_LINK_TRAINING_PASS) && (ScalerDpRx0LinkRateChange(
