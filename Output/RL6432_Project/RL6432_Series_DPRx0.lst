 129          //--------------------------------------------------
 130          // Description  : Initial Setting for DP Digital Aux, Analog Aux
 131          // Input Value  : None
 132          // Output Value : None
 133          //--------------------------------------------------
 134          void ScalerDpRx0AuxPowerOnInitial(void)
 135          {
 136   1          BYTE ucConnectorType = ScalerSyncDpRxGetConnectorType(_D0_INPUT_PORT);
 137   1      
 138   1          if(ucConnectorType == _DP_CONNECTOR_EMBEDDED)
 139   1          {
 140   2              // Reset Aux Phy
 141   2              ScalerSetBit(PB7_65_AUX_5, ~_BIT7, 0x00);
 142   2          }
 143   1      
 144   1          // Digital Aux Power On, DPCD REG Power On, MSG Power On.
 145   1          ScalerSetBit(PB7_C0_DPCD_CTRL, ~(_BIT7 | _BIT6 | _BIT5 | _BIT1 | _BIT0), 0x00);
 146   1      
 147   1          // Average 8 cycles as Start Postion, Aux Clk Select to 27MHz, no Swap
 148   1          ScalerSetByte(PB7_72_AUX_DIG_PHY2, 0xC0);
 149   1      
 150   1      #if(_DP_AUX_REPLY_CLK_SEL_FROM == _DP_AUX_REPLY_SEL_IOSC)
 151   1          // Aux Clk Select Manual Mode, Aux New Mode
 152   1          ScalerSetBit(PB7_73_AUX_DIG_PHY3, ~(_BIT7 | _BIT6), _BIT6);
 153   1      #else
                  // Aux Clk Select Source, Aux New Mode
                  ScalerSetBit(PB7_73_AUX_DIG_PHY3, ~(_BIT7 | _BIT6), (_BIT7 | _BIT6));
              #endif
 157   1      
 158   1          // HW Fake Link Training Disable.
 159   1          ScalerSetBit(PB7_C6_AUX_PHY_DIG2, ~_BIT4, 0x00);
 160   1      
 161   1          // Set Aux Precharge Number.
 162   1          ScalerSetBit(PB7_74_AUX_DIG_PHY4, ~(_BIT4 | _BIT3 | _BIT2 | _BIT1 | _BIT0), (_BIT3 | _BIT0));
 163   1      
 164   1          // Aux Auto Mode, Using Default Average Number.
 165   1          ScalerSetByte(PB7_75_AUX_DIG_PHY5, 0x0D);
 166   1      
 167   1          // Aux Reply Timeout Setting
 168   1          ScalerSetByte(PB7_A2_AUX_RESERVE2, _DP_AUX_REPLY_TIMEOUT_USER_SETTING);
 169   1      
 170   1          // Enble Aux Channel.
C51 COMPILER V9.60.0.0   RL6432_SERIES_DPRX0                                               09/24/2026 09:30:55 PAGE 4   

 171   1          ScalerSetBit(PB7_D0_AUX_MODE_SET, ~(_BIT3 | _BIT2 | _BIT0), _BIT0);
 172   1      
 173   1          // Fast IIC Clock.
 174   1          ScalerSetBit(PB7_D1_DP_IIC_SET, ~(_BIT7 | _BIT6 | _BIT5 | _BIT4), (_DP_AUX_IIC_SCL_CLK_SETTING << 4));
 175   1      
 176   1          // Set aux mac clk use xclk
 177   1          ScalerSetBit(PB7_DA_AUX_FIFO_RST, ~(_BIT4 | _BIT3 | _BIT1 | _BIT0), _BIT3);
 178   1      
 179   1          // Not Reply when Aux Error.
 180   1          ScalerSetBit(PB7_DB_AUX_STATUS, ~(_BIT5 | _BIT4), _BIT4);
 181   1          ScalerSetBit(PB7_76_AUX_DIG_PHY6, ~(_BIT7 | _BIT6), _BIT6);
 182   1      
 183   1          // Aux Ack Timer.
 184   1          ScalerSetBit(PB7_F0_AUX_TX_TIMER, ~(_BIT5 | _BIT2), (_BIT5 | _BIT2));
 185   1      
 186   1          // I2C timeout setting
 187   1          ScalerSetByte(PB7_F1_AUX_TX_TIMER_2, _DP_AUX_I2C_REPLY_TIMEOUT_SETTING);
 188   1      
 189   1          // Disable Reply IIC Defer Before Data Ready.
 190   1          ScalerSetBit(PB7_F4_MCUIIC, ~(_BIT6 | _BIT5), 0x00);
 191   1      
 192   1          // Enable Aux Error Handler.
 193   1          ScalerSetBit(PB7_78_AUX_DIG_PHY8, ~(_BIT6 | _BIT5 | _BIT4 | _BIT3 | _BIT2 | _BIT1 | _BIT0), (_BIT5 | _
             -BIT4));
 194   1      
 195   1          if(ucConnectorType != _DP_CONNECTOR_EMBEDDED)
 196   1          {
 197   2              // Toggle Aux Auto K
 198   2              ScalerSetBit(PB7_65_AUX_5, ~_BIT7, 0x00);
 199   2              ScalerSetBit(PB7_65_AUX_5, ~_BIT7, _BIT7);
 200   2          }
 201   1      
 202   1          // Aux Mode Set (Diff Mode or Single-ended mode) && Aux RX0 Resistance Setting
 203   1          ScalerDpRx0AuxSet();
 204   1      
 205   1          // Set Aux Talk Mode ADJR
 206   1          ScalerSetByte(PB7_67_DIG_TX_03, 0x88);
 207   1      
 208   1          ScalerSetBit(PB7_60_DIG_TX_04, ~(_BIT1 | _BIT0), _BIT0);
 209   1      
 210   1          // Aux comm current select max
 211   1          ScalerSetBit(PB7_64_AUX_4, ~(_BIT7 | _BIT6), (_BIT7 | _BIT6));
 212   1      
 213   1          // Set Aux D_2 = ~D_1 for Aux Single Ended Mode
 214   1          ScalerSetBit(PB7_79_AUX_DIG_PHY9, ~_BIT7, _BIT7);
 215   1      
 216   1          // Clear the Clock Divider for AUX MAC and PHY
 217   1          ScalerSetBit(PB7_73_AUX_DIG_PHY3, ~(_BIT3 | _BIT2 | _BIT1 | _BIT0), 0x00);
 218   1          ScalerSetBit(PB7_B0_AUX_PAYLOAD_CLEAR, ~(_BIT3 | _BIT2 | _BIT1 | _BIT0), 0x00);
 219   1      
 220   1          // Aux ps clk from IOSC
 221   1          ScalerSetBit(P0_0B_POWER_CTRL, ~(_BIT5 | _BIT4), 0x00);
 222   1      
 223   1          // Set the Clock Divider = 1 for AUX MAC and PHY
 224   1          ScalerSetBit(PB7_73_AUX_DIG_PHY3, ~(_BIT3 | _BIT2 | _BIT1 | _BIT0), _BIT0);
 225   1          ScalerSetBit(PB7_B0_AUX_PAYLOAD_CLEAR, ~(_BIT3 | _BIT2 | _BIT1 | _BIT0), _BIT0);
 226   1      }
