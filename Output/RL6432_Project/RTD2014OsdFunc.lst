                  UserAdjustBacklight(100);
                  
              #if(_CONTRAST_SUPPORT == _ON)
                  UserCommonHDRContrast(0);
              #endif
                }
                else if((GET_OSD_HDR_MODE() == _HDR10_MODE_AUTO)&&(pucHDRInfoData[0] == 1)&&(pucHDRInfoData[1] == 0x1A)&&
