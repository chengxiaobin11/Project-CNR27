 179          // Description  : Reset 8b10b Error Count value
 180          // Input Value  : None
 181          // Output Value : None
 182          //--------------------------------------------------
 183          void ScalerDpRx0DecodeErrorCountReset(void)
 184          {
 185   1          // Reset 8b10b Error Count Value
 186   1          ScalerSetBit(PB_08_BIST_PATTERN_SEL, ~(_BIT2 | _BIT1 | _BIT0), 0x00);
 187   1      
 188   1          // Start Record 8b10b Error Count Value
 189   1          ScalerSetBit(PB_08_BIST_PATTERN_SEL, ~(_BIT2 | _BIT1 | _BIT0), _BIT1);
 190   1      }
 191          
 192          //--------------------------------------------------
 193          // Description  : Get 8b10b Error Count value
 194          // Input Value  : Lane
 195          // Output Value : Error Count
 196          //--------------------------------------------------
 197          WORD ScalerDpRx0GetDecodeErrorCount(BYTE ucDpRx0LaneNumber)
 198          {
 199   1          // Select Lane
 200   1          ScalerSetBit(PB_08_BIST_PATTERN_SEL, ~(_BIT4 | _BIT3), (ucDpRx0LaneNumber << 3));
 201   1      
 202   1          return ((((WORD)ScalerGetByte(PB_0B_BIST_PATTERN3)) << 8) | ScalerGetByte(PB_0C_BIST_PATTERN4));
 203   1      }
