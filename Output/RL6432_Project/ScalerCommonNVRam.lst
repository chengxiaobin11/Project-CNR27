7053          //--------------------------------------------------
7054          // Description  : Erase page
7055          // Input Value  : ucBank: bank index
7056          //                ucPage: page index (0 ~ 15)
7057          // Output Value : _TRUE for erase success and _FALSE for erase fail
7058          //--------------------------------------------------
7059          bit ScalerFlashErasePage(BYTE ucBank, BYTE ucPage)
7060          {
7061   1          // The access bank is smaller than than the start bank
7062   1          if(ucBank < MCU_FFFD_XDATA_BANK_START)
7063   1          {
7064   2              return _FALSE;
7065   2          }
7066   1      
7067   1          if(g_ucFlashType == _FLASH_UNDETECT)
7068   1          {
7069   2              ScalerFlashDetectFlashType();
7070   2          }
7071   1      
7072   1          if(g_ucFlashType >= (sizeof(tFlashInformation) / sizeof(tFlashInformation[0])))
7073   1          {
7074   2              return _FALSE;
7075   2          }
7076   1      
7077   1          ScalerFlashWREN(ucBank, ucPage);
7078   1      
7079   1          // Sector Erase
7080   1          MCU_SET_BYTE_WITH_CKCON(MCU_FF60_COMMON_INST_EN, 0xB8, _CKCON_MCU_SLOW_CYCLE);
7081   1          MCU_FF61_COMMON_OP_CODE = tFlashInformation[g_ucFlashType].ucPageEraseOpCode;
7082   1          // Set WR address
7083   1          MCU_FF64_FLASH_PROG_ISP0 = ucBank;
7084   1          MCU_FF65_FLASH_PROG_ISP1 = (BYTE)((ucPage << 4) & 0xF0);
7085   1          MCU_FF66_FLASH_PROG_ISP2 = 0x00;
7086   1          // Start Bit0
7087   1          MCU_SET_BYTE_WITH_CKCON(MCU_FF60_COMMON_INST_EN, 0xB9, _CKCON_MCU_SLOW_CYCLE);
7088   1      
7089   1          // No need to polling, 8051 will halt when common instruction executes
7090   1      
7091   1          MCU_FF61_COMMON_OP_CODE = 0xFF;
7092   1      
7093   1          ScalerFlashWRDis();
7094   1      
7095   1          return _TRUE;
7096   1      }
