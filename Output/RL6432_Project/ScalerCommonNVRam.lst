7105          BYTE ScalerFlashReadSROnOTPMode(BYTE ucEnterOTPOpCode, BYTE ucExitOTPOpCode, BYTE ucOpCode)
7106          {
7107   1          BYTE ucRDSR = 0;
7108   1      
7109   1          // Enter OTP Mode
7110   1          ScalerFlashSetWREN(ucEnterOTPOpCode);
7111   1      
7112   1          // Read Status Register
7113   1          ucRDSR = ScalerFlashReadSR(ucOpCode);
7114   1      
7115   1          // Exit OTP Mode
7116   1          ScalerFlashSetWREN(ucExitOTPOpCode);
7117   1      
7118   1          return ucRDSR;
7119   1      }
