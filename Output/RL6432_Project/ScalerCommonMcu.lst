 265   2      
 266   2              if(usTimeOutCnt == 0)
 267   2              {
 268   3                  break;
 269   3              }
 270   2          }
 271   1      
 272   1          // Disable mcu write
 273   1          MCU_FF2A_IIC_IRQ_CONTROL2 &= ~_BIT5;
 274   1      }
