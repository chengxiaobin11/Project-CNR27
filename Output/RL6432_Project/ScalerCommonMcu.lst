 202          //--------------------------------------------------
 203          // Description  : Cache Control
 204          // Input Value  : bControl
 205          // Output Value : None
 206          //--------------------------------------------------
 207          void ScalerMcuCacheControl(bit bControl)
 208          {
 209   1          if(bControl == _ENABLE)
 210   1          {
 211   2              // Enable Cache
 212   2              MCU_FDA0_CACHE_FUNCTION |= _BIT0;
 213   2          }
 214   1          else
 215   1          {
 216   2              // Disable Cache
 217   2              MCU_FDA0_CACHE_FUNCTION &= ~_BIT0;
 218   2          }
 219   1      }
