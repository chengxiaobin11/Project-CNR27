                      IP = 0x81;
              
                      CLR_DP_RX0_PS_AUX_TOGGLE();
              
                      CLR_DP_RX1_PS_AUX_TOGGLE();
              
                      // Enable Aux INT
                      ScalerSetBit(PB7_7A_AUX_DIG_PHYA, ~(_BIT4 | _BIT0), (_BIT4));
              
                      // Enable Aux INT
                      ScalerSetBit(PBA_7A_AUX_DIG_PHYA, ~(_BIT4 | _BIT0), (_BIT4));
              
                      DebugMessageDigital("7. Low Power Event", 0);
