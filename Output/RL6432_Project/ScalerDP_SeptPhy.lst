                  CLR_DP_GEN_DOWN_REQUEST_MSG();
                  CLR_DP_RX_ILLEGAL_DOWN_REQUEST_MSG();
                  CLR_DP_RX_SELF_GEN_DOWN_REQUEST_MSG();
              
                  // Clear Down Reply MSG Proc Flags
