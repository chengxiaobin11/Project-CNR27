             -0x00))
                  {
                      // Aux PHY Power Saving Mode
                      ScalerSetBit(PB7_62_AUX_2, ~_BIT1, _BIT1);
              
                      // Aux Bias Current From POR
                      ScalerSetBit(PB7_63_AUX_3, ~_BIT7, _BIT7);
              
                      // Aux PHY Power Saving Mode
                      ScalerSetBit(PBA_62_AUX_2, ~_BIT1, _BIT1);
              
