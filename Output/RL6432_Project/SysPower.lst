 362   4                              SysPowerSwitch(_POWER_ACTION_FAKE_OFF_TO_NORMAL);
 363   4                          }
 364   3                          else if(GET_POWER_SWITCH_TO_FAKE_SAVING() == _TRUE)
 365   3                          {
 366   4                              CLR_POWER_SWITCH_TO_FAKE_SAVING();
 367   4                              SysPowerSwitch(_POWER_ACTION_FAKE_PS_TO_NORMAL);
 368   4      
 369   4      #if(_AIO_MODERN_STANDBY_SUPPORT == _ON)
                                      if(UserInterfaceGetAIOModernStandbyMode() == _AIO_MODERN_STANDBY_MODE_ENABLE)
                                      {
                                          SET_AIO_MODERN_STANDBY_MODE();
                                          ScalerTimerReactiveTimerEvent(SEC(0.5), _SYSTEM_TIMER_EVENT_AIO_MODERN_STANDBY
             -_MODE_TIMEOUT);
