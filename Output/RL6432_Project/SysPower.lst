 300          //--------------------------------------------------
 301          // Description  : Power Handler Process
 302          // Input Value  : None
 303          // Output Value : None
 304          //--------------------------------------------------
 305          void SysPowerHandler(void)
 306          {
 307   1          // The process will deal with all kinds of power changing by power action flag.
 308   1          switch(GET_TARGET_POWER_STATUS())
 309   1          {
 310   2              case _POWER_STATUS_NORMAL:
 311   2          #if(_PCB_TYPE == _RL6432__156PIN__HKMRT2557E03__1T1H1DP_EDP)
                  #if(_DEF_255XE03_PCB_TYPE==1)
                    MCU_FE23_PORT83_PIN_REG=1;MCU_FE04_PORT44_PIN_REG=1;
                  #endif
                  #endif
 316   2          #if(_PCB_TYPE ==_RL6432__156PIN__HKMRT255XE08__1T1H1DP_LVDS)
                    MCU_FE23_PORT83_PIN_REG=1;MCU_FE04_PORT44_PIN_REG=1;
                  #endif
 319   2      
 320   2                  switch(GET_POWER_STATUS())
 321   2                  {
 322   3                      case _POWER_STATUS_OFF:
 323   3      
 324   3                          if(SysPowerCheckNormal() == _TRUE)
 325   3                          {
 326   4                              SysPowerSwitch(_POWER_ACTION_OFF_TO_NORMAL);
 327   4                          }
 328   3                          else
 329   3                          {
 330   4                              SysPowerSwitch(_POWER_ACTION_OFF_TO_FAKE_OFF);
 331   4                          }
 332   3                          break;
 333   3      
 334   3                      case _POWER_STATUS_SAVING:
