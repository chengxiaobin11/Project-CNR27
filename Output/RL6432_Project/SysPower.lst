 477          //--------------------------------------------------
 478          // Description  : Deal With Power Manage According To Input Pamater
 479          // Input Value  : ucSwitch    --> Power action description.
 480          // Output Value : None
 481          //--------------------------------------------------
 482          void SysPowerSwitch(EnumPowerAction enumSwitch)
 483          {
 484   1          switch(enumSwitch)
 485   1          {
 486   2              case _POWER_ACTION_NORMAL_TO_PS:
 487   2      
 488   2                  // User Power Process
 489   2                  UserInterfacePowerSwitch(enumSwitch);
