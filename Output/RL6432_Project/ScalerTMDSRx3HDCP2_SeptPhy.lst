              void ScalerTMDSRx3Hdcp2AesOnlineCtrl(BYTE *pucInputArray, BYTE *pucCipherArray)
              {
                  // Set AES Cipher Key
                  SET_HDCP_2_2_RX3_ONLINE_AES(pucCipherArray, pucInputArray);
              
                  // Riv from FW
                  ScalerSetBit(P2E_29_HDCP_I2C_CTRL_3, ~_BIT7, _BIT7);
              
                  // Set HW to Authenticated State
                  ScalerSetByte(P2E_28_HDCP_I2C_CTRL_2, 0x10);
                  ScalerSetBit(P2E_29_HDCP_I2C_CTRL_3, ~_BIT6, _BIT6);
              }
