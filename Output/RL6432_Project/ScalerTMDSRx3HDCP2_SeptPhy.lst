              //--------------------------------------------------
              // Description  : Capture Kpub/Km
              // Input Value  : None
              // Output Value : _TRUE or _FALSE
              //--------------------------------------------------
              bit ScalerTMDSRx3Hdcp2CaptureKpubKm(void)
              {
              #if(_HDCP_2_2_TX_RSA3072_MODE == _ON)
                  WORD usCount = 0;
              #endif
                  BYTE pucKpubKm[128];
                  memset(pucKpubKm, 0, sizeof(pucKpubKm));
              
                  // Save Transmitter Ekpub[km] to FW
                  ScalerSetByte(P2E_21_HDCP_MSGWAP, 0x01);
              
              #if(_HDCP_2_2_TX_RSA3072_MODE == _ON)
                  for(usCount = 0; usCount < 384; ++usCount)
                  {
                      DebugMessageHDCP2("[D3]DCP LLC Signature", g_stRxHdcp2DownLoadKeyType.pucHdcp2KpubKm[usCount]);
                  }
              #else
                  for(pData[0] = 0; pData[0] < 128; ++pData[0])
                  {
                      pucKpubKm[pData[0]] = g_stRxHdcp2DownLoadKeyType.pucHdcp2KpubKm[pData[0]];
              
                      DebugMessageHDCP2("[D3]Ekpub(km)", pucKpubKm[pData[0]]);
                  }
              #endif
              
                  // Decrypt Ekpub[km]
                  return (ScalerHdcp2RxRsaCalculate(pucKpubKm) == _TRUE);
              }
              
              //--------------------------------------------------
              // Description  : Calculate Km/Kh
              // Input Value  : None
              // Output Value : None
              //--------------------------------------------------
              void ScalerTMDSRx3Hdcp2CalculateKmKh(void)
              {
                  BYTE pucSHA256[32];
              
                  BYTE pucM[16];
                  memset(pucM, 0, sizeof(pucM));
                  memset(pucSHA256, 0, sizeof(pucSHA256));
              
                  // Load H prime to Read SRAM, AKE Send H PRIME Message ID = 0x07
                  ScalerTMDSRx3Hdcp2SetRdMsgIDCode(_HDCP_2_2_AKE_SEND_H_PRIME);
              
                  memcpy(pucSHA256, (volatile BYTE xdata *)P63_35_HDCP_SHA_0, 32);
              
                  for(pData[0] = 0; pData[0] < 32; pData[0]++)
                  {
                      DebugMessageHDCP2("[D3]H_prime", pucSHA256[pData[0]]);
                  }
C51 COMPILER V9.60.0.0   SCALERTMDSRX3HDCP2_SEPTPHY                                        09/24/2026 09:30:27 PAGE 18  

              
                  // Load Km to Read SRAM
                  ScalerTMDSRx3Hdcp2SetRdMsgValue(0x01, pucSHA256, 32);
              
                  // Set Message Size = 0x21
                  ScalerSetBit(P2E_3B_I2C_DUMMY_0, ~_BIT0, _BIT0);
                  ScalerSetDataPortByte(P72_C3_HDCP_AP, _P72_C4_PT_70_PORT_PAGE72_HDCP2_STATUS1, 0x21);
                  ScalerSetDataPortByte(P72_C3_HDCP_AP, _P72_C4_PT_71_PORT_PAGE72_HDCP2_STATUS2, 0x00);
                  ScalerSetBit(P2E_3B_I2C_DUMMY_0, ~_BIT0, 0x00);
              
                  // Enable HDCP2 Source Read Done IRQ
                  ScalerSetBit(P2E_36_HDCP_I2C_CTRL_8, ~(_BIT4 | _BIT3 | _BIT2 | _BIT1 | _BIT0), _BIT1);
                  ScalerSetBit(P2E_35_HDCP_I2C_CTRL_7, ~_BIT1, _BIT1);
              
                  // Start Pairing AES Calculate
                  for(pData[0] = 0; pData[0] < 16; ++pData[0])
                  {
                      if(pData[0] < 8)
                      {
                          pucM[pData[0]] = g_pucTmdsRx3Hdcp2Rtx[pData[0]];
                      }
                      else
                      {
                          pucM[pData[0]] = g_pucTmdsRx3Hdcp2Rrx[pData[0] - 8];
                      }
                  }
              
                  // AES Cipher Calculate Ekh[km]
                  ScalerHdcp2RxAesOfflineCtrl(pucM, g_pucHdcp2Kh);
              
                  // Calculate Ekh[km] = kh AES m XOR Km
                  for(pData[0] = 0; pData[0] < 16; ++pData[0])
                  {
                      g_pucHdcp2Kh[pData[0]] = ScalerGetByte(P63_81_HDCP_AES_OUT_15 + pData[0]) ^ g_pucTmdsRx3Hdcp2Km[pD
             -ata[0]];
              
                      DebugMessageHDCP2("[D3]Ekh(km)", g_pucHdcp2Kh[pData[0]]);
                  }
              }
              #endif
