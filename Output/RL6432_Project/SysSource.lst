 293          //--------------------------------------------------
 294          // Description  : Source Handler
 295          // Input Value  : None
 296          // Output Value : None
 297          //--------------------------------------------------
 298          void SysSourceHandler(void)
 299          {
 300   1          SysSourceCableDetection();
 301   1      
 302   1      #if(_URGENT_EVENT_CHECK_MODE == _ON)
 303   1          if((ScalerSyncCheckUrgentEvent() == _TRUE) &&
 304   1             (GET_POWER_STATUS() == _POWER_STATUS_NORMAL))
 305   1          {
 306   2      #if(_DP_LINK_INTERVAL_CHECK_SUPPORT == _ON)
                      if(ScalerSyncGetUrgentDpRxLinkLossInfo() == _FALSE)
                      {
                          return;
                      }
              #endif
 312   2          }
 313   1      #endif
 314   1      
 315   1          if((GET_MODE_STATE() != _MODE_STATUS_POWER_OFF) &&
 316   1             (GET_MODE_STATE() != _MODE_STATUS_INITIAL) &&
 317   1             (UserInterfaceGetForcePSStatus() == _FALSE) &&
 318   1             (UserInterfaceSourceBypassDetection() == _SOURCE_DETECTION_NORMAL))
 319   1          {
 320   2              if(GET_SOURCE_JUDGE(g_ucSearchIndex) == _FALSE)
 321   2              {
 322   3                  if(GET_SOURCE_DETECTING() == _FALSE)
 323   3                  {
 324   4                      SysSourceSwitchPort();
 325   4                  }
 326   3      
 327   3                  if(GET_SOURCE_SEARCH_PORT_INITIAL() == _TRUE)
 328   3                  {
 329   4                      SysSourceScanPortInitial(g_ucSearchIndex);
 330   4      
 331   4                      CLR_SOURCE_SEARCH_PORT_INITIAL();
 332   4                  }
 333   3      
 334   3                  if(GET_SOURCE_SEARCH_TIME_INITIAL() == _TRUE)
 335   3                  {
 336   4                      SysSourceSearchTimeInitial(g_ucSearchIndex);
 337   4      
 338   4                      CLR_SOURCE_SEARCH_TIME_INITIAL();
 339   4                  }
 340   3      
 341   3                  // Port Detection
 342   3                  SysSourceDetectPort(g_ucSearchIndex);
 343   3      
 344   3                  // Decide if this port is about to be chosen
 345   3                  SysSourceJudge();
 346   3              }
 347   2      
 348   2      #if(_SOURCE_BACKGROUND_DETECT_SUPPORT == _ON)
                      else if(SysSourceBgJudgeDoDetect() == _TRUE)
                      {
                          if(GET_SOURCE_DETECTING() == _FALSE)
C51 COMPILER V9.60.0.0   SYSSOURCE                                                         09/18/2026 20:37:41 PAGE 7   

                          {
                              SysSourceBgSwitchPort();
                          }
              
                          if(GET_SOURCE_SEARCH_PORT_INITIAL() == _TRUE)
                          {
                              SysSourceScanPortInitial(g_ucBgDetectIndex);
              
                              CLR_SOURCE_SEARCH_PORT_INITIAL();
                          }
              
                          if(GET_SOURCE_SEARCH_TIME_INITIAL() == _TRUE)
                          {
                              SysSourceSearchTimeInitial(g_ucBgDetectIndex);
              
                              CLR_SOURCE_SEARCH_TIME_INITIAL();
                          }
                          // Change color array index to bg detect to prevent overwritting of sys color
                          ScalerColorSwitchColorInfoArray(_COLOR_INFO_BG_DETECT);
              
                          // Port Detect
                          SysSourceDetectPort(g_ucBgDetectIndex);
              
                          // Change Back after finishing bg detect
                          ScalerColorSwitchColorInfoArray(_COLOR_INFO_SYSTEM);
              
                          // Decide if this port is about to be chosen
                          SysSourceBgJudge();
                      }
                      else if(SysSourceBgJudgeDoStableCheck() == _TRUE)
                      {
                          if(SysSourceBgStableCheck() == _FALSE)
                          {
                              DebugMessageSystem("Background Source Unstable!!", GET_SOURCE_TYPE(g_ucBgDetectIndex));
              
                              SysSourceBgInfoReset();
                          }
                      }
              #endif
 391   2          }
 392   1      
 393   1          CLR_MODE_STATE_CHANGE_SOURCE();
 394   1      }
