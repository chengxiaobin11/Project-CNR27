              //--------------------------------------------------
              // Description  : Stable Detect Check BCH
              // Input Value  : enumBchChkState
              // Output Value : False: bch error happen
              //                True: bch error not happen
              //--------------------------------------------------
              bit ScalerTMDSRx3StableDetectHdcp14BchErrorCheck(EnumHdmiHdcp14BchChkState enumBchChkState)
              {
                  switch(enumBchChkState)
                  {
                      case _HDMI_HDCP14_BCH_1ST_ACT_ENC_CHK_FAIL:
              
                          // BCH Error already happened in FirstActiveProc
                          // Lock Ri' to let next Ri check fail -> Force Source to Re-Auth
C51 COMPILER V9.60.0.0   RL6432_SERIES_TMDSRX3                                             09/18/2026 20:39:33 PAGE 82  

                          ScalerSetDataPortBit(P72_C3_HDCP_AP, _P72_C4_PT_C1_PORT_PAGE72_HDCP_SIR, ~_BIT4, _BIT4);
              
                          // Clear TimerEvenet
                          ScalerTimerCancelTimerEvent(_SCALER_TIMER_EVENT_RX3_TMDS_HDCP14_BCH_ERR_CHK);
              
                          SET_TMDS_RX3_HDCP14_BCH_CHK_STATE(_HDMI_HDCP14_BCH_NONE);
              
                          return _FALSE;
              
                      case _HDMI_HDCP14_BCH_AUTH_START:
              
                          ScalerTimerActiveTimerEvent(1000, _SCALER_TIMER_EVENT_RX3_TMDS_HDCP14_BCH_ERR_CHK);
              
                          SET_TMDS_RX3_HDCP14_BCH_CHK_STATE(_HDMI_HDCP14_BCH_CHK_WINDOW_START);
              
                          return _TRUE;
              
                      case _HDMI_HDCP14_BCH_CHK_WINDOW_END:
              
                          SET_TMDS_RX3_HDCP14_BCH_CHK_STATE(_HDMI_HDCP14_BCH_NONE);
              
                          // Clr BCH Error Flag
                          ScalerSetDataPortBit(P72_C9_HDMI_AP, _P72_CA_PT_02_PORT_PAGE72_HDMI_BCHCR, ~_BIT2, 0x00);
              
                          ScalerTimerDelayXms(30);
              
                          // bch check
                          if(ScalerGetDataPortBit(P72_C9_HDMI_AP, _P72_CA_PT_02_PORT_PAGE72_HDMI_BCHCR, _BIT2) == _BIT2)
                          {
              #if(_SOURCE_BACKGROUND_DETECT_SUPPORT == _ON)
                              if(GET_STORE_ACTIVED_PORT() == _D3_INPUT_PORT)
              #endif
                              {
                                  // Set Display M1 output force to background color and free run mode
                                  ScalerSetBit(P0_28_VIDEO_DISPLAY_CONTROL_REG, ~(_BIT5 | _BIT3), _BIT5);
                              }
              
                              // Disable RGB/clock Output to avoid garbage
                              ScalerSetBit(P72_A6_TMDS_OUTCTL, ~(_BIT6 | _BIT5 | _BIT4 | _BIT3), 0x00);
              
                              // Lock Ri' to let next Ri check fail -> Force Source to Re-Auth
                              ScalerSetDataPortBit(P72_C3_HDCP_AP, _P72_C4_PT_C1_PORT_PAGE72_HDCP_SIR, ~_BIT4, _BIT4);
              
                              return _FALSE;
                          }
                          else
                          {
                              return _TRUE;
                          }
              
                      default:
                          return _TRUE;
                  }
              }
              
              //--------------------------------------------------
              // Description  : HDCP1.4 BCH Error Check Event
              // Input Value  : None
              // Output Value : None
              //--------------------------------------------------
              void ScalerTMDSRx3Hdcp14BchErrorCheckEvent(void)
              {
C51 COMPILER V9.60.0.0   RL6432_SERIES_TMDSRX3                                             09/18/2026 20:39:33 PAGE 83  

                  SET_TMDS_RX3_HDCP14_BCH_CHK_STATE(_HDMI_HDCP14_BCH_CHK_WINDOW_END);
              }
              
              //--------------------------------------------------
              // Description  : Check BCH Error in FirstActiveProc
              // Input Value  : None
              // Output Value : None
              //--------------------------------------------------
              void ScalerTMDSRx3FirstActiveProcHdcp14BchErrorCheck(void)
              {
                  BYTE pucHDCP14FrmCnt[2] = {0};
                  BYTE ucCheckTime = 10;    // ms, must > 0
                  WORD usRemainTime = 0x00;  // ms
              
                  // Wait more time for HDCP1.4 Aksv IRQ
                  usRemainTime = 80;
                  while(GET_TMDS_RX3_HDCP14_BCH_CHK_STATE() == _HDMI_HDCP14_BCH_NONE)
                  {
                      ScalerTimerDelayXms(ucCheckTime);
                      usRemainTime -= ucCheckTime;
                      if((GET_TMDS_RX3_HDCP14_BCH_CHK_STATE() == _HDMI_HDCP14_BCH_AUTH_START) || (usRemainTime < ucCheck
             -Time))
                      {
                          break;
                      }
                  }
              
                  // Check BCH Error for HDCP1.4 in _SCALER_TIMER_EVENT_RX3_TMDS_HDCP14_BCH_ERR_CHK window
                  switch(GET_TMDS_RX3_HDCP14_BCH_CHK_STATE())
                  {
                      case _HDMI_HDCP14_BCH_AUTH_START:
                      case _HDMI_HDCP14_BCH_CHK_WINDOW_START:
              
                          if(GET_TMDS_RX3_HDCP14_BCH_CHK_STATE() == _HDMI_HDCP14_BCH_CHK_WINDOW_START)
                          {
                              usRemainTime = ScalerTimerGetEventRemainTime(_SCALER_TIMER_EVENT_RX3_TMDS_HDCP14_BCH_ERR_C
             -HK);
                          }
                          else
                          {
                              usRemainTime = 1000;
                          }
              
                          usRemainTime = (usRemainTime + (ucCheckTime - 1)) / ucCheckTime * ucCheckTime;  // Ceil(usRema
             -inTime, ucCheckTime)
                          usRemainTime = MAXOF(usRemainTime, ucCheckTime);
              
                          // Polling HDCP1.4 Frame Counter to wait Encrypt Data
                          ScalerGetDataPortByte(P72_C3_HDCP_AP, _P72_C4_PT_C0_PORT_PAGE72_HDCP_FCR, 1, &pucHDCP14FrmCnt[
             -0], _NON_AUTOINC);
                          while(usRemainTime >= ucCheckTime)
                          {
                              ScalerTimerDelayXms(ucCheckTime);
                              ScalerGetDataPortByte(P72_C3_HDCP_AP, _P72_C4_PT_C0_PORT_PAGE72_HDCP_FCR, 1, &pucHDCP14Frm
             -Cnt[1], _NON_AUTOINC);
              
                              if(pucHDCP14FrmCnt[0] != pucHDCP14FrmCnt[1])
                              {
                                  break;
                              }
              
                              usRemainTime -= ucCheckTime;
C51 COMPILER V9.60.0.0   RL6432_SERIES_TMDSRX3                                             09/18/2026 20:39:33 PAGE 84  

                          }
              
                          // Clr BCH Error Flag
                          ScalerSetDataPortBit(P72_C9_HDMI_AP, _P72_CA_PT_02_PORT_PAGE72_HDMI_BCHCR, ~_BIT2, 0x00);
              
                          ScalerTimerDelayXms(45);
              
                          // bch check
                          if(ScalerGetDataPortBit(P72_C9_HDMI_AP, _P72_CA_PT_02_PORT_PAGE72_HDMI_BCHCR, _BIT2) == _BIT2)
                          {
              #if(_SOURCE_BACKGROUND_DETECT_SUPPORT == _ON)
                              if(GET_STORE_ACTIVED_PORT() == _D3_INPUT_PORT)
              #endif
                              {
                                  // Set Display M1 output force to background color and free run mode
                                  ScalerSetBit(P0_28_VIDEO_DISPLAY_CONTROL_REG, ~(_BIT5 | _BIT3), _BIT5);
                              }
              
                              // Disable RGB/clock Output to avoid garbage
                              ScalerSetBit(P72_A6_TMDS_OUTCTL, ~(_BIT6 | _BIT5 | _BIT4 | _BIT3), 0x00);
              
                              SET_TMDS_RX3_HDCP14_BCH_CHK_STATE(_HDMI_HDCP14_BCH_1ST_ACT_ENC_CHK_FAIL);
                              DebugMessageRx3("FirstActive HDCP14 BCH Error Detected", 0x00);
                          }
                          else
                          {
                              SET_TMDS_RX3_HDCP14_BCH_CHK_STATE(_HDMI_HDCP14_BCH_1ST_ACT_ENC_CHK_PASS);
                          }
              
                          break;
              
                      default:
                          break;
                  }
              }
              
              //--------------------------------------------------
              // Description  : Get FirstActiveProc BCH Error Check Result
              // Input Value  : None
              // Output Value : False : BCH Error Happened
              //              : True : BCH Error Not Happened
              //--------------------------------------------------
              bit ScalerTMDSRx3GetFirstActiveHdcp14BchErrorCheck(void)
              {
                  if(GET_TMDS_RX3_HDCP14_BCH_CHK_STATE() == _HDMI_HDCP14_BCH_1ST_ACT_ENC_CHK_FAIL)
                  {
                      return _FALSE;
                  }
                  else
                  {
                      return _TRUE;
                  }
              }
              
