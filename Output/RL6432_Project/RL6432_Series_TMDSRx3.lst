3559   2      
3560   2              // Enable Video/Audio Output
3561   2              ScalerSetDataPortBit(P72_C9_HDMI_AP, _P72_CA_PT_30_PORT_PAGE72_HDMI_AVMCR, ~(_BIT6 | _BIT5 | _BIT3
             -), (_BIT6 | _BIT5 | _BIT3));
3562   2      
3563   2              // Enable RGB Output
3564   2              ScalerSetBit(P72_A6_TMDS_OUTCTL, ~(_BIT6 | _BIT5 | _BIT4), (_BIT6 | _BIT5 | _BIT4));
3565   2      
3566   2              // Enable AVMute Watch Dog
3567   2              ScalerSetDataPortBit(P72_C9_HDMI_AP, _P72_CA_PT_31_PORT_PAGE72_HDMI_WDCR0, ~_BIT7, _BIT7);
3568   2          }
3569   1      }
