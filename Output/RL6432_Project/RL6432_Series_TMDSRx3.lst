3397   3                  {
3398   4                      SET_HDMI_RX3_GCP_RECEIVED();
3399   4      
3400   4                      // Polling more time to wait AVI IF when GCP has been received.
3401   4                      if(ScalerTimerPollingFlagProc(180, P72_CC_HDMI_GPVS, _BIT5, _TRUE) == _TRUE)
3402   4                      {
3403   5                          SET_HDMI_RX3_AVI_INFO_FRAME_RECEIVED();
3404   5                      }
3405   4                      else
3406   4                      {
3407   5                          CLR_HDMI_RX3_AVI_INFO_FRAME_RECEIVED();
3408   5                      }
3409   4                  }
3410   3              }
3411   2              // Neither AVI infoframe nor GCP packet received
