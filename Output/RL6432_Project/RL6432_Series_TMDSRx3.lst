3097          bit ScalerTMDSRx3HdmiSetDeepColorPll(WORD usTMDSClkCount, BYTE ucColorDepth)
3098          {
3099   1          DWORD ulTMDSClkValue = 0;
3100   1          WORD usM = 0;
3101   1          BYTE ucN = 0;
3102   1          BYTE ucDivS = 0;
3103   1          BYTE ucFactor = 0;
3104   1      
3105   1          ////////////////////////////////////////////////////////////////////////////////////////////////
3106   1          // Fin = TMDS_clk
3107   1          // Fref = Fin / N
3108   1          // Fvco = Fin * M / N
3109   1          // Freq = Fvco / Divs
3110   1          //
3111   1          // Restriction
3112   1          // A. BW = Kvco * Icp * R / (M * 2pi) = 700k (Band10 Kvco = 1880), R = 13k)
3113   1          // B. 300MHz < Fvco < 600MHz
3114   1          // C. (Fin / N) >= 10 * BW --> (Fin / N) >= 7MHz
3115   1          // D. YCbCr 420, Ratio = 2, other case Ratio = 1
C51 COMPILER V9.60.0.0   RL6432_SERIES_TMDSRX3                                             09/18/2026 20:39:33 PAGE 53  

3116   1          //
3117   1          // note 1.   According A, Icp = 2.5 ~ 20 --> 14 <= M <= 111
3118   1          // note 2.   According B and note 1. --> 3 <= (Fin / N) <= 42
3119   1          // note 3.   According C and note 2. --> 7 <= (Fin / N) <= 42
3120   1          // note 4_a. 10bit : (M / N / Divs) = (4 / 5 * Ratio) --> M = N * Divs * (4 / 5 * Ratio), N or Divs: m
             -ultiple of 5
3121   1          // note 4_b. 12bit : (M / N / Divs) = (2 / 3 * Ratio) --> M = N * Divs * (2 / 3 * Ratio), N or Divs: m
             -ultiple of 3
3122   1          // note 4_b. 16bit : (M / N / Divs) = (1 / 2 * Ratio) --> M = N * Divs * (1 / 2 * Ratio), N or Divs: m
             -ultiple of 2
3123   1          ////////////////////////////////////////////////////////////////////////////////////////////////
3124   1      
3125   1          // If Measure Divider = /2 then TMDS_CLK x 2, unit:kHz
3126   1          if(ScalerGetDataPortBit(P72_C9_HDMI_AP, _P72_CA_PT_28_PORT_PAGE72_HDMI_NTX1024TR0, _BIT6) == _BIT6)
3127   1          {
3128   2              ulTMDSClkValue = (DWORD)_GDI_CLK_KHZ * 1024 * 2 / usTMDSClkCount;
3129   2          }
3130   1          else
3131   1          {
3132   2              ulTMDSClkValue = (DWORD)_GDI_CLK_KHZ * 1024 / usTMDSClkCount;
3133   2          }
3134   1      
