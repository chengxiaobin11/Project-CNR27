2944          //--------------------------------------------------
2945          // Description  : Measure Clk
2946          // Input Value  : Clk Source to be measured
2947          // Output Value : Measured Clk Count
2948          //--------------------------------------------------
2949          WORD ScalerTMDSRx3MeasureClk(BYTE ucMeasureClk)
2950          {
2951   1          BYTE ucDelayCount = 0;
2952   1      
2953   1      #if(_D3_INPUT_PORT_TYPE == _D3_MHL_PORT)
                  if(GET_D3_TMDS_MODE() == _TMDS_MHL_MODE)
                  {
                      // Enable Rx_EN (Lane0,3)
                      ScalerSetBit(P7C_1A_CMU_00, ~(_BIT7 | _BIT4), (_BIT7 | _BIT4));
                  }
                  else
              #endif
2961   1          {
2962   2              // Enable Rx_EN (Lane3)
2963   2              ScalerSetBit(P7C_1A_CMU_00, ~_BIT7, _BIT7);
2964   2          }
2965   1      
2966   1          // Disable Measure for Reset Measure Window
2967   1          ScalerSetByte(P72_C9_HDMI_AP, _P72_CA_PT_28_PORT_PAGE72_HDMI_NTX1024TR0);
2968   1          ScalerSetBit(P72_CA_HDMI_DP, ~(_BIT5 | _BIT4 | _BIT3), 0x00);
2969   1      
2970   1          // Select reference clk to Xtal Clk and measure clk
2971   1          ScalerSetBit(P72_AD_TMDS_CPS, ~(_BIT6 | _BIT5 | _BIT4), ((ucMeasureClk << 5) | _BIT4));
2972   1      
2973   1          // Start Measure
2974   1          ScalerSetByte(P72_C9_HDMI_AP, _P72_CA_PT_28_PORT_PAGE72_HDMI_NTX1024TR0);
2975   1          ScalerSetBit(P72_CA_HDMI_DP, ~(_BIT5 | _BIT4 | _BIT3), _BIT3);
2976   1      
2977   1          // Delay at least 40us at Xtal = 27MHz
2978   1          for(ucDelayCount = 0; ucDelayCount <= 8; ucDelayCount++)
2979   1          {
2980   2              DELAY_5US();
2981   2      
2982   2              ScalerSetByte(P72_C9_HDMI_AP, _P72_CA_PT_28_PORT_PAGE72_HDMI_NTX1024TR0);
2983   2              if(ScalerGetBit(P72_CA_HDMI_DP, _BIT3) == 0x00)
2984   2              {
2985   3                  break;
2986   3              }
2987   2          }
2988   1      
2989   1          ScalerSetByte(P72_C9_HDMI_AP, _P72_CA_PT_28_PORT_PAGE72_HDMI_NTX1024TR0);
2990   1          pData[0] = ScalerGetByte(P72_CA_HDMI_DP);
2991   1      
C51 COMPILER V9.60.0.0   RL6432_SERIES_TMDSRX3                                             09/18/2026 20:39:33 PAGE 51  

2992   1          ScalerSetByte(P72_C9_HDMI_AP, _P72_CA_PT_29_PORT_PAGE72_HDMI_NTX1024TR1);
2993   1          pData[1] = ScalerGetByte(P72_CA_HDMI_DP);
2994   1      
2995   1          return ((WORD)(pData[0] & 0x07) << 8) | pData[1];
2996   1      }
