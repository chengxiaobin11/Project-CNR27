3136   1          if(GET_TMDS_RX3_HIGH_SPEED_MODE() == _TRUE)
3137   1          {
3138   2              ulTMDSClkValue = (ulTMDSClkValue << 2);
3139   2          }
3140   1      #endif
3141   1      
