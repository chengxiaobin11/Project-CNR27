3212   3              }
3213   2          }
3214   1      
3215   1          //////////////////////////////////////////////////////////////////////////////////////////////////
3216   1          // Precise formula of Chrage Pump Current depends on DPM, resistor, and band.                   //
3217   1          // If VCO band = 'b00, Icp = (700 * M * 2 * pi) / (778 * 0x01C1[7:5]).                          //
3218   1          // If VCO band = 'b01, Icp = (700 * M * 2 * pi) / (1340 * 0x01C1[7:5]).                         //
3219   1          // If VCO band = 'b10, Icp = (700 * M * 2 * pi) / (1880 * 0x01C1[7:5]).                         //
3220   1          // If VCO band = 'b11, Icp = (700 * M * 2 * pi) / (2340 * 0x01C1[7:5]).                         //
3221   1          // 700: DPLL max frequency design target is 700MHz; 778: Frequency curve in band00 is 778MHz.   //
3222   1          // Assume DPLL_M=0x13, DPM=0x13+2=21; DPN=2; reg_dpll_vcomd='b01; reg_dpll_rs[2:0]='b011;       //
3223   1          // Icp = (700 * 21 * 2 * 3.14) / (1340 * 13)                                                    //
3224   1          //////////////////////////////////////////////////////////////////////////////////////////////////
