3144   1      
3145   1          switch(ucColorDepth)
3146   1          {
3147   2              case _COLOR_DEPTH_10_BITS:
3148   2      
3149   2                  ucFactor = 5;
3150   2      
3151   2                  break;
3152   2      
3153   2              case _COLOR_DEPTH_12_BITS:
3154   2      
3155   2                  ucFactor = 3;
3156   2      
3157   2                  break;
3158   2      
3159   2              case _COLOR_DEPTH_16_BITS:
3160   2      
3161   2                  ucFactor = 2;
3162   2      
3163   2                  break;
3164   2      
3165   2              default:
3166   2      
3167   2                  return _FALSE;
3168   2          }
3169   1      
3170   1          // N <= (Fin / 7)
3171   1          PDATA_WORD(0) = (ulTMDSClkValue / 7000);
3172   1      
3173   1          if(PDATA_WORD(0) < 2)
3174   1          {
C51 COMPILER V9.60.0.0   RL6432_SERIES_TMDSRX3                                             09/18/2026 20:39:33 PAGE 54  

3175   2              return _FALSE;
3176   2          }
3177   1          else if(PDATA_WORD(0) >= ucFactor)
3178   1          {
3179   2              // N: Multiple of factor
3180   2              PDATA_WORD(0) -= (PDATA_WORD(0) % ucFactor);
3181   2          }
3182   1          else if(PDATA_WORD(0) > 255)
3183   1          {
3184   2              // N: Multiple of factor
3185   2              PDATA_WORD(0) = 255 - (255 % ucFactor);
3186   2          }
3187   1      
3188   1          ucN = PDATA_WORD(0);
3189   1      
3190   1          // for differenct Divs, find suitable Divs and M
3191   1          for(pData[15] = 0; pData[15] <= 254; pData[15] += 2)
3192   1          {
3193   2              // N or Divs: Multiple of factor
3194   2              if(((ucN % ucFactor) == 0x00) || ((pData[15] % ucFactor) == 0x00))
3195   2              {
3196   3                  usM = (WORD)ucN * ((pData[15] == 0) ? 1 : pData[15]) * (ucFactor - 1) / ucFactor;
3197   3      
