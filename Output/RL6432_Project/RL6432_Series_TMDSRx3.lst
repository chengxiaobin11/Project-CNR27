 324          //--------------------------------------------------
 325          // Description  : Initialize TMDS Interrupt Required Settings
 326          // Input Value  : None
 327          // Output Value : None
 328          //--------------------------------------------------
 329          void ScalerTMDSRx3InterruptInitial(void)
 330          {
 331   1          if(ScalerGetBit(P72_E6_HDMI_FREQDET_CTRL, _BIT1) == 0x00)
 332   1          {
 333   2              CLR_TMDS_RX3_PHY_SET();
 334   2          }
 335   1      
 336   1          // Enable Rx_En for Clk pair Z0
 337   1          ScalerSetBit(P7C_1A_CMU_00, ~_BIT7, _BIT7);
 338   1      
 339   1          // Choose Measure Clk to TMDS Clk
 340   1          ScalerSetBit(P72_E6_HDMI_FREQDET_CTRL, ~(_BIT7 | _BIT5 | _BIT4), 0x00);
 341   1      
 342   1          // Set Freq. Reference Counter = 2000
 343   1          ScalerSetBit(P72_F6_HDMI_FREQDET_BOUND_H, ~(_BIT1 | _BIT0), _BIT0);
 344   1      
C51 COMPILER V9.60.0.0   RL6432_SERIES_TMDSRX3                                             09/18/2026 20:39:33 PAGE 7   

 345   1          // Set Online Measure Input Clock Divider = /2 (No Matter if Input Clock >300Mhz or <=300Mhz)
 346   1          ScalerSetBit(P72_E7_HDMI_FREQDET_OFFSET, ~_BIT6, _BIT6);
 347   1      
 348   1          // Settings for IRQ set PHY
 349   1          // Consider using table to fill all required initial settings
 350   1          // Set pre-set threshold (225MHz * 0.01 / 26.8KHz = 0x54)
 351   1      
 352   1      #if(_D3_INPUT_PORT_TYPE == _D3_MHL_PORT)
                  if(GET_D3_TMDS_MODE() == _TMDS_MHL_MODE)
                  {
                      // Set TMDS Offset = 1/32
                      ScalerSetBit(P72_E7_HDMI_FREQDET_OFFSET, ~(_BIT2 | _BIT1 | _BIT0), _BIT1);
              
                      // Set Upper Bound
                      ScalerSetByte(P72_E8_HDMI_FREQDET_UPPER_M, HIBYTE(_TMDS_MHL_FREQ_NORMAL_UPPER_BOUND));
                      ScalerSetByte(P72_E9_HDMI_FREQDET_UPPER_L, LOBYTE(_TMDS_MHL_FREQ_NORMAL_UPPER_BOUND));
                  }
                  else
              #endif
 364   1          {
 365   2              // Set TMDS Offset = 1/32
 366   2              ScalerSetBit(P72_E7_HDMI_FREQDET_OFFSET, ~(_BIT2 | _BIT1 | _BIT0), _BIT1);
 367   2      
 368   2              // Set Upper Bound
 369   2              ScalerSetByte(P72_E8_HDMI_FREQDET_UPPER_M, HIBYTE(_TMDS_FREQ_NORMAL_HIGH_SPEED_UPPER_BOUND));
 370   2              ScalerSetByte(P72_E9_HDMI_FREQDET_UPPER_L, LOBYTE(_TMDS_FREQ_NORMAL_HIGH_SPEED_UPPER_BOUND));
 371   2          }
 372   1      
