                    ScalerOsdCommandByte(ucTmp, _OSD_BYTE1, 0);     
                  else if(ucTmp == 14)
                    ScalerOsdCommandByte(ucTmp, _OSD_BYTE1, 0);     
                  else if(ucTmp == 17)
                    ScalerOsdCommandByte(ucTmp, _OSD_BYTE1, 0);     
                  else if(ucTmp == 21)
                    ScalerOsdCommandByte(ucTmp, _OSD_BYTE1, 0);   
                  else  
                    ScalerOsdCommandByte(ucTmp, _OSD_BYTE1, 17);            
                }
              
                // Row Command end
                ScalerOsdCommandByte(ucMapHeight, _OSD_BYTE0, 0x00);
              }
              #endif
