1229          void RTDOsdDisplaySlider(BYTE ucRow, BYTE ucCol, BYTE ucLength, WORD usValue, WORD usMax, WORD usMin, BYTE
             - ucColor)
1230          {
1231   1        BYTE xdata ucCnt = 0;
