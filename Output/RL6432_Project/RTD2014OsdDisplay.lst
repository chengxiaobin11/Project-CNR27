1241   2        }
1242   1      
1243   1        if(usValue > usMax)
1244   1        {
1245   2          usValue = usMax;
1246   2        }
1247   1      
1248   1        usValue -= usMin;
1249   1        // ------------------------------------------------------------------------
1250   1        // Draw MINUS ICON
