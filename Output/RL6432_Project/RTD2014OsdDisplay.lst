             -ATUS()?100:0);
                
                #if(2160 <= _PANEL_DV_HEIGHT)
                if(!GET_OSD_ROTATE_STATUS())
                  ScalerSetByte(0x3A2C, 0x3e);
                #endif
              
                  ScalerTimerWaitForEvent(_EVENT_DEN_STOP);
                  OsdFuncEnableOsd();
              }
