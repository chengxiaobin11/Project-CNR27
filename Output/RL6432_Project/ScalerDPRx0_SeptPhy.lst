                  ScalerDpRx0SetDpcdValue(0x00, 0x00, 0x80, (_BIT6 | _BIT4 | _BIT3));
              #endif
              }
              #endif // End of #if(_DP_TX_SUPPORT == _ON)
              
              #endif // End of #if(_DP_MST_SUPPORT == _ON)
