7638   4      
7639   4                      if(ucDebounceCnt == 5)
7640   4                      {
7641   5                          SET_DP_RX0_CHECK_AUX_CH_POWER_STATUS(_DP_RX_AUX_POWER_STATUS_ON);
7642   5                      }
7643   4                  }
