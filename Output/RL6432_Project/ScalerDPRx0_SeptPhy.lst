6512          // Description  : DP PHY DFE Initial Setting
6513          // Input Value  : None
6514          // Output Value : None
6515          //--------------------------------------------------
6516          void ScalerDpRx0SetDFEInitial(EnumDpLinkRate enumDpLinkRate)
6517          {
6518   1          // [6] Enable Timer Control DFE Loop
6519   1          // [5:4] Reduce Gain to 1/4
6520   1          // [3] Disable Running Length Detection
6521   1          // [2] bypass Blank out Case-3 Symbol
6522   1          ScalerSetBit(P1D_A0_L0_DFE_EN_1, ~(_BIT6 | _BIT5 | _BIT4 | _BIT3 | _BIT2), (_BIT6 | _BIT5));
6523   1          ScalerSetBit(P1D_B0_L1_DFE_EN_1, ~(_BIT6 | _BIT5 | _BIT4 | _BIT3 | _BIT2), (_BIT6 | _BIT5));
6524   1          ScalerSetBit(P1D_C0_L2_DFE_EN_1, ~(_BIT6 | _BIT5 | _BIT4 | _BIT3 | _BIT2), (_BIT6 | _BIT5));
6525   1          ScalerSetBit(P1D_D0_L3_DFE_EN_1, ~(_BIT6 | _BIT5 | _BIT4 | _BIT3 | _BIT2), (_BIT6 | _BIT5));
6526   1      
6527   1          // [7:6] adapt_mode[1:0] = 2'b11 --> Amplitude-based Adaptation with Independent LE Loop(Loop Mode 3)
6528   1          // [5] edge_det_mode = 1 --> Edge Lag Data
6529   1          // [4] transition_only = 1 --> Only Transition Bit is Effective
