C51 COMPILER V9.60.0.0   SCALERDPRX0_SEPTPHY                                               09/24/2026 09:30:19 PAGE 7   

 351          //--------------------------------------------------
 352          // Description  : Dp Set Branch Device Specific Field 00500h - 005FFh
 353          // Input Value  : _DP_VERSION_1_1 or _DP_VERSION_1_2 or _DP_VERSION_1_4
 354          // Output Value : None
 355          //--------------------------------------------------
 356          void ScalerDpRx0SetBranchDeviceSpecificField(EnumDpVersionType enumDpVersion)
 357          {
 358   1          if(enumDpVersion >= _DP_VERSION_1_4)
 359   1          {
 360   2              // Branch IEEE OUI For DP1.4
 361   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x00, _DP_1_4_BRANCH_RTK_IEEE_OUI_L);
 362   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x01, _DP_1_4_BRANCH_RTK_IEEE_OUI_M);
 363   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x02, _DP_1_4_BRANCH_RTK_IEEE_OUI_H);
 364   2      
 365   2              // Branch IEEE OUI LSB For DP1.4
 366   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x03, _DP_1_4_BRANCH_RTK_ID_STRING_0);
 367   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x04, _DP_1_4_BRANCH_RTK_ID_STRING_1);
 368   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x05, _DP_1_4_BRANCH_RTK_ID_STRING_2);
 369   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x06, _DP_1_4_BRANCH_RTK_ID_STRING_3);
 370   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x07, _DP_1_4_BRANCH_RTK_ID_STRING_4);
 371   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x08, _DP_1_4_BRANCH_RTK_ID_STRING_5);
 372   2      
 373   2              // Branch HW/FW Version For DP1.4
 374   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x09, _DP_1_4_BRANCH_RTK_HW_VERSION);
 375   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x0A, _DP_1_4_BRANCH_RTK_FW_VERSION_H);
 376   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x0B, _DP_1_4_BRANCH_RTK_FW_VERSION_L);
 377   2          }
 378   1          else if(enumDpVersion >= _DP_VERSION_1_2)
 379   1          {
 380   2              // Branch IEEE OUI For DP1.2
 381   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x00, _DP_1_2_BRANCH_RTK_IEEE_OUI_L);
 382   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x01, _DP_1_2_BRANCH_RTK_IEEE_OUI_M);
 383   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x02, _DP_1_2_BRANCH_RTK_IEEE_OUI_H);
 384   2      
 385   2              // Branch IEEE OUI LSB For DP1.2
 386   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x03, _DP_1_2_BRANCH_RTK_ID_STRING_0);
 387   2              ScalerDpRx0SetDpcdValue(0x00, 0x05, 0x04, _DP_1_2_BRANCH_RTK_ID_STRING_1);
