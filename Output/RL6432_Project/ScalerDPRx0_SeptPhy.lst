 520          //--------------------------------------------------
 521          // Description  : DP BS to VS Delay Calculation
 522          // Input Value  : None
 523          // Output Value : BS to VS Delay
 524          //--------------------------------------------------
 525          DWORD ScalerDpRx0GetBStoVSDelay(void)
 526          {
 527   1          DWORD ulVFrontPorch = 0;
 528   1          DWORD ulHFrontPorch = 0;
 529   1          WORD usFifoOffset = 0;
 530   1      
 531   1          // Get Htotal
 532   1          ScalerRead(PB6_08_MSA_HTT_0, 2, &pData[2], _AUTOINC);
 533   1      
 534   1          // VFrontPorch = 3 * Htotal * (Link Clk / Stream CLK)
 535   1          ulVFrontPorch = ((DWORD)GET_DP_RX0_VFRONT_PORCH()) * ((DWORD)PDATA_WORD(1) * 256) / ((DWORD)GET_INPUT_
C51 COMPILER V9.60.0.0   SCALERDPRX0_SEPTPHY                                               09/24/2026 09:30:19 PAGE 10  

             -PIXEL_CLK()) *
 536   1                          ((DWORD)ScalerDpRx0GetDpcdInfo(0x00, 0x01, 0x00) * 270) / 256;
 537   1      
 538   1          // Get Hactive
 539   1          ScalerRead(PB6_0C_MSA_HWD_0, 2, pData, _AUTOINC);
 540   1      
 541   1          // Get HSW
 542   1          pData[4] = ScalerGetBit(PB6_0E_MSA_HSW_0, (_BIT6 | _BIT5 | _BIT4 | _BIT3 | _BIT2 | _BIT1 | _BIT0));
 543   1          pData[5] = ScalerGetByte(PB6_0F_MSA_HSW_1);
 544   1      
 545   1          // Get HSW min by Measure clock
 546   1          PDATA_WORD(3) = ((DWORD) _DP_HSYNC_WIDTH_MEASURE_COUNTER * GET_INPUT_PIXEL_CLK() * 100) / _MEASURE_CLK
             - + 1;
 547   1      
 548   1          // Check HSW <= HSW min
 549   1          if(PDATA_WORD(2) <= PDATA_WORD(3))
 550   1          {
 551   2              // Check if H porch is more than HSW min
 552   2              if((PDATA_WORD(1) - PDATA_WORD(0)) >= PDATA_WORD(3))
 553   2              {
 554   3                  // HSW = HSW min
 555   3                  PDATA_WORD(2) = PDATA_WORD(3);
 556   3              }
 557   2              else
 558   2              {
 559   3                  // HSW = Max H Porch
 560   3                  PDATA_WORD(2) = (PDATA_WORD(1) - PDATA_WORD(0));
 561   3              }
 562   2          }
 563   1      
 564   1          // DPF H Front Porch must not be less than 8 (HW constraint)
 565   1          // Check if H porch is more than 8
 566   1          if((PDATA_WORD(1) - PDATA_WORD(0) - PDATA_WORD(2)) <= _DP_HSYNC_FRONT_PORCH)
 567   1          {
 568   2              // HSW < HSW min
 569   2              if(PDATA_WORD(2) < PDATA_WORD(3))
 570   2              {
 571   3                  // Hstart = HSW
 572   3                  PDATA_WORD(4) = PDATA_WORD(2);
 573   3              }
 574   2              else if((PDATA_WORD(1) - PDATA_WORD(0) - PDATA_WORD(3) >= _DP_HSYNC_FRONT_PORCH))
 575   2              {
 576   3                  // HSW = H porch - _DP_HSYNC_FRONT_PORCH
 577   3                  PDATA_WORD(2) = PDATA_WORD(1) - PDATA_WORD(0) - _DP_HSYNC_FRONT_PORCH;
 578   3      
 579   3                  // Hstart = HSW
 580   3                  PDATA_WORD(4) = PDATA_WORD(2);
 581   3              }
 582   2              else
 583   2              {
 584   3                  // HSW = HSW min
 585   3                  PDATA_WORD(2) = PDATA_WORD(3);
 586   3      
 587   3                  // Hstart = HSW min
 588   3                  PDATA_WORD(4) = PDATA_WORD(3);
 589   3              }
 590   2          }
 591   1          else
 592   1          {
 593   2              // Hstart = Htotal - Hactive - _DP_HSYNC_FRONT_PORCH
 594   2              PDATA_WORD(4) = PDATA_WORD(1) - PDATA_WORD(0) - _DP_HSYNC_FRONT_PORCH;
 595   2          }
C51 COMPILER V9.60.0.0   SCALERDPRX0_SEPTPHY                                               09/24/2026 09:30:19 PAGE 11  

 596   1      
 597   1          // HFrontPorch = (Htotal - Hactive - Hstart) * (Link Clk / Stream CLK)
 598   1          ulHFrontPorch = (((DWORD)(PDATA_WORD(1) - PDATA_WORD(0) - PDATA_WORD(4))) * (((DWORD)ScalerDpRx0GetDpc
             -dInfo(0x00, 0x01, 0x00)) * 270) / ((DWORD)GET_INPUT_PIXEL_CLK()));
 599   1      
 600   1          pData[15] = GET_COLOR_DEPTH();
 601   1      
 602   1          // DP fifo size = 256 x 96bit
 603   1          if(GET_COLOR_SPACE() == _COLOR_SPACE_YCBCR422)
 604   1          {
 605   2              // FifoOffset = (1/2 * (256 * 96) / (2 * depth per color)), color format is YCbCr 4:2:2
 606   2              usFifoOffset = _HW_DP_RX_VIDEO_FIFO_SIZE / (4 * (WORD)pData[15]);
 607   2          }
 608   1          else
 609   1          {
 610   2              // FifoOffset = (1/2 * (256 * 96) / (3 * depth per color)), color format is RGB or YCbCr 4:4:4 or 
             -others
 611   2              usFifoOffset = _HW_DP_RX_VIDEO_FIFO_SIZE / (6 * (WORD)pData[15]);
 612   2          }
 613   1      
 614   1          // FifoOffset = (1/2 * (256 * 96) / (3 * depth per color)) * (Link Clk / Stream CLK))
 615   1          usFifoOffset = (WORD)(((DWORD)usFifoOffset) * (((DWORD)ScalerDpRx0GetDpcdInfo(0x00, 0x01, 0x00)) * 270
             -) / ((DWORD)GET_INPUT_PIXEL_CLK()));
 616   1      
 617   1          return ((ulVFrontPorch + ulHFrontPorch + (DWORD)usFifoOffset) / 2);
 618   1      }
