 230          //--------------------------------------------------
 231          // Description  : DP Adjust Vsync Delay
 232          // Input Value  : None
 233          // Output Value : None
 234          //--------------------------------------------------
 235          void ScalerDpRx0AdjustVsyncDelay(void)
 236          {
 237   1          DWORD ulBStoVSDelayDeltaOverflow = 0;
 238   1          DWORD ulBStoVSDelayDeltaUnderflow = 0;
 239   1      
 240   1          if(ScalerGetBit(PB5_21_PG_CTRL_1, (_BIT1 | _BIT0)) == 0x00)// Fifo Ok
 241   1          {
 242   2              return;
 243   2          }
 244   1          else if(ScalerGetBit(PB5_21_PG_CTRL_1, _BIT0) == _BIT0) // Fifo Overflow
 245   1          {
 246   2              // Get Htotal
 247   2              ScalerRead(PB6_08_MSA_HTT_0, 2, &pData[0], _AUTOINC);
 248   2      
 249   2              // ((Link Clk * 256)/ Stream CLK) * Htotal / 256 --> 1 Line
 250   2              ulBStoVSDelayDeltaOverflow = (((DWORD)ScalerDpRx0GetDpcdInfo(0x00, 0x01, 0x00) * 270UL) * 256) / (
             -(DWORD)GET_INPUT_PIXEL_CLK()) * ((DWORD)PDATA_WORD(0)) / 256;
 251   2      
 252   2              DebugMessageRx0("7. Fifo Overflow --> nVidia Case", ulBStoVSDelayDeltaOverflow);
 253   2          }
 254   1          else if(ScalerGetBit(PB5_21_PG_CTRL_1, _BIT1) == _BIT1) // Fifo Underflow
 255   1          {
 256   2              // Get Hactive
 257   2              ScalerRead(PB6_0C_MSA_HWD_0, 2, &pData[0], _AUTOINC);
 258   2      
 259   2              if(PDATA_WORD(0) != 1366)
 260   2              {
 261   3                  return;
 262   3              }
 263   2      
 264   2              PDATA_WORD(0) = PDATA_WORD(0) - 2;
 265   2      
 266   2              // Set Hactive
 267   2              ScalerSetByte(PB5_45_MN_DPF_HWD_M, pData[0]);
 268   2              ScalerSetByte(PB5_46_MN_DPF_HWD_L, pData[1]);
 269   2      
 270   2              // ((Link Clk * 2)/ Stream CLK) --> 2 pixels
 271   2              ulBStoVSDelayDeltaUnderflow = (((DWORD)ScalerDpRx0GetDpcdInfo(0x00, 0x01, 0x00) * 270) * 2) / ((DW
             -ORD)GET_INPUT_PIXEL_CLK());
 272   2      
 273   2              DebugMessageRx0("7. Fifo Underflow --> QD882 Case", ulBStoVSDelayDeltaUnderflow);
 274   2          }
 275   1      
 276   1          // For Initial Value Before Use PDATA_DWORD(0)
 277   1          pData[0] = 0;
 278   1      
 279   1          // Get BStoVSDelay Even
 280   1          ScalerRead(PB5_32_EVBLK2VS_H, 3, &pData[1], _AUTOINC);
 281   1      
 282   1          // For Initial Value Before Use PDATA_DWORD(1)
 283   1          pData[4] = 0;
 284   1      
 285   1          // Get BStoVSDelay Odd
 286   1          ScalerRead(PB5_35_OVBLK2VS_H, 3, &pData[5], _AUTOINC);
 287   1      
 288   1          // BStoVSDelay = BStoVSDelay + (Nvid * 256 / Mvid) * ((DWORD)Htotal) / 256;
C51 COMPILER V9.60.0.0   SCALERDPRX0_SEPTPHY                                               09/24/2026 09:30:19 PAGE 6   

 289   1          PDATA_DWORD(0) = PDATA_DWORD(0) - ((ulBStoVSDelayDeltaOverflow + ulBStoVSDelayDeltaUnderflow) / 2);
 290   1      
 291   1          // BStoVSDelay = BStoVSDelay + (Nvid * 256 / Mvid) * ((DWORD)Htotal) / 256;
 292   1          PDATA_DWORD(1) = PDATA_DWORD(1) - ((ulBStoVSDelayDeltaOverflow + ulBStoVSDelayDeltaUnderflow) / 2);
 293   1      
 294   1          // Set Even Field BS to VS Delay
 295   1          ScalerSetByte(PB5_32_EVBLK2VS_H, pData[1]);
 296   1          ScalerSetByte(PB5_33_EVBLK2VS_M, pData[2]);
 297   1          ScalerSetByte(PB5_34_EVBLK2VS_L, pData[3]);
 298   1      
 299   1          // Set Odd Field BS to VS Delay
 300   1          ScalerSetByte(PB5_35_OVBLK2VS_H, pData[5]);
 301   1          ScalerSetByte(PB5_36_OVBLK2VS_M, pData[6]);
 302   1          ScalerSetByte(PB5_37_OVBLK2VS_L, pData[7]);
 303   1      
 304   1          // Enable Double Buffer
 305   1          ScalerSetBit(PB5_30_DPF_CTRL_0, ~_BIT6, _BIT6);
 306   1      
 307   1          // Reset Display Format Gen
 308   1          ScalerSetBit(PB5_30_DPF_CTRL_0, ~_BIT7, 0x00);
 309   1          ScalerSetBit(PB5_30_DPF_CTRL_0, ~_BIT7, _BIT7);
 310   1      
 311   1          // Polling Vertical BS
 312   1          if(ScalerDpRx0PollingFlagLinkCheck(50, PB6_01_DP_VBID, _BIT0, _TRUE) == _FALSE)
 313   1          {
 314   2              return;
 315   2          }
 316   1      
 317   1          // Delay for PG Stable
 318   1          if(ScalerDpRx0TimerDelayXmsLinkCheck(_DP_ONE_FRAME_TIME_MAX) == _FALSE)
 319   1          {
 320   2              return;
 321   2          }
 322   1      }
 323          
 324          #if(_FORMAT_CONVERSION_SUPPORT == _ON)
              //--------------------------------------------------
              // Description  : Check VGIP VS bypass for DP
              // Input Value  : None
              // Output Value : _TRUE / _FALSE
              //--------------------------------------------------
              bit ScalerDpRx0CheckVgipVsBypass(void)
              {
                  // Get Hstart
                  ScalerRead(PB5_43_MN_DPF_HST_M, 2, &pData[0], _AUTOINC);
              
                  // Get Vstart
                  ScalerRead(PB5_4B_MN_DPF_VST_M, 2, &pData[2], _AUTOINC);
              
                  // Check for nVedia 2560x1440@144Hz timing (reduced blanking)
                  if((PDATA_WORD(0) < _VGIP_IH_CAPTURE_MIN_VALUE) ||
                     (PDATA_WORD(1) <= _VGIP_IV_CAPTURE_MIN_VALUE))
                  {
                      DebugMessageRx0("DP RX0 VGIP VS Bypass Mode", PDATA_WORD(0));
              
                      return _TRUE;
                  }
              
                  return _FALSE;
              }
              #endif
