              void ScalerDpRx0HdrDpcdSetting(void)
              {
                  EnumDpHdrSupport enumDpHdrSupport = ScalerDpRxHdrGetSupport(_D0_INPUT_PORT);
              
                  if((enumDpHdrSupport == _DP_HDR_SUPPORT_ON) && (GET_DP_RX_D0_PORT_TARGET_VERSION() >= _DP_VERSION_1_4)
             -)
