 327          // Description  : Initial TX variables and Send Null-Message
 328          // Input Value  : None
 329          // Output Value : None
 330          //--------------------------------------------------
 331          void UserCommonDdcciInitTx(void)
 332          {
 333   1          // Send Null-Message
 334   1          g_pucDdcciTxBuf[_DDCCI_SOURCE] = _DDCCI_DEST_ADDRESS;
 335   1          g_pucDdcciTxBuf[_DDCCI_LENGTH] = _DDCCI_CONTROL_STATUS_FLAG;
 336   1          g_pucDdcciTxBuf[_DDCCI_COMMAND] = UserCommonDdcciCalCheckSum();
 337   1      
 338   1      #if((_DP_SUPPORT == _ON) && (_DP_MST_SUPPORT == _ON))
                  if(GET_RUN_DDCCI_COMMAND_SRC() == _DDCCI_CMD_SRC_I2C)
              #endif
 341   1          {
 342   2              ScalerMcuDdcciSendData(g_pucDdcciTxBuf);
 343   2          }
 344   1      }
 345          
 346          //--------------------------------------------------
 347          // Description  : Initial RX variables
 348          // Input Value  : None
 349          // Output Value : None
 350          //--------------------------------------------------
 351          void UserCommonDdcciInitRx(void)
 352          {
 353   1          // Clear buffer for new message
 354   1          memset(g_pucDdcciRxBuf, 0, _DDCCI_RXBUF_LENGTH);
 355   1      }
 356          
 357          //--------------------------------------------------
 358          // Description  : Caculate checksum
 359          // Input Value  : None
 360          // Output Value : ucSum --> Checksum value
 361          //--------------------------------------------------
 362          BYTE UserCommonDdcciCalCheckSum(void)
 363          {
 364   1          BYTE ucCount = 0;
 365   1          BYTE ucCheckLen = 0;
 366   1          BYTE ucSum = _DDCCI_VIRTUAL_HOST_ADDRESS;
 367   1      
 368   1          ucCheckLen = (g_pucDdcciTxBuf[_DDCCI_LENGTH] & 0x7F) + 2;
 369   1      
 370   1          for(ucCount = 0; ucCount < ucCheckLen; ucCount++)
 371   1          {
 372   2              ucSum = ucSum ^ g_pucDdcciTxBuf[ucCount];
 373   2          }
 374   1      
 375   1          return ucSum;
 376   1      }
 377          
 378          //--------------------------------------------------
 379          // Description  : DDCCI VCP Feature Reply Max and Present Value
 380          // Input Value  : ucOpcode --> OPCODE
 381          //                  usMax --> Maximum Value
 382          //                  usPresent --> Present Value
 383          // Output Value : None
 384          //--------------------------------------------------
 385          void UserCommonDdcciSetVCPReplyValue(BYTE ucTypeOpcode, WORD usMax, WORD usPresent)
 386          {
 387   1          g_pucDdcciTxBuf[_DDCCI_TYPE_CODE] = ucTypeOpcode;
 388   1          g_pucDdcciTxBuf[_DDCCI_MAX_HIGH_BYTE] = HIBYTE(usMax);
C51 COMPILER V9.60.0.0   USERCOMMONDDCCIFUNCTION                                           09/24/2026 09:31:20 PAGE 8   

 389   1          g_pucDdcciTxBuf[_DDCCI_MAX_LOW_BYTE] = LOBYTE(usMax);
 390   1          g_pucDdcciTxBuf[_DDCCI_PRESENT_HIGH_BYTE] = HIBYTE(usPresent);
 391   1          g_pucDdcciTxBuf[_DDCCI_PRESENT_LOW_BYTE] = LOBYTE(usPresent);
 392   1      }
 393          
 394          //--------------------------------------------------
 395          // Description  : DDCCI Get and Reply Timing Report
 396          // Input Value  : None
 397          // Output Value : None
 398          //--------------------------------------------------
 399          void UserCommonDdcciGetTimingReport(void)
 400          {
 401   1          BYTE ucPolarity = 0;
 402   1      
 403   1          ucPolarity = (GET_INPUT_TIMING_H_POLARITY() | (GET_INPUT_TIMING_V_POLARITY() << 1));
 404   1      
 405   1          g_pucDdcciTxBuf[_DDCCI_SOURCE] = _DDCCI_DEST_ADDRESS;
 406   1          g_pucDdcciTxBuf[_DDCCI_TIMING_MSG_COMMAND] = _DDCCI_CMD_REPLY_TIMING_MESSAGE;
 407   1          g_pucDdcciTxBuf[_DDCCI_TIMING_MSG_OPCODE] = _DDCCI_OPCODE_TIMING_MSG;
 408   1          g_pucDdcciTxBuf[_DDCCI_TIMING_STATUS] = 0x00;
 409   1      
 410   1          // H sync pol :Bit 1 = 1:positive H-sync polarity
 411   1          if((bit)(ucPolarity & _BIT0) == _TRUE)
 412   1          {
 413   2              g_pucDdcciTxBuf[_DDCCI_TIMING_STATUS] |= _BIT1;
 414   2          }
 415   1      
 416   1          // V sync pol :Bit 0 = 1:positive V-sync polarity
 417   1          if((bit)(ucPolarity & _BIT1) == _TRUE)
 418   1          {
 419   2              g_pucDdcciTxBuf[_DDCCI_TIMING_STATUS] |= _BIT0;
 420   2          }
 421   1      
