 292          //--------------------------------------------------
 293          // Description  : User Common DDC Handler Process
 294          // Input Value  : None
 295          // Output Value : None
 296          //--------------------------------------------------
 297          void UserCommonDdcciHandler(void)
 298          {
 299   1      #if(_DDCCI_AUTO_SWITCH_SUPPORT == _ON)
 300   1          if(GET_RUN_DDCCI_COMMAND() == _FAIL)
 301   1          {
 302   2              if(GET_RECEIVE_DDCCI_CMD_NOT_FINISH() == _SUCCESS)
 303   2              {
 304   3                  // Polling User Ddcci Cmd Finished
 305   3                  ScalerTimerActiveTimerEvent(_CLR_DDCCI_CMD_RECEIVE_NOT_FINISH_TIMEOUT, _SYSTEM_TIMER_EVENT_CLR
             -_DDCCI_RECEIVE_COMMAND_NOT_FINISH);
 306   3              }
 307   2              else
 308   2              {
 309   3                  if(GET_DDCCI_AUTO_SWITCH() == _FALSE)
 310   3                  {
 311   4                      // Enable DDCCI Channel Auto Switch
 312   4                      SET_DDCCI_AUTO_SWITCH();
 313   4      
 314   4                      // Set Other DDC Enable
 315   4                      ScalerMcuDdcciAutoSwitchInactiveChannel(_ENABLE);
 316   4                  }
 317   3              }
 318   2          }
 319   1      #endif
 320   1          if(UserCommonDdcciKernelHandler() == _TRUE)
 321   1          {
 322   2              return;
 323   2          }
 324   1          UserDdcciHandler();
 325   1      }
