3426          //----------------------------------------------------------------------
3427          // Description  : Polling Scaler Flag Process in WDINT0
3428          // Input Value  : ucTimeout --> Timeout number (Max: 255 ms)
3429          //                usRegister--> Current Register
3430          //                ucBit     --> Polling Bit
3431          //                bSuccess  --> 1 or 0 when finished for Polling Bit
3432          // Output Value : Return _TRUE while polling success, _FALSE for timeout
3433          //----------------------------------------------------------------------
3434          BYTE ScalerTimerPollingFlagProc_WDINT(BYTE ucTimeout, WORD usRegister, BYTE ucBit, bit bSuccess) using 3
3435          {
3436   1          WORD usTimeElapsed = 0;
3437   1      
3438   1          // if WDINT Proirity > Timer2
3439   1          if(PX2 == 1)
3440   1          {
3441   2              TF2 = 0;
3442   2      
3443   2              do
3444   2              {
3445   3                  usTimeElapsed = ScalerTimerTimer2Count_WDINT(usTimeElapsed);
3446   3      
3447   3                  if(((bit)ScalerGetBit_EXINT(usRegister, ucBit) ^ bSuccess) == _FALSE)
3448   3                  {
3449   4                      return _TRUE;
3450   4                  }
3451   3              }
3452   2              while(usTimeElapsed <= ucTimeout);
3453   2          }
3454   1          else
3455   1          {
3456   2              WORD usPreviousTime = g_usTimerCounter;
3457   2      
3458   2              do
3459   2              {
3460   3                  if(((bit)ScalerGetBit_EXINT(usRegister, ucBit) ^ bSuccess) == _FALSE)
3461   3                  {
3462   4                      return _TRUE;
3463   4                  }
3464   3      
3465   3                  if(usPreviousTime != g_usTimerCounter)
3466   3                  {
3467   4                      usTimeElapsed++;
3468   4                      usPreviousTime = g_usTimerCounter;
3469   4                  }
3470   3              }
3471   2              while(usTimeElapsed <= ucTimeout);
3472   2          }
3473   1      
3474   1          return _FALSE;
3475   1      }
