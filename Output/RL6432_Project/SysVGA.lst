 197          //--------------------------------------------------
 198          // Description  : Modify Timing For Underscan
 199          // Input Value  : None
 200          // Output Value : None
 201          //--------------------------------------------------
 202          void SysVgaAdjustUnderScan(void)
 203          {
 204   1          WORD usUnderScanVHeight = 0;
 205   1      
 206   1          if(UserInterfaceAdjustUnderScan() == _FALSE)
 207   1          {
 208   2              return;
 209   2          }
 210   1      
 211   1          if(GET_INPUT_TIMING_VHEIGHT() < GET_UNDERSCAN_VHEIGHT())
 212   1          {
 213   2              // Adjust VgaTop Vstart for underscan; Default center-positioned
 214   2              usUnderScanVHeight = (GET_UNDERSCAN_VHEIGHT() - GET_INPUT_TIMING_VHEIGHT()) / 2;
 215   2      
 216   2              if(GET_INPUT_TIMING_VSTART() < (usUnderScanVHeight + ScalerIDomainVgipGetVCaptureStartMinValue()))
 217   2              {
 218   3                  SET_INPUT_TIMING_VSTART(usUnderScanVHeight + ScalerIDomainVgipGetVCaptureStartMinValue());
 219   3              }
 220   2      
 221   2              if((GET_INPUT_TIMING_VSTART() + GET_INPUT_TIMING_VHEIGHT() + 3) > GET_INPUT_TIMING_VTOTAL())
 222   2              {
 223   3                  SET_INPUT_TIMING_VSTART(GET_INPUT_TIMING_VTOTAL() - GET_INPUT_TIMING_VHEIGHT() - 3);
 224   3              }
 225   2      
 226   2              ScalerVgaTopSetCaptureVStartPosition(GET_INPUT_TIMING_VSTART() - 2);
 227   2      
 228   2      #if(_ADCNR_SUPPORT == _ON)
 229   2              // Disable ADCNR when underscan
 230   2              ScalerADCNREn(_DISABLE);
 231   2      #endif
 232   2          }
 233   1      }
