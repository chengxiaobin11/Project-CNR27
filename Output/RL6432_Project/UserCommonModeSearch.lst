                          return _TRUE;
                      }
                  }
                  else
                  {
                      if(GET_INPUT_TIMING_VHEIGHT() > (tINPUTMODE_PRESET_TABLE[ucCurrModeIndex].usIVHeight + _PRESET_MOD
             -E_VHEIGHT_TOLERANCE))
                      {
                          *pucModeBestInx = ucLastModeIndex;
              
                          return _TRUE;
                      }
                  }
              
                  return _FALSE;
              }
