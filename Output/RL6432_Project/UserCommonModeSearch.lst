             -VHeight)
                  {
                      return _FALSE;
                  }
              
                  if(tINPUTMODE_PRESET_TABLE[ucCurrModeIndex].usIVHeight > tINPUTMODE_PRESET_TABLE[ucLastModeIndex].usIV
             -Height)
                  {
                      if(GET_INPUT_TIMING_VHEIGHT() > (tINPUTMODE_PRESET_TABLE[ucLastModeIndex].usIVHeight + _PRESET_MOD
             -E_VHEIGHT_TOLERANCE))
                      {
