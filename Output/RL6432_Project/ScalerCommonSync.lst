                                  ScalerSyncTMDSRx2HdmiColorimetryExtSetting();
              
                                  if((GET_COLOR_SPACE() == _COLOR_SPACE_YCBCR420) || (GET_COLOR_SPACE() == _COLOR_SPACE_
             -YCBCR422) || (GET_COLOR_SPACE() == _COLOR_SPACE_YCBCR444))
                                  {
                                      if(!(((pucTemp[0] == _AVI_COLORIMETRY_EXT_100) && (pucTemp[1] == _AVI_COLORIMETRY_
             -EXT_111)) || ((pucTemp[1] == _AVI_COLORIMETRY_EXT_100) && (pucTemp[0] == _AVI_COLORIMETRY_EXT_111))))
                                      {
                                          SET_TMDS_RX2_COLORIMETRY_EXT_CHANGED();
                                      }
                                  }
                                  else if(GET_COLOR_SPACE() == _COLOR_SPACE_RGB)
                                  {
                                      if(!(((pucTemp[0] != _AVI_COLORIMETRY_EXT_100) && (pucTemp[0] != _AVI_COLORIMETRY_
             -EXT_110)) && ((pucTemp[1] != _AVI_COLORIMETRY_EXT_100) && (pucTemp[1] != _AVI_COLORIMETRY_EXT_110))))
                                      {
                                          SET_TMDS_RX2_COLORIMETRY_EXT_CHANGED();
                                      }
                                  }
                              }
