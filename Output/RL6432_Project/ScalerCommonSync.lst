              bit ScalerSyncGetUrgentDpRxLinkLossInfo(void)
              {
                  bit bUrgentLinkLoss = _FALSE;
              
              #if(_D0_DP_EXIST == _ON)
                  if(GET_DP_RX0_LINK_TRAINING_STATUS() == _DP_NORMAL_LINK_TRAINING_PASS)
