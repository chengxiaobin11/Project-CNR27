              bit ScalerSyncDpTxCloneOutputPortCheck(BYTE ucInputPort)
              {
                  ucInputPort = ucInputPort;
              
              #if(_FREESYNC_SUPPORT == _ON)
                  if(GET_FREESYNC_ENABLED() == _TRUE)
                  {
              #if(_DP_FREESYNC_SUPPORT == _ON)
                      if(GET_DP_FREESYNC_ENABLED() == _TRUE)
                      {
                          if(GET_DP_TX_DOWNSTREAM_MSA_IGNORED() != _TRUE)
                          {
                              DebugMessageMst("Clone Mode Sink Not Support Freesync", 0);
              
                              return _FALSE;
                          }
                      }
                      else
              #endif
                      {
                          return _FALSE;
                      }
                  }
              #endif
              
              #if((_HW_DP_TX_VSC_SDP_TRANSMIT_SUPPORT == _OFF) && (_HDR10_SUPPORT == _ON))
                  if(GET_HDR10_EOTF_SETTING() != _HDR_INFO_EOTF_TRADITIONAL_GAMMA_SDR)
                  {
                      return _FALSE;
                  }
              #endif
              
                  return _TRUE;
              }
              
