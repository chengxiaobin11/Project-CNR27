                  ScalerSetBit(P1_D1_LVDSPLL_1, ~_BIT0, _BIT0);
              
                  // Disable SSCG
                  ScalerSetBit(P1_CA_SSCG_0, ~_BIT7, 0x00);
              
                  // Reset PLL N.F Code
                  ScalerPLLSetDPLLNFcode(0);
              
              #elif(_DPLL_STRUCT_TYPE == _DPLL_STRUCT_N_F)
              
              #if(_PANEL_STYLE == _PANEL_LVDS)
                  // Power Down LVDS
