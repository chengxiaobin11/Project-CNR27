              //--------------------------------------------------
              // Description  :
              // Input Value  :
              // Output Value :
              //--------------------------------------------------
              void ScalerPLLAdjustApllHighGainMode(WORD usIcode, WORD usPcode)
              {
                  if(usIcode < (0x7FFF / 8))
                  {
                      usIcode <<= 3;
                  }
                  else
                  {
                      usIcode = 0x7FF;
                  }
              
                  if(usPcode < (0xFF / 8))
                  {
                      usPcode <<= 3;
                  }
                  else
                  {
                      usPcode = 0xFF;
                  }
              
                  // Set I code
                  ScalerSetByte(P1_A1_I_CODE_M, (BYTE)(usIcode >> 8));
                  ScalerSetByte(P1_A2_I_CODE_L, (BYTE)usIcode);
              
                  // Set P code
                  ScalerSetByte(P1_A3_P_CODE, (BYTE)usPcode);
              }
              #endif
3755          
3756          #endif // End of #if(_VGA_SUPPORT == _ON)
