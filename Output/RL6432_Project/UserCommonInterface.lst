              #if(_D4_HDMI_MULTI_EDID_SUPPORT == _ON)
C51 COMPILER V9.60.0.0   USERCOMMONINTERFACE                                               09/21/2026 15:33:23 PAGE 73  

                  // D4 External Edid Config Setting
                  UserCommonInterfaceHDMISwitchMultiEeprom(_D4_INPUT_PORT, UserInterfaceGetMultiHdmiEdidIndex(_D4_INPUT_
