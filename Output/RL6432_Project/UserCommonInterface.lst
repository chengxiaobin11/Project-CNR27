                          SET_DATA_EXCHANGE_EVENT_MESSAGE(_DATA_EXCHAGNE_CMD_MST_ON_OFF);
              
                          DebugMessageSystem("OSD -- MST On/Off Switch", g_stD0DataExchange.unionDataExchangeItem.stMstO
