 412          void RTDFactoryMenuOperation(void)
 413          {
 414   1          if((GET_OSD_STATE() >= _MENU_FACTORY_AUTOCOLOR) &&
 415   1             (GET_OSD_STATE() < _MENU_FACTORY_OSD_END) &&
 416   1             (GET_KEYMESSAGE() < _FACTORY_KEY_AMOUNT))
 417   1          {
 418   2          if(GET_KEYMESSAGE() == 1)
 419   2                (*OperationFactoryTable[GET_OSD_STATE() - _MENU_FACTORY_AUTOCOLOR][2])();
 420   2          else if(GET_KEYMESSAGE() == 2)
 421   2                (*OperationFactoryTable[GET_OSD_STATE() - _MENU_FACTORY_AUTOCOLOR][1])();
 422   2          else
 423   2                (*OperationFactoryTable[GET_OSD_STATE() - _MENU_FACTORY_AUTOCOLOR][GET_KEYMESSAGE()])();
 424   2          }
 425   1      }
