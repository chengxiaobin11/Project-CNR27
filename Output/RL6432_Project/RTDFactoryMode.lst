 616          //============= Auto Color =======================
 617          void RTDFactoryAutoColorEnter(void)
 618          {
 619   1      #if(_VGA_SUPPORT == _ON)
 620   1          BYTE ucTemp = 0;
 621   1      
 622   1          if(SysSourceGetSourceType() == _SOURCE_VGA)
 623   1          {
 624   2              if(GET_OSD_FACTORY_AUTO_COLOR_TYPE() == _AUTO_COLOR_TYPE_INTERNAL)
 625   2              {
 626   3                  RTDFactoryOsdFuncDisableOsd();
 627   3                  ucTemp = _AUTO_CALIBRATE_RGB;
 628   3              }
 629   2              else
 630   2              {
 631   3                  ucTemp = _AUTO_TUNE_RGB;
 632   3              }
 633   2      
 634   2              if(ScalerAutoDoWhiteBalance(ucTemp) == _AUTO_SUCCESS)
 635   2              {
 636   3                  ScalerAutoGetAutoColorResult(&g_stAdcData);
 637   3                  RTDFactoryOsdFuncChangeColor1Bit(_FACTORY_AUTOCOLOR_ROW, _FACTORY_ON_OFF_COL, WIDTH(6), 1, COL
             -OR(_CP_BG, _CP_BG));
