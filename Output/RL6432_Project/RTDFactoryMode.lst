             -O_COLOR, tFONT_FACTORY_EUROPE, tOSD_FACTORY_PASS_FAIL_TABLE[1], _ENGLISH);
 639   3                  RTDFactoryOsdFuncChangeColor1Bit(_FACTORY_AUTOCOLOR_ROW, _FACTORY_ON_OFF_COL, WIDTH(6), 1, COL
             -OR(_CP_WHITE, _CP_BG));
 640   3                  UserCommonNVRamSaveADCSetting(_COLOR_SPACE_RGB);
 641   3              }
 642   2              else
 643   2              {
 644   3                  RTDFactoryOsdFuncChangeColor1Bit(_FACTORY_AUTOCOLOR_ROW, _FACTORY_ON_OFF_COL, WIDTH(6), 1, COL
             -OR(_CP_BG, _CP_BG));
 645   3                  RTDFactoryOsdFuncPutStringProp(_FACTORY_AUTOCOLOR_ROW, _FACTORY_ON_OFF_COL, _PFONT_FACTORY_AUT
             -O_COLOR, tFONT_FACTORY_EUROPE, tOSD_FACTORY_PASS_FAIL_TABLE[0], _ENGLISH);
 646   3                  RTDFactoryOsdFuncChangeColor1Bit(_FACTORY_AUTOCOLOR_ROW, _FACTORY_ON_OFF_COL, WIDTH(6), 1, COL
             -OR(_CP_WHITE, _CP_BG));
 647   3                  UserCommonNVRamRestoreADCSetting();
 648   3              }
 649   2              RTDFactoryOsdFuncShowNumber(ROW(_FACTORY_ADC_GAIN_ROW), COL(_FACTORY_R_NUMBER_COL), g_stAdcData.pu
             -cAdcGainMSB[_AUTO_RED_CHANNEL], (_ALIGN_RIGHT | _FORCE_SHOW_NUMBER_OFF | _SHOW_3), _PFONT_FACTORY_ADC_GAIN_R);
 650   2              RTDFactoryOsdFuncShowNumber(ROW(_FACTORY_ADC_GAIN_ROW), COL(_FACTORY_G_NUMBER_COL), g_stAdcData.pu
