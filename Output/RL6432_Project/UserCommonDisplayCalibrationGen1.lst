4512          // Description  : Save OGC/OCC Header
4513          // Input Value  : None
4514          // Output Value : None
4515          //--------------------------------------------------
4516          void UserCommonDdcciDispCalibSaveHeader(void)
4517          {
4518   1          // UserCommonFlashWrite(_OGC_FLASH_BANK, 0x0030, g_pucDdcciRxBuf[1] & 0x7F, g_pucDdcciRxBuf);
4519   1          //==========Write OGC Header============
4520   1          pData[0] = 0x11;
4521   1          pData[1] = 0x11;
4522   1          pData[2] = _OGC_HEADER_LENGTH;
4523   1          pData[3] = g_pucDdcciRxBuf[_OGC_HEADER_IF_DO_OGC]; // 1: Do OGC; 0: not do OGC, even if OGC SUPPORT is
             - on
4524   1          UserCommonFlashWrite(_OGC_FLASH_BANK, _OGC_HEADER_ADDRESS, 4, pData);
4525   1          UserCommonFlashWrite(_OGC_FLASH_BANK, _OGC_HEADER_ADDRESS + 4, 2 + _OGC_TOTAL_GAMMA + _OGC_TOTAL_CT, g
             -_pucDdcciRxBuf + _OGC_HEADER_GAMMA_CT_INDEX);
4526   1          // Gamma Number, Gamma Index1, GammaIndex2,..., Gamma Index n;
4527   1          // CT Numer, CT Index1, CT Index 2, ..., CT Index n.
4528   1      
4529   1          //==========Write OCC Header============
4530   1          pData[0] = 0x22;
4531   1          pData[1] = 0x22;
4532   1          pData[2] = _OCC_HEADER_LENGTH;
4533   1          pData[3] = g_pucDdcciRxBuf[_OCC_HEADER_IF_DO_OCC]; // 1: do OCC; 0: not do OCC, even if OCC support is
             - on
4534   1          pData[4] = g_pucDdcciRxBuf[_OCC_HEADER_MATRIX_NUMBER]; // Matrix Number:3/2/1. 1st is sRGB, 2nd is Ado
             -be, 3rd is SoftProof
4535   1          UserCommonFlashWrite(_OGC_FLASH_BANK, _OCC_HEADER_ADDRESS, 5, pData);
4536   1          //==========Write DICOM Header============
4537   1          pData[0] = 0x33;
4538   1          pData[1] = 0x33;
4539   1          pData[2] = _DICOM_HEADER_LENGTH;
4540   1          pData[3] = g_pucDdcciRxBuf[_DICOM_HEADER_IF_DO_DICOM];
4541   1          pData[4] = g_pucDdcciRxBuf[_DICOM_HEADER_MODE]; // 0 - By RGB Mode; 1- By Gray Mod
4542   1          UserCommonFlashWrite(_OGC_FLASH_BANK, _DICOM_HEADER_ADDRESS, 5, pData);
4543   1      
4544   1          //==========Write White Lv Header============
4545   1          pData[0] = 0x44;
