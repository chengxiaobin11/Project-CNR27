C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 30  

                      }
              #endif
              
                      CLR_AUDIO_D1_PACKET_DETECT();
                      SET_D1_DIGITAL_AUDIO_SOURCE(_DIGITAL_AUDIO_SOURCE_NONE);
              
              #if(_HDMI_AUDIO_FW_TRACKING_MODE_SUPPORT == _ON)
                      if(GET_AUDIO_D3_SAMPLING_FREQ() > _AUDIO_FREQ_48K)
              #endif
                      {
                          if(GET_AUDIO_D1_ICODE_RELOADED() == _TRUE)
                          {
                              ScalerTimerCancelTimerEvent(_SCALER_TIMER_EVENT_AUDIO_D1_LOAD_STABLE_I_CODE);
              
                              ScalerAudioD1LoadInitialICode();
              
                              CLR_AUDIO_D1_ICODE_RELOADED();
                          }
                      }
                  }
              }
              
              //--------------------------------------------------
              // Description  : Get D1 Audio Detected
              // Input Value  : None
              // Output Value : TRUE => Audio Detected
              //--------------------------------------------------
              bit ScalerAudioD1GetAudioDetected(void)
              {
                  // Check audio packet
                  if(GET_AUDIO_D1_PACKET_DETECT() == _FALSE)
                  {
                      DebugMessageAudio("False : D1 Audio Packet", 0);
                      return _FALSE;
                  }
              
                  // Check FW tracking state
              #if(_HDMI_AUDIO_FW_TRACKING_MODE_SUPPORT == _ON)
              #if(_D1_HDMI_SUPPORT == _ON)
                  if((GET_AUDIO_D1_FW_TRACKING_STATE() != _AUDIO_FW_TRACKING_PROCESS_PLAYBACK) &&
                     (GET_AUDIO_D1_SAMPLING_FREQ() <= _AUDIO_FREQ_48K))
                  {
                      DebugMessageAudio("False : D1 Audio FW Tracking preparing", 0);
                      return _FALSE;
                  }
              #endif
              #endif
              
              #if(_D1_HDMI_SUPPORT == _ON)
                  // Check AVMute
                  if(ScalerGetBit(P71_CB_HDMI_SR, _BIT6) == _BIT6)
                  {
                      DebugMessageAudio("False : D1 AVMute", 0);
                      return _FALSE;
                  }
              
                  // Check Audio Tracking
                  if(ScalerGetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_15_PORT_PAGE71_HDMI_PSCR, (_BIT3 | _BIT2)) == 0x00)
                  {
                      DebugMessageAudio("False : D1 HDMI Audio Tracking Disable", 0);
                      return _FALSE;
                  }
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 31  

              
                  // Check HDMI audio FIFO overflow and underflow
                  if(ScalerGetBit(P71_CB_HDMI_SR, (_BIT2 | _BIT1)) != 0x00)
                  {
                      DebugMessageAudio("False : D1 HDMI Audio FIFO", ScalerGetBit(P71_CB_HDMI_SR, (_BIT2 | _BIT1)));
              
                      if(ScalerGetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_31_PORT_PAGE71_HDMI_WDCR0, (_BIT2 | _BIT1)) == 
             -0x00)
                      {
                          // Clear HDMI audio FIFO overflow and underflow status
                          ScalerSetBit(P71_CB_HDMI_SR, ~(_BIT2 | _BIT1), (_BIT2 | _BIT1));
              
                          if(ScalerGetBit(P71_CB_HDMI_SR, (_BIT2 | _BIT1)) != 0x00)
                          {
                              DebugMessageAudio("False : D1 HDMI Audio FSM Reset", ScalerGetBit(P71_CB_HDMI_SR, (_BIT2 |
             - _BIT1)));
              
                              // Set Double Buffer bit
                              ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_10_PORT_PAGE71_HDMI_CMCR, ~_BIT4, _BIT4);
              
                              // Clear HDMI audio FIFO overflow and underflow status
                              ScalerSetBit(P71_CB_HDMI_SR, ~(_BIT2 | _BIT1), (_BIT2 | _BIT1));
                          }
                      }
              
                      return _FALSE;
                  }
              
              #elif(_D1_DP_EXIST == _ON)
                  // Check Audio FSM
                  if(ScalerGetBit(PB9_74_AUD_FSM_CTRL_0, _BIT7) == 0x00)
                  {
                      DebugMessageAudio("False : D1 DP Audio Fsm Disable", 0);
              
                      return _FALSE;
                  }
              
                  // Check Audio Tracking
                  if(ScalerGetBit(PB9_81_AUD_BDRY_0, _BIT7) == 0x00)
                  {
                      DebugMessageAudio("False : D1 DP Audio Tracking Disable", 0);
              
                      return _FALSE;
                  }
              
                  // Check DP audio buffer overflow and underflow
                  if(ScalerGetBit(PB9_70_AUD_BUFFER_CTRL_0, (_BIT1 | _BIT0)) != 0x00)
                  {
                      DebugMessageAudio("False : D1 DP Audio Buffer", ScalerGetBit(PB9_70_AUD_BUFFER_CTRL_0, (_BIT1 | _B
             -IT0)));
              
                      if(ScalerGetBit(PB9_39_DP_AWD_CTRL, (_BIT7 | _BIT6)) == 0x00)
                      {
                          // Clear audio FIFO overflow and underflow status
                          ScalerSetBit(PB9_70_AUD_BUFFER_CTRL_0, ~(_BIT1 | _BIT0), (_BIT1 | _BIT0));
              
                          // Waiting for 2ms(Audio Freq. Detect || Audio FIFO Write (1/2 FIFO depth = 64 packet)) + 1ms(
             -Audio Stable Time Count = 5 x 200us)
                          ScalerTimerDelayXms(3);
              
                          if(ScalerGetBit(PB9_70_AUD_BUFFER_CTRL_0, (_BIT1 | _BIT0)) != 0x00)
                          {
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 32  

                              DebugMessageAudio("False : D1 DP Audio FSM Reset", ScalerGetBit(PB9_70_AUD_BUFFER_CTRL_0, 
             -(_BIT1 | _BIT0)));
              
                              // Reset Audio FSM
                              ScalerSetBit(PB9_74_AUD_FSM_CTRL_0, ~_BIT7, 0x00);
              
                              // Clear audio FIFO overflow and underflow status
                              ScalerSetBit(PB9_70_AUD_BUFFER_CTRL_0, ~(_BIT1 | _BIT0), (_BIT1 | _BIT0));
              
                              // Enable Audio FSM
                              ScalerSetBit(PB9_74_AUD_FSM_CTRL_0, ~_BIT7, _BIT7);
              
                              // Waiting for 2ms(Audio Freq. Detect || Audio FIFO Write (1/2 FIFO depth = 64 packet)) + 
             -1ms(Audio Stable Time Count = 5 x 200us)
                              ScalerTimerDelayXms(3);
                          }
                      }
              
                      return _FALSE;
                  }
              #endif
              
                  return _TRUE;
              }
              
              //--------------------------------------------------
              // Description  : Detect D1 Audio Sampling Freq
              // Input Value  : None
              // Output Value : Audio Sampling Freq
              //--------------------------------------------------
              EnumAudioSamplingFreqType ScalerAudioD1SamplingFreqDetect(void)
              {
                  EnumAudioSamplingFreqType enumAudioFreq = _AUDIO_FREQ_NO_AUDIO;
              
              #if(_D1_HDMI_SUPPORT == _ON)
                  if(CHECK_TMDS_DPHY_SWITCH(_D1_INPUT_PORT) != _TRUE)
                  {
                      return _AUDIO_FREQ_NO_AUDIO;
                  }
              #endif
              
              #if(_INTERNAL_AUDIO_TEST_SUPPORT == _ON)
              #if(_D1_DP_EXIST == _ON)
                  if(ScalerAudioDpGetInternalAudioGenEnable() == _ENABLE)
              #elif(_D1_HDMI_SUPPORT == _ON)
                  if(ScalerAudioD2GetInternalAudioGenEnable() == _ENABLE)
              #endif
                  {
                      // For Audio test pattern
                      SET_AUDIO_D1_SAMPLING_FREQ(_AUDIO_FREQ_48K);
                      return _AUDIO_FREQ_48K;
                  }
              #endif
              
                  // HBR Audio Detect
                  ScalerAudioD1HbrAudioDetect();
              
                  // Get Audio Sample Count
              #if(_D1_HDMI_SUPPORT == _ON)
                  enumAudioFreq = ScalerGetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_8B_PORT_PAGE71_AUDIO_FREQ_RESULT, (_BI
             -T3 | _BIT2 | _BIT1 | _BIT0));
              #elif(_D1_DP_EXIST == _ON)
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 33  

                  enumAudioFreq = (ScalerGetBit(PB9_61_AUD_SAMPLE_CNT_0, (_BIT7 | _BIT6 | _BIT5 | _BIT4)) >> 4);
              #endif
              
                  if(enumAudioFreq != GET_AUDIO_D1_SAMPLING_FREQ())
                  {
              #if(_EMBEDDED_DAC_SUPPORT == _ON)
                      if(enumAudioFreq <= _AUDIO_FREQ_64K)
                      {
                          ScalerSetBit(P6_D4_DA_CLK_CTRL, ~(_BIT7 | _BIT6), 0x00);
                      }
                      else if(enumAudioFreq <= _AUDIO_FREQ_128K)
                      {
                          ScalerSetBit(P6_D4_DA_CLK_CTRL, ~(_BIT7 | _BIT6), _BIT6);
                      }
                      else
                      {
                          ScalerSetBit(P6_D4_DA_CLK_CTRL, ~(_BIT7 | _BIT6), _BIT7);
                      }
              #endif
              
              #if(_D1_DP_EXIST == _ON)
                      // Audio DVC Setting
                      ScalerAudioD1DPSetDVCWindowSize(_DP_DVC_ADJUST_TYPE, ScalerAudioGetSamplingFreqPacket(enumAudioFre
             -q));
              #endif
                  }
              
                  SET_AUDIO_D1_SAMPLING_FREQ(enumAudioFreq);
              
                  return enumAudioFreq;
              }
              
              //--------------------------------------------------
              // Description  : Check Audio Sampling Frequency Ever Change
              // Input Value  : None
              // Output Value : _TRUE => Change / _FALSE => No Change
              //--------------------------------------------------
              bit ScalerAudioD1SamplingFreqChange(void)
              {
              #if(_D1_HDMI_SUPPORT == _ON)
              
                  return _FALSE;
              
              #elif(_D1_DP_EXIST == _ON)
              
                  if(GET_DP_D1_AUDIO_SAMPLING_FREQ_CHANGE() == _TRUE)
                  {
                      // Clear Change Flag when check
                      CLR_DP_D1_AUDIO_SAMPLING_FREQ_CHANGE();
              
                      return _TRUE;
                  }
              
                  return _FALSE;
              #endif
              }
              
              //--------------------------------------------------
              // Description  : D1 Audio Watch Dog Proc
              // Input Value  : bOn
              // Output Value : None
              //--------------------------------------------------
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 34  

              void ScalerAudioD1WatchDogProc(bit bOn)
              {
                  if(bOn == _ON)
                  {
              #if(_D1_HDMI_SUPPORT == _ON)
                      // Clear audio FIFO overflow and underflow status
                      ScalerSetBit(P71_CB_HDMI_SR, ~(_BIT2 | _BIT1), (_BIT2 | _BIT1));
              
                      // Enable Audio Watch Dog for FIFO Overflow/Underflow
                      ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_31_PORT_PAGE71_HDMI_WDCR0, ~(_BIT2 | _BIT1), (_BIT
             -2 | _BIT1));
              #elif(_D1_DP_EXIST == _ON)
                      // Clear audio buffer overflow and underflow status
                      ScalerSetBit(PB9_70_AUD_BUFFER_CTRL_0, ~(_BIT1 | _BIT0), (_BIT1 | _BIT0));
              
                      // Enable Audio FSM
                      ScalerSetBit(PB9_74_AUD_FSM_CTRL_0, ~_BIT7, _BIT7);
              
                      // Enable Audio Watch Dog for Buffer Overflow/Underflow
                      ScalerSetBit(PB9_39_DP_AWD_CTRL, ~(_BIT7 | _BIT6), (_BIT7 | _BIT6));
              #endif
                  }
                  else
                  {
              #if(_D1_HDMI_SUPPORT == _ON)
                      // Disable Audio Watch Dog for FIFO Overflow/Underflow
                      ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_31_PORT_PAGE71_HDMI_WDCR0, ~(_BIT2 | _BIT1), 0x00)
             -;
              
              #elif(_D1_DP_EXIST == _ON)
                      // Disable Audio Watch Dog for Buffer Overflow/Underflow
                      ScalerSetBit(PB9_39_DP_AWD_CTRL, ~(_BIT7 | _BIT6), 0x00);
              
                      if(ScalerGetBit(PB9_70_AUD_BUFFER_CTRL_0, (_BIT1 | _BIT0)) != 0x00)
                      {
                          DebugMessageAudio("WD : D1 DP Audio Over/Underflow", ScalerGetBit(PB9_70_AUD_BUFFER_CTRL_0, (_
             -BIT1 | _BIT0)));
              
                          // Reset Audio FSM
                          ScalerSetBit(PB9_74_AUD_FSM_CTRL_0, ~_BIT7, 0x00);
              
                          // Clear audio FIFO overflow and underflow status
                          ScalerSetBit(PB9_70_AUD_BUFFER_CTRL_0, ~(_BIT1 | _BIT0), (_BIT1 | _BIT0));
              
                          // Enable Audio FSM
                          ScalerSetBit(PB9_74_AUD_FSM_CTRL_0, ~_BIT7, _BIT7);
              
                          // Waiting for 2ms(Audio Freq. Detect || Audio FIFO Write (1/2 FIFO depth = 64 packet)) + 1ms(
             -Audio Stable Time Count = 5 x 200us)
                          ScalerTimerDelayXms(3);
                      }
              #endif
                  }
              }
              
              //--------------------------------------------------
              // Description  : D1 Audio HBR Packet Detect
              // Input Value  : None
              // Output Value : None
              //--------------------------------------------------
              void ScalerAudioD1HbrAudioDetect(void)
              {
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 35  

              #if(_D1_DP_EXIST == _ON)
                  // Check HBR Audio Receive
                  if(ScalerGetBit(PB9_B0_DP_AUD_CTRL, (_BIT3 | _BIT2 | _BIT1 | _BIT0)) == _BIT0)
                  {
                      // Check Current Detect Mode
                      if(ScalerGetBit(PB9_B0_DP_AUD_CTRL, _BIT6) != _BIT6)
                      {
                          // Enable Audio HBR Mode Detect
                          ScalerAudioD1HbrModeControl(_ON);
              
                          // Wait for New Audio Packet Recived via detect interval + 1ms
                          ScalerTimerDelayXms((ScalerGetBit(PB9_50_AUD_FREQUENY_DET_0, (_BIT3 | _BIT2)) >> 2) + 1);
              
                          DebugMessageAudio("Dp D1 HBR Mode Detect Enable", _ENABLE);
                      }
                  }
                  else
                  {
                      // Check Current Detect Mode
                      if(ScalerGetBit(PB9_B0_DP_AUD_CTRL, _BIT6) != 0x00)
                      {
                          // Disable Audio HBR Mode Detect
                          ScalerAudioD1HbrModeControl(_OFF);
              
                          // Wait for New Audio Packet Recived via detect interval + 1ms
                          ScalerTimerDelayXms((ScalerGetBit(PB9_50_AUD_FREQUENY_DET_0, (_BIT3 | _BIT2)) >> 2) + 1);
              
                          DebugMessageAudio("Dp D1 HBR Mode Detect Disable", _DISABLE);
                      }
                  }
              #endif
              }
              
              //--------------------------------------------------
              // Description  : D1 Audio HBR Mode Control
              // Input Value  : _ENABLE or _DISABLE
              // Output Value : None
              //--------------------------------------------------
              void ScalerAudioD1HbrModeControl(bit bEnable)
              {
              #if(_D1_HDMI_SUPPORT == _ON)
                  bEnable = bEnable;
              #elif(_D1_DP_EXIST == _ON)
                  if(bEnable == _ENABLE)
                  {
                      // Enable Dp Audio HBR Mode Detect via Channel Coding Type
                      ScalerSetBit(PB9_B0_DP_AUD_CTRL, ~_BIT6, _BIT6);
                  }
                  else
                  {
                      // Disable Audio HBR Mode Detect
                      ScalerSetBit(PB9_B0_DP_AUD_CTRL, ~_BIT6, 0x00);
                  }
              #endif
              }
              
              #if(_D1_HDMI_SUPPORT == _ON)
              //--------------------------------------------------
              // Description  : D1SPDIF/IIS Output Select
              // Input Value  : bOn
              // Output Value : None
              //--------------------------------------------------
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 36  

              void ScalerAudioD1I2sSpdifChannelOutputSelect(EnumAudioIisSpdifOutput enumAudioIisSpdifOutput)
              {
                  BYTE ucSelect = ScalerAudioChannelOutputSel(GET_HDMI_AUDIO_D1_CHANNEL_ALLOCATION());
              
                  if(enumAudioIisSpdifOutput == _AUDIO_SELECT_BY_CA_MODE)
                  {
                      // SPDIF/I2S 4 lane Output Select By Audio Channel Allocation
                      ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_62_PORT_PAGE71_HDMI_AOCR, ((ucSelect << 4) | ucSe
             -lect));
                  }
                  else
                  {
                      // Enable SPDIF/I2S 4 lane Output
                      ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_62_PORT_PAGE71_HDMI_AOCR, 0xFF);
                  }
              }
              #endif
              
              #if(_HDMI_AUDIO_FW_TRACKING_MODE_SUPPORT == _ON)
              //--------------------------------------------------
              // Description  : D1 HDMI FW tracking Handler
              // Input Value  : None
              // Output Value : None
              //--------------------------------------------------
              void ScalerAudioD1FwTrackingHandler(void)
              {
                  switch(GET_AUDIO_D1_FW_TRACKING_STATE())
                  {
                      case _AUDIO_FW_TRACKING_INITIAL:
              
                          if(GET_D1_DIGITAL_AUDIO_SOURCE() != _DIGITAL_AUDIO_SOURCE_NONE)
                          {
                              SET_AUDIO_D1_FW_TRACKING_STATE(_AUDIO_FW_TRACKING_PROCESS_PREPARING);
              
                              // Initialize Audio Tracking By FW Control
                              ScalerAudioD1FwTrackingInitial();
              
                              SET_AUDIO_D1_FW_TRACKING_EVENT();
              
                              CLR_AUDIO_D1_FW_TRACKING_RESET();
              
                              DebugMessageAudio("D1 Audio: FW Tracking Start", 0);
                          }
              
                          break;
              
                      case _AUDIO_FW_TRACKING_PROCESS_PREPARING:
              
                          if(GET_AUDIO_D1_FW_TRACKING_EVENT() == _TRUE)
                          {
                              CLR_AUDIO_D1_FW_TRACKING_EVENT();
              
                              // Find stable SUMC or already 4s --> boundary tracking
                              if((g_stHDMID1AudioFwTrackingInfo.b1AudioFwTrackStable != 0x00) || (GET_AUDIO_D1_FW_TRACKI
             -NG_TIMEOUT() == _TRUE))
                              {
                                  if(g_stHDMID1AudioFwTrackingInfo.b1AudioFwTrackStable != 0x00)
                                  {
                                      g_stHDMID1AudioFwTrackingInfo.b1AudioFwTrackStable = 0x00;
              
                                      DebugMessageAudio("D1 Audio: SUMC Stable", g_stHDMID1AudioFwTrackingInfo.b1AudioFw
             -TrackStable);
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 37  

                                  }
                                  else
                                  {
                                      DebugMessageAudio("D1 Audio: SUMC Final", 0);
                                  }
              
                                  SET_AUDIO_D1_FW_TRACKING_STATE(_AUDIO_FW_TRACKING_PROCESS_PLAYBACK);
              
                                  CLR_AUDIO_D1_FW_TRACKING_TIMEOUT();
                                  ScalerTimerCancelTimerEvent(_SCALER_TIMER_EVENT_AUDIO_D1_FW_TRACKING_TIMEOUT);
                              }
                              else
                              {
                                  // FW tracking - preparing tracking
                                  ScalerAudioD1FwPreparingTracking();
                              }
              
                              ScalerTimerActiveTimerEvent(ScalerAudioD1FwTrackingTimerEventPeriod(), _SCALER_TIMER_EVENT
             -_AUDIO_D1_FW_TRACKING_PREPARING);
                          }
              
                          break;
              
                      case _AUDIO_FW_TRACKING_PROCESS_PLAYBACK:
              
                          if(GET_AUDIO_D1_FW_TRACKING_EVENT() == _TRUE)
                          {
                              CLR_AUDIO_D1_FW_TRACKING_EVENT();
              
                              // FW tracking - boundary tracking
                              ScalerAudioD1FwBoundaryTracking();
              
                              ScalerTimerActiveTimerEvent(ScalerAudioD1FwTrackingTimerEventPeriod(), _SCALER_TIMER_EVENT
             -_AUDIO_D1_FW_TRACKING_PREPARING);
                          }
              
                          break;
              
                      default:
                          break;
                  }
              }
              
              //--------------------------------------------------
              // Description  : D1 HDMI FW tracking Initial
              // Input Value  : None
              // Output Value : None
              //--------------------------------------------------
              void ScalerAudioD1FwTrackingInitial(void)
              {
                  g_stHDMID1AudioFwTrackingInfo.b1AudioFwTrackStable = 0x00;
                  g_stHDMID1AudioFwTrackingInfo.ucAfifoTrackStableCnt = 0x00;
                  g_stHDMID1AudioFwTrackingInfo.ucAudioFreqRecord = ScalerGetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_8B_P
             -ORT_PAGE71_AUDIO_FREQ_RESULT, (_BIT3 | _BIT2 | _BIT1 | _BIT0));
              
                  // Set I code of trend
                  ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_20_PORT_PAGE71_HDMI_ICTPSR0, 0x00);
                  ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_21_PORT_PAGE71_HDMI_ICTPSR1, 0x00);
              
                  // Set P code of trend
                  ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_22_PORT_PAGE71_HDMI_PCTPSR0, 0x00);
                  ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_23_PORT_PAGE71_HDMI_PCTPSR1, 0x00);
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 38  

              
                  // Set I code of boundary
                  ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_24_PORT_PAGE71_HDMI_ICBPSR0, 0x00);
                  ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_25_PORT_PAGE71_HDMI_ICBPSR1, 0x00);
              
                  // Set P code of boundary
                  ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_26_PORT_PAGE71_HDMI_PCBPSR0, 0x00);
                  ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_27_PORT_PAGE71_HDMI_PCBPSR1, 0x00);
              
                  // Disable Auto Load S/D Code
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_8A_PORT_PAGE71_AUDIO_FREQDET, ~_BIT6, 0x00);
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_10_PORT_PAGE71_HDMI_CMCR, ~_BIT4, _BIT4);
              
                  // Initialize D Code for FW Audio Tracking
                  ScalerAudioD1DcodeSettingInitial();
              
                  CLR_AUDIO_D1_FW_TRACKING_TIMEOUT();
              
                  // When the stable N.F Code is not found within 4 seconds, tracking state force to playback for play a
             -udio
                  ScalerTimerReactiveTimerEvent(SEC(4), _SCALER_TIMER_EVENT_AUDIO_D1_FW_TRACKING_TIMEOUT);
              }
              
              //--------------------------------------------------
              // Description  : Initial D code setting by fs
              // Input Value  : None
              // Output Value : None
              //--------------------------------------------------
              void ScalerAudioD1DcodeSettingInitial(void)
              {
                  if(GET_AUDIO_D1_SAMPLING_FREQ() == _AUDIO_FREQ_32K)
                  {
                      // Set S code for 32kHz
                      ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_12_PORT_PAGE71_HDMI_SCAPR, _HDMI_SAMPLING_FREQ_32
             -K_GROUP_S_CODE);
