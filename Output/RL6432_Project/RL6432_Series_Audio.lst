                              SET_AUDIO_D1_ICODE_RELOADED();
                          }
                      }
                  }
                  else
                  {
              #if(_D1_HDMI_SUPPORT == _ON)
                      if(ScalerGetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_15_PORT_PAGE71_HDMI_PSCR, (_BIT3 | _BIT2)) != 0
             -x00)
                      {
