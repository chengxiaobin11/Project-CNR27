3298          //--------------------------------------------------
3299          // Description  : Initial D0 Auido PLL Settings
3300          // Input Value  : None
3301          // Output Value : None
3302          //--------------------------------------------------
3303          void ScalerAudioD0SetAudioPLL(void)
3304          {
3305   1          // DPLL power down
3306   1          ScalerSetBit(PB6_D3_MN_SCLKG_PLL_PWR, ~_BIT7, _BIT7);
3307   1      
3308   1          // Set M code
3309   1          ScalerSetByte(PB6_D1_MN_SCLKG_DIVM, (_AUDIO_PLL_M - 2));
3310   1      
3311   1          // Set O code
3312   1          ScalerSetBit(PB6_D3_MN_SCLKG_PLL_PWR, ~(_BIT1 | _BIT0), 0x00);
3313   1      
3314   1          // Set N(K) code and enable double buffer
3315   1          ScalerSetByte(PB6_D2_MN_SCLKG_DIVN, (_AUDIO_PLL_K - 2));
3316   1      
3317   1          // Initial VCO Band = 10
3318   1          ScalerSetBit(PB6_D5_MN_SCLKG_PLL_WD, ~(_BIT4 | _BIT3), _BIT4);
3319   1      
3320   1          // Set MN PLL Path1 => [2]: 1 = Path1, 0 = Path2
3321   1          ScalerSetBit(PB6_D5_MN_SCLKG_PLL_WD, ~(_BIT7 | _BIT2), _BIT2);
3322   1      
3323   1          // DPLL VCORSTB Set to Normal
3324   1          ScalerSetBit(PB6_D6_MN_SCLKG_PLL_INSEL, ~_BIT0, _DPLL_VCORSTB_NORMAL_VALUE);
3325   1      
3326   1          // DPLL power up
3327   1          ScalerSetBit(PB6_D3_MN_SCLKG_PLL_PWR, ~_BIT7, 0x00);
3328   1      
3329   1          // Delay 2000us
3330   1          ScalerTimerDelayXms(2);
3331   1      
3332   1          // DPLL CMP enable
3333   1          ScalerSetBit(PB6_D3_MN_SCLKG_PLL_PWR, ~_BIT2, _BIT2);
3334   1      
3335   1          // Delay at least 1000us
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 57  

3336   1          ScalerTimerDelayXms(2);
3337   1      
3338   1          // DPLL latch calibration enable
3339   1          ScalerSetBit(PB6_D3_MN_SCLKG_PLL_PWR, ~_BIT3, _BIT3);
3340   1      
3341   1          // Delay at least 1000us
3342   1          ScalerTimerDelayXms(2);
3343   1      
3344   1          // DPLL calibration validated
3345   1          ScalerSetBit(PB6_D3_MN_SCLKG_PLL_PWR, ~_BIT4, _BIT4);
3346   1      }
