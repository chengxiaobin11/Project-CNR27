              //--------------------------------------------------
              // Description  : Initial 2 Auido PLL Settings
              // Input Value  : None
              // Output Value : None
              //--------------------------------------------------
              void ScalerAudioD2SetAudioPLL(void)
              {
                  // DPLL power down
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_38_PORT_PAGE71_HDMI_DPCR0, ~_BIT7, _BIT7);
              
                  // Set M code
                  ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_11_PORT_PAGE71_HDMI_MCAPR, (_AUDIO_PLL_M - 2));
              
                  // Set O code
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_38_PORT_PAGE71_HDMI_DPCR0, ~(_BIT5 | _BIT4), 0x00);
              
                  // Set K code and enable double buffer
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_10_PORT_PAGE71_HDMI_CMCR, ~(_BIT4 | _BIT3 | _BIT2 | _B
             -IT1 | _BIT0), (_BIT4 | ((_AUDIO_PLL_K - 2) & 0x0F)));
              
                  // Initial VCO Band = 10
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_3A_PORT_PAGE71_HDMI_DPCR2, ~(_BIT4 | _BIT3), _BIT4);
              
                  // Set MN PLL Path1 => [2]: 1 = Path1, 0 = Path2
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_3A_PORT_PAGE71_HDMI_DPCR2, ~(_BIT7 | _BIT2), _BIT2);
              
                  // DPLL VCORSTB Set to Normal
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_3B_PORT_PAGE71_HDMI_DPCR3, ~_BIT0, _DPLL_VCORSTB_NORMA
             -L_VALUE);
              
                  // DPLL power up
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_38_PORT_PAGE71_HDMI_DPCR0, ~_BIT7, 0x00);
              
                  // Delay 2000us
                  ScalerTimerDelayXms(2);
              
                  // DPLL CMP enable
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_38_PORT_PAGE71_HDMI_DPCR0, ~_BIT0, _BIT0);
              
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 49  

                  // Delay 1000us
                  ScalerTimerDelayXms(2);
              
                  // DPLL latch calibration enable
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_38_PORT_PAGE71_HDMI_DPCR0, ~_BIT1, _BIT1);
              
                  // Delay 1000us
                  ScalerTimerDelayXms(2);
              
                  // DPLL calibration validated
                  ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_38_PORT_PAGE71_HDMI_DPCR0, ~_BIT2, _BIT2);
              }
              #endif // End of #if((_D1_HDMI_SUPPORT == _ON) || (_D2_HDMI_SUPPORT == _ON))
2861          
2862          #if(_HDMI_SUPPORT == _ON)
2863          #if(_D1_HDMI_SUPPORT == _ON)
              #if(_AUDIO_MANUAL_SAMPLING_FREQ_SUPPORT == _OFF)
              //--------------------------------------------------
              // Description  : D1 Audio Frequency Mode Setting
              // Input Value  : _AUDIO_TRACKING_AUTO_LOAD_MODE / _AUDIO_TRACKING_MANNUAL_MODE
              // Output Value : None
              //--------------------------------------------------
              void ScalerAudioD1AudioFrequencyMode(EnumAudioFreqTrackingMode enumAudioFreqTrackingMode)
              {
                  if(enumAudioFreqTrackingMode == _AUDIO_TRACKING_AUTO_LOAD_MODE)
                  {
                      // Set S code for auto load mode
                      ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_95_PORT_PAGE71_PRESET_S_CODE0, _HDMI_SAMPLING_FRE
             -Q_32K_GROUP_S_CODE);
              
                      // Set D code for auto load mode
                      ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_99_PORT_PAGE71_PRESET_D_CODE_0, HIBYTE(_HDMI_SAMP
             -LING_FREQ_32K_GROUP_D_CODE));
                      ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_9A_PORT_PAGE71_PRESET_D_CODE_1, LOBYTE(_HDMI_SAMP
             -LING_FREQ_32K_GROUP_D_CODE));
              
                      // Enable Auto Load S Code and D Code
                      ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_8A_PORT_PAGE71_AUDIO_FREQDET, ~_BIT6, _BIT6);
              
                      // Set Double Buffer bit
                      ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_10_PORT_PAGE71_HDMI_CMCR, ~_BIT4, _BIT4);
                  }
                  else
                  {
                      // Disable Auto Load S Code
                      ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_8A_PORT_PAGE71_AUDIO_FREQDET, ~_BIT6, 0x00);
              
                      // Set S code User Define
                      ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_12_PORT_PAGE71_HDMI_SCAPR, ScalerAudioGetUserSamp
             -lingFreqSCode(_PORT_HDMI, GET_D1_SAMPLING_FREQ_USER_DEFINE()));
              
                      // Set D code User Define
                      ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_13_PORT_PAGE71_HDMI_DCAPR0, HIBYTE(ScalerAudioGet
             -UserSamplingFreqDCode(_PORT_HDMI, GET_D1_SAMPLING_FREQ_USER_DEFINE())));
                      ScalerSetDataPortByte(P71_C9_HDMI_AP, _P71_CA_PT_14_PORT_PAGE71_HDMI_DCAPR1, LOBYTE(ScalerAudioGet
             -UserSamplingFreqDCode(_PORT_HDMI, GET_D1_SAMPLING_FREQ_USER_DEFINE())));
              
                      // Set Double Buffer bit
                      ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_10_PORT_PAGE71_HDMI_CMCR, ~_BIT4, _BIT4);
              
                      // Load D code
                      ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_31_PORT_PAGE71_HDMI_WDCR0, ~_BIT6, _BIT6);
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 50  

                      ScalerSetDataPortBit(P71_C9_HDMI_AP, _P71_CA_PT_31_PORT_PAGE71_HDMI_WDCR0, ~_BIT6, 0x00);
                  }
              }
              #endif
              #endif
