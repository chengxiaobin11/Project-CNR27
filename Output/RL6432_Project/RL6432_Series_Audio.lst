              #endif
              
                      case _D1_INPUT_PORT:
              
              #if(_D1_DP_EXIST == _ON)
                          return ScalerAudioDpGetInternalAudioGenEnable();
              #elif(_D1_HDMI_SUPPORT == _ON)
                          return ScalerAudioD2GetInternalAudioGenEnable();
              #endif
              
                      case _D2_INPUT_PORT:
              
              #if(_D2_HDMI_SUPPORT == _ON)
