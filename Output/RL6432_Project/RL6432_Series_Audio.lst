3740          // Output Value : None
3741          //--------------------------------------------------
3742          void ScalerAudioD0HbrAudioDetect(void)
3743          {
3744   1          // Check HBR Audio Receive
3745   1          if(ScalerGetBit(PB6_B0_DP_AUD_CTRL, (_BIT3 | _BIT2 | _BIT1 | _BIT0)) == _BIT0)
3746   1          {
3747   2              // Check Current Detect Mode
3748   2              if(ScalerGetBit(PB6_B0_DP_AUD_CTRL, _BIT6) != _BIT6)
3749   2              {
3750   3                  // Enable Audio HBR Mode Detect
3751   3                  ScalerAudioD0HbrModeControl(_ON);
3752   3      
3753   3                  // Wait for New Audio Packet Recived via detect interval + 1ms
3754   3                  ScalerTimerDelayXms((ScalerGetBit(PB6_50_AUD_FREQUENY_DET_0, (_BIT3 | _BIT2)) >> 2) + 1);
3755   3      
3756   3                  DebugMessageAudio("Dp D0 HBR Mode Detect Enable", _ENABLE);
3757   3              }
3758   2          }
3759   1          else
3760   1          {
3761   2              // Check Current Detect Mode
C51 COMPILER V9.60.0.0   RL6432_SERIES_AUDIO                                               09/20/2026 19:44:03 PAGE 64  

3762   2              if(ScalerGetBit(PB6_B0_DP_AUD_CTRL, _BIT6) != 0x00)
3763   2              {
3764   3                  // Disable Audio HBR Mode Detect
3765   3                  ScalerAudioD0HbrModeControl(_OFF);
3766   3      
3767   3                  // Wait for New Audio Packet Recived via detect interval + 1ms
3768   3                  ScalerTimerDelayXms((ScalerGetBit(PB6_50_AUD_FREQUENY_DET_0, (_BIT3 | _BIT2)) >> 2) + 1);
3769   3      
3770   3                  DebugMessageAudio("Dp D0 HBR Mode Detect Disable", _DISABLE);
3771   3              }
3772   2          }
3773   1      }
