 295          void ScalerDpRx0TrainingPatternEnd_EXINT0(void) using 1
 296          {
 297   1          switch(g_ucDpRx0LaneCount)
 298   1          {
 299   2              case _DP_ONE_LANE:
 300   2                  ScalerSetBit_EXINT(PB_01_PHY_DIG_RESET_CTRL, ~(_BIT4 | _BIT3), _BIT3);
 301   2      
 302   2                  // Clear Lane1/2/3 Link status
 303   2                  ScalerDpRx0SetDpcdBitValue_EXINT0(0x00, 0x02, 0x02, ~(_BIT6 | _BIT5 | _BIT4), 0x00);
 304   2                  ScalerDpRx0SetDpcdBitValue_EXINT0(0x00, 0x02, 0x03, ~(_BIT6 | _BIT5 | _BIT4 | _BIT2 | _BIT1 | 
             -_BIT0), 0x00);
 305   2      
 306   2                  break;
 307   2      
 308   2              case _DP_TWO_LANE:
 309   2                  ScalerSetBit_EXINT(PB_01_PHY_DIG_RESET_CTRL, ~(_BIT4 | _BIT3), _BIT4);
 310   2      
 311   2                  // Clear Lane2/3 Link status
 312   2                  ScalerDpRx0SetDpcdBitValue_EXINT0(0x00, 0x02, 0x03, ~(_BIT6 | _BIT5 | _BIT4 | _BIT2 | _BIT1 | 
             -_BIT0), 0x00);
 313   2      
 314   2                  break;
 315   2      
 316   2              case _DP_FOUR_LANE:
 317   2              default:
 318   2                  ScalerSetBit_EXINT(PB_01_PHY_DIG_RESET_CTRL, ~(_BIT4 | _BIT3), (_BIT4 | _BIT3));
 319   2                  break;
 320   2          }
 321   1      
 322   1          // De-Skew Circuit Reset
 323   1          ScalerSetBit_EXINT(PB_0E_DESKEW_PHY, ~(_BIT7 | _BIT6), 0x00);
 324   1          ScalerSetBit_EXINT(PB_0E_DESKEW_PHY, ~(_BIT7 | _BIT6), _BIT6);
 325   1      
 326   1          if((ScalerDpRx0GetDpcdInfo_EXINT0(0x00, 0x01, 0x01) & _BIT7) == _BIT7)
 327   1          {
 328   2              // Enable Enhancement Control Mode --> MAC
 329   2              ScalerSetBit_EXINT(PB_01_PHY_DIG_RESET_CTRL, ~_BIT2, _BIT2);
 330   2          }
 331   1          else
 332   1          {
 333   2              // Disable Enhancement Control Mode --> MAC
 334   2              ScalerSetBit_EXINT(PB_01_PHY_DIG_RESET_CTRL, ~_BIT2, 0x00);
 335   2          }
 336   1      
 337   1          if((ScalerDpRx0GetDpcdInfo_EXINT0(0x00, 0x01, 0x02) & _BIT5) == _BIT5)
 338   1          {
 339   2              // Disable Scrambling
 340   2              ScalerSetBit_EXINT(PB_07_SCRAMBLE_CTRL, ~_BIT5, _BIT5);
 341   2          }
 342   1          else
 343   1          {
 344   2              // Enable Scrambling
