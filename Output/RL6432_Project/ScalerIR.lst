 154          //--------------------------------------------------
 155          // Description  : IR interrupt Handler
 156          // Input Value  : None
 157          // Output Value : None
 158          //--------------------------------------------------
 159          void ScalerIRHWModeIntHandler_EXINT0(void) using 1
 160          {
 161   1          BYTE ucTemp = 0;
 162   1      
 163   1          if((ScalerGetBit_EXINT(P23_B2_IR_CR2, _BIT2) == _BIT2) && (ScalerGetBit_EXINT(P23_BB_IR_SR3, _BIT0) !=
             - 0x00))
 164   1          {
 165   2              // when detect repeat signal, repeat bit and data bit will all be setted
C51 COMPILER V9.60.0.0   SCALERIR                                                          09/21/2026 15:32:06 PAGE 4   

 166   2              if(ScalerGetBit_EXINT(P23_BB_IR_SR3, _BIT1) == _BIT1)
 167   2              {
 168   3                  SET_IR_NEC_STATUS(_NEC_IR_REPEAT);
 169   3              }
 170   2              else // when detect only data(address + cmd), only data bit will be setted
 171   2              {
 172   3                  SET_IR_NEC_STATUS(_NEC_IR_DATA);
 173   3              }
 174   2      
 175   2              ScalerSetBit_EXINT(P23_BB_IR_SR3, ~(_BIT6 | _BIT5 | _BIT4 | _BIT3 | _BIT2 | _BIT1 | _BIT0), (_BIT1
             - | _BIT0));
 176   2      
 177   2              if(ScalerGetBit_EXINT(P23_BB_IR_SR3, (_BIT6 | _BIT4)) != 0x00)
 178   2              {
 179   3                  // Read out unused code to avoid buffer pointer in disorder
 180   3                  ucTemp = ScalerGetByte_EXINT(P23_B4_IR_RP0);
 181   3                  ucTemp += ScalerGetByte_EXINT(P23_B5_IR_RP1);
 182   3                  ucTemp += ScalerGetByte_EXINT(P23_B6_IR_RP2);
 183   3                  ucTemp += ScalerGetByte_EXINT(P23_B7_IR_RP3);
 184   3                  ucTemp += ScalerGetByte_EXINT(P23_DC_IR_RP2_0);
 185   3                  ucTemp += ScalerGetByte_EXINT(P23_DD_IR_RP2_1);
 186   3                  ucTemp += ScalerGetByte_EXINT(P23_DE_IR_RP2_2);
 187   3                  ucTemp += ScalerGetByte_EXINT(P23_DF_IR_RP2_3);
 188   3      
 189   3                  // Reset IR
 190   3                  ScalerSetBit_EXINT(P23_B0_IR_CR0, ~(_BIT7), _BIT7);
 191   3      
 192   3                  CLR_IR_HW_RECEIVED();
 193   3              }
 194   2              else
 195   2              {
 196   3                  // Get code
 197   3                  g_pucIRCode[0] = ScalerGetByte_EXINT(P23_B4_IR_RP0);
 198   3                  g_pucIRCode[1] = ScalerGetByte_EXINT(P23_B5_IR_RP1);
 199   3                  g_pucIRCode[2] = ScalerGetByte_EXINT(P23_B6_IR_RP2);
 200   3                  g_pucIRCode[3] = ScalerGetByte_EXINT(P23_B7_IR_RP3);
 201   3                  g_pucIRCode[4] = ScalerGetByte_EXINT(P23_DC_IR_RP2_0);
 202   3                  g_pucIRCode[5] = ScalerGetByte_EXINT(P23_DD_IR_RP2_1);
 203   3                  g_pucIRCode[6] = ScalerGetByte_EXINT(P23_DE_IR_RP2_2);
 204   3                  g_pucIRCode[7] = ScalerGetByte_EXINT(P23_DF_IR_RP2_3);
 205   3      
 206   3                  // Clear flag
 207   3                  ScalerSetByte_EXINT(P23_BB_IR_SR3, 0x7F);
 208   3      
 209   3                  SET_IR_HW_RECEIVED();
 210   3              }
 211   2          }
 212   1      }
