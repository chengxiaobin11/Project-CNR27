  74          //--------------------------------------------------
  75          // Description  : IRDA Initial Settings
  76          // Input Value  : None
  77          // Output Value : None
  78          //--------------------------------------------------
  79          void ScalerIRHWModeInitial(void)
  80          {
  81   1          // Sample clock divider
  82   1          ScalerSetByte(P23_AA_IR_SF2, HIBYTE(_IR_HW_XTAL_SAMPLE_CLK_DIV));
  83   1          ScalerSetByte(P23_AB_IR_SF3, LOBYTE(_IR_HW_XTAL_SAMPLE_CLK_DIV));
  84   1      
  85   1      
  86   1          // Clear interrupt flag
  87   1          ScalerSetBit(P23_BB_IR_SR3, ~(_BIT6 | _BIT5 | _BIT4 | _BIT3 | _BIT2 | _BIT1 | _BIT0), (_BIT6 | _BIT5 |
             - _BIT4 | _BIT3 | _BIT2 | _BIT1 | _BIT0));
  88   1      
  89   1          // Enable HW interrupt
  90   1          ScalerSetBit(P23_B2_IR_CR2, ~_BIT2, _BIT2);
  91   1      
  92   1          // _BIT0: Enable IR
  93   1          ScalerSetBit(P23_B2_IR_CR2, ~_BIT0, _BIT0);
  94   1      }
