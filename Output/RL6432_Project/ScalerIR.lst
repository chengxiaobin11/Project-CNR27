 117          // Description  : Read the IR raw data in fifo
 118          // Input Value  : None
 119          // Output Value : Data ready or not
 120          //--------------------------------------------------
 121          bit ScalerIRHWModeGetData(BYTE *pucBuffer)
 122          {
 123   1          // Wait IR Reset
 124   1          ScalerTimerPollingFlagProc(100, P23_B0_IR_CR0, _BIT7, _FALSE);
 125   1      
 126   1          if(GET_IR_HW_RECEIVED() == _TRUE)
 127   1          {
 128   2              pucBuffer[0] = g_pucIRCode[0];
 129   2              pucBuffer[1] = g_pucIRCode[1];
 130   2              pucBuffer[2] = g_pucIRCode[2];
 131   2              pucBuffer[3] = g_pucIRCode[3];
 132   2              pucBuffer[4] = g_pucIRCode[4];
 133   2              pucBuffer[5] = g_pucIRCode[5];
 134   2              pucBuffer[6] = g_pucIRCode[6];
 135   2              pucBuffer[7] = g_pucIRCode[7];
 136   2      
 137   2              CLR_IR_HW_RECEIVED();
 138   2      
 139   2      #if(_DEBUG_MESSAGE_IR == _ON)
                      DebugMessageIR("IR0", g_pucIRCode[0]);
                      DebugMessageIR("IR1", g_pucIRCode[1]);
                      DebugMessageIR("IR2", g_pucIRCode[2]);
                      DebugMessageIR("IR3", g_pucIRCode[3]);
              #endif // End of #if(_DEBUG_MESSAGE_IR == _ON)
 145   2      
 146   2              return _TRUE;
 147   2          }
 148   1          else
 149   1          {
 150   2              return _FALSE;
 151   2          }
 152   1      }
