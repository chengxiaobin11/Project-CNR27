 140          void ScalerODSetMemoryStartAddress(void)
 141          {
 142   1          // Calculate OD memory use space, unit:row
 143   1          PDATA_WORD(0) = ((((DWORD)CEILING(_PANEL_DH_WIDTH, _OD_PIXEL_PER_COMP)) * _PANEL_DV_HEIGHT * GET_OD_US
             -E_BIT() / _MEMORY_BIT_NUM) /
 144   1                           (_MEMORY_COL_PER_BANK * _MEMORY_BANK) / 10 + 1);
 145   1      
 146   1          // Set Memory Start Address
 147   1          PDATA_WORD(0) = ((DWORD)_MEMORY_ROW - PDATA_WORD(0)) << 2;
 148   1      
 149   1          ScalerSetByte(P3_DB_LS_DDR_START_ADDR_H, pData[0]);
 150   1          ScalerSetByte(P3_DC_LS_DDR_START_ADDR_M, pData[1]);
 151   1          ScalerSetByte(P3_DD_LS_DDR_START_ADDR_L, 0x00);
 152   1      }
