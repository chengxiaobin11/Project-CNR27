  52          //--------------------------------------------------
  53          // Description  : OD on/off
  54          // Input Value  : enumOn --> _FUNCTION_ON/_FUNCTION_OFF
  55          // Output Value : None
  56          //--------------------------------------------------
  57          void ScalerODEnable(EnumFunctionOnOFF enumOn)
  58          {
  59   1          //=================
  60   1          // Enable OD
  61   1          //=================
  62   1          if((enumOn == _FUNCTION_ON) && (GET_OD_USE_BIT() != _OFF))
  63   1          {
  64   2              // Enable OD clock
  65   2              ScalerSetBit(P1_DC_DCLK_GATED_CTRL2, ~_BIT2, _BIT2);
  66   2      
  67   2      #if(_FRC_SUPPORT == _ON)
  68   2              DebugMessageFRC("OD_ON", 0);
  69   2      
  70   2      #if(_MEMORY_TYPE_CONFIG == _MEMORY_DDR1)
  71   2              ScalerTimerWaitForEvent(_EVENT_DEN_STOP);
  72   2              ScalerDDR1SetFRCDisplayTokenRing(enumOn);
  73   2      #endif
  74   2              if(GET_DYNAMIC_OD_STATUS() == _ENABLE)
  75   2              {
  76   3                  DebugMessageFRC("Dynamic OD", GET_MEMORY_DVF_SELECT());
  77   3      
  78   3                  // Enable DEN_START IRQ
  79   3                  SET_OD_CURR_DYNAMIC_STATUS(_ENABLE);
  80   3                  ScalerGlobalSetInterrupt(_IRQ_DEN_START, _ENABLE);
  81   3              }
  82   2              else
  83   2              {
  84   3                  DebugMessageFRC("Static OD", 0);
  85   3      
  86   3                  // Enable OD function, disable DEN_START IRQ
  87   3                  SET_OD_CURR_DYNAMIC_STATUS(_DISABLE);
  88   3                  ScalerGlobalSetInterrupt(_IRQ_DEN_START, _DISABLE);
  89   3                  ScalerSetBit(P3_A1_LS_CTRL0, ~(_BIT7 | _BIT6), (_BIT7 | _BIT6));
  90   3              }
  91   2      #else
                      // Enable OD function
                      ScalerSetBit(P3_A1_LS_CTRL0, ~(_BIT7 | _BIT6), (_BIT7 | _BIT6));
              #endif
  95   2          }
  96   1          //=================
  97   1          // Disable OD
  98   1          //=================
  99   1          else
 100   1          {
 101   2              // Enable OD clock
 102   2              ScalerSetBit(P1_DC_DCLK_GATED_CTRL2, ~_BIT2, _BIT2);
 103   2      
 104   2      #if(_FRC_SUPPORT == _ON)
 105   2              DebugMessageFRC("OD_OFF", 0);
 106   2      
 107   2              SET_OD_CURR_DYNAMIC_STATUS(_DISABLE);
 108   2              ScalerGlobalSetInterrupt(_IRQ_DEN_START, _DISABLE);
 109   2      #endif
