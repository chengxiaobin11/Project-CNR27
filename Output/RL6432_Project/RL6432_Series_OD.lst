 112   2      
 113   2      #if(_MEMORY_TYPE_CONFIG == _MEMORY_DDR1)
 114   2      #if(_FRC_SUPPORT == _ON)
 115   2              ScalerTimerWaitForEvent(_EVENT_DVS);
 116   2      
