 505          // Description  : Audio Mute Process
 506          // Input Value  : _ON => Mute On
 507          // Output Value : None
 508          //--------------------------------------------------
 509          void SysAudioMuteProc(bit bMute)
 510          {
 511   1          if(bMute == _ON)
 512   1          {
 513   2              if(ScalerAudioDVCGetVolumeMuteStatus() == _OFF)
 514   2              {
 515   3                  // Ext. Audio Amplifier Mute
 516   3                  UserInterfaceAdjustAudioAmpMuteProc(_ON);
