 436          void SysAudioPowerProc(EnumPowerAction enumSwitch)
 437          {
 438   1          switch(enumSwitch)
 439   1          {
 440   2              case _POWER_ACTION_AC_ON_TO_NORMAL:
 441   2              case _POWER_ACTION_OFF_TO_NORMAL:
 442   2              case _POWER_ACTION_PS_TO_NORMAL:
 443   2      
 444   2                  // Update User Define Frequency When No Audio
 445   2                  SysAudioSetUserDefineAudioFrequency();
 446   2      
 447   2                  SysAudioInitial();
 448   2      
 449   2                  // Add User interface function
 450   2                  UserInterfaceAdjustAudioPowerProc(_POWER_STATUS_NORMAL);
 451   2      
 452   2      #if((_LINE_IN_SUPPORT == _ON) && (_HW_AUDIO_LINE_IN_TO_DIGITAL_LR_SWAP == _ON))
                          UserInterfaceSwapExternalAudioCodecInput(ScalerAudioGetI2sOutputNeedToSwap(UserInterfaceGetAud
             -ioSource()));
              #endif
 455   2                  SysAudioChangeAudioState(_AUDIO_STATUS_PREPARING);
 456   2      
 457   2                  break;
 458   2      
 459   2              case _POWER_ACTION_AC_ON_TO_OFF:
 460   2              case _POWER_ACTION_PS_TO_OFF:
 461   2              case _POWER_ACTION_NORMAL_TO_OFF:
 462   2              case _POWER_ACTION_NORMAL_TO_FAKE_OFF:
 463   2      
 464   2                  // Normal Control DVC & Ext.Amp & Ext. DSP
 465   2                  SysAudioOutputProc(_DISABLE);
 466   2      
 467   2                  // Reset Digital Audio
 468   2                  ScalerAudioDigitalReset(ScalerAudioGetDigitalAudioPortMapping());
 469   2      
 470   2                  // Add User interface function
 471   2                  UserInterfaceAdjustAudioPowerProc(_POWER_STATUS_OFF);
 472   2      
 473   2                  // Disable Audio
 474   2                  ScalerAudioDisable();
C51 COMPILER V9.60.0.0   SYSAUDIO                                                          09/21/2026 15:31:47 PAGE 9   

 475   2      
 476   2                  SysAudioChangeAudioState(_AUDIO_STATUS_POWER_OFF);
 477   2      
 478   2                  break;
 479   2      
 480   2              case _POWER_ACTION_NORMAL_TO_PS:
 481   2      
 482   2                  // Normal Control DVC & Ext.Amp & Ext. DSP
 483   2                  SysAudioOutputProc(_DISABLE);
 484   2      
 485   2                  // Reset Digital Audio
 486   2                  ScalerAudioDigitalReset(ScalerAudioGetDigitalAudioPortMapping());
 487   2      
