 539   2          }
 540   1          else
 541   1          {
 542   2              bit bResult = _FALSE;
 543   2      
 544   2      #if(_AUDIO_OSD_MUTE_SEPARATE_CONTROL_SUPPORT == _ON)
                      bResult |= ((ScalerAudioDVCGetVolumeMuteStatus() == _ON) && (UserInterfaceGetAudioMuteStatus() == 
