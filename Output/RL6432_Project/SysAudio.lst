             -PORT == _ON))
                          if(UserCommonAudioGetAdjustVolumeThroughDVC() == _FALSE)
                          {
              #if((_DIGITAL_AUDIO_I2S_OUTPUT_L_R_CHANNEL_SWAP_SUPPORT == _ON) && (_DIGITAL_AUDIO_OUTPUT_ADJUST_VOLUME_SU
             -PPORT == _OFF) && (_EMBEDDED_DAC_SUPPORT == _OFF))
                              // Audio DVC Hold by Un-Mute
                              ScalerAudioDVCAdjustVolume(0x3FFF);
              #else
                              // Audio DVC Hold by Mute
                              ScalerAudioDVCAdjustVolume(0);
              #endif
                          }
                          else
              #endif
 531   3                  {
 532   4                      // Digital Audio Output DVC Mute
 533   4                      ScalerAudioMuteProc(_ON, UserInterfaceGetAudioVolume());
 534   4                  }
