                   15998     ;------------------------------------------------------------------------------
                   15999     ;  This file is part of the BL51 / LX51 Banked Linker/Locater package
                   16000     ;  Copyright (c) 1988 - 2001 Keil Elektronik GmbH and Keil Software, Inc.
                   16001     ;  Version 2.21 (Code and Variable Banking for Classic 8051 Derivatives)
                   16002     ;------------------------------------------------------------------------------
                   16003     ;************************ Configuration Section *******************************
                   16004     ; Define maximum Number of Banks                                              *
  0010             16005     ?B_NBANKS       EQU  0x10;                  *
                   16006     ;                         ; following values are allowed: 2, 4, 8, 16, 32, 64 *
                   16007     ;                         ; for BL51 the maximum value for ?B_BANKS is 32     *
                   16008     ;                         ; for LX51 the maximum value for ?B_BANKS is 64     *
                   16009     ;                                                                             *
  0001             16010     ?B_MODE         EQU  1    ; 0 for Bank-Switching via 8051 Port                *
                   16011     ;                         ; 1 for Bank-Switching via XDATA Port               *
                   16012     ;                         ; 4 for user-provided bank switch code              *
                   16013     ;                                                                             *
  0000             16014     ?B_RTX          EQU  0    ; 0 for applications without real-time OS           *
                   16015     ;                         ; 1 for applications using the RTX-51 real-time OS  *
                   16016     ;                                                                             *
  0000             16017     ?B_VAR_BANKING  EQU  0    ; Variable Banking via L51_BANK (far memory support)*
                   16018     ;                         ; 0 Variable Banking does not use L51_BANK.A51      *
                   16019     ;                         ; 1 Variable Banking uses this L51_BANK.A51 module  *
                   16020     ; Notes: ?B_VAR_BANKING uses the 'far' and 'far const' C51 memory types to    *
                   16021     ;        extent the space for variables in RAM and/or ROM of classic 8051     *
                   16022     ;        device.  The same hardware as for code banking is used.  Program     *
                   16023     ;        code banking and variable banking share the same hardware I/O pins.  *
                   16024     ;        The C51 Compiler must be used with the VARBANKING directive.         *
                   16025     ;        Variable Banking is only supported with the LX51 linker/locater.     *
                   16026     ;                                                                             *
  00FF             16027     ?B_RST_BANK     EQU  0xFF ; specifies the active code bank number after CPU   *
                   16028     ;                         ; Reset.  Used to reduce the entries in the         *
                   16029     ;                         ; INTERBANK CALL TABLE.  The value 0xFF disables    *
                   16030     ;                         ; this LX51 linker/locater optimization.            *
                   16031     ; Note:  Interbank Call Table optimization is only possible with LX51.        *
                   16032     ;                                                                             *
                   16033     ;-----------------------------------------------------------------------------*
                   16034     ;                                                                             *
                             ENDIF;                                                                        *
                   16047     ;                                                                             *
                   16048     IF  ?B_MODE = 1;                                                              *
A51 MACRO ASSEMBLER  L51_BANK                                                             09/20/2026 19:43:01 PAGE    68

                   16049     ;-----------------------------------------------------------------------------*
                   16050     ; if ?BANK?MODE is 1 define the following values                              *
                   16051     ; For Bank-Switching via XDATA Port define XDATA Port Address / Bits          *
  FFFF             16052     ?B_XDATAPORT    EQU     0FFFFH   ; default is XDATA Port Address 0FFFFH       *
  0000             16053     ?B_FIRSTBIT     EQU     0        ; default is Bit 0                           *
                   16054     ;-----------------------------------------------------------------------------*
                   16055     ENDIF;                                                                        *
                   16056     ;                                                                             *
