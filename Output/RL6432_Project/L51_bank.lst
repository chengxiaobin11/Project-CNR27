                   16140     ; -------------------                                                         *
                   16141     ; The section below describes the code generated by BL51 or LX51 and the      *
                   16142     ; operation of the L51_BANK.A51 module.  BL51/LX51 generates for each         *
                   16143     ; function that is located in a code memory bank and called from the common   *
                   16144     ; area or a different code bank and entry into the INTRABANK CALL TABLE.  The *
                   16145     ; INTRABANK CALL TABLE is located in the SEGMENT ?BANK?SELECT and listed in   *
                   16146     ; the Linker MAP file. The entries in that TABLE have the following format:   *
                   16147     ;                                                                             *
                   16148     ;   ?FCT?1:  MOV  DPTR,#FCT     ; Load Address of target FCT                  *
                   16149     ;            JMP  ?B_BANKn      ; Switch to Bank and Jump to Target Code      *
                   16150     ;                                                                             *
                   16151     ; Instead of directly calling the function FCT, the Linker changes the entry  *
                   16152     ; to ?FCT?1.  This entry selects the bank where the function FCT is located   *
                   16153     ; and calls that function via the routines defined in this L51_BANK.A51 file. *
                   16154     ; The L51_BANK.A51 file contains two sets of functions for each bank:         *
                   16155     ;                                                                             *
                   16156     ; ?B_BANKn    is a routine which saves the entry of the ?B_SWITCHn function   *
                   16157     ;             for the current active bank on the STACK and switches to the    *
                   16158     ;             bank 'n'.  Then it jumps to the address specified by the DPTR   *
                   16159     ;             register.  It is allowed to modify the following registers in   *
                   16160     ;             the ?B_BANKn routine:  A, B, R0, DPTR, PSW                      *
                   16161     ;                                                                             *
                   16162     ; ?B_SWITCHn  is a function which selects the bank 'n'.  This function is     *
                   16163     ;             used at the end of a user function to return to the calling     *
                   16164     ;             code bank.  Only the following registers may be altered in the  *
                   16165     ;             ?B_SWITCHn function:  R0, DPTR                                  *
                   16166     ;                                                                             *
                   16167     ; The current active bank is stored in ?B_CURRENTBANK.  RTX-51 uses this      *
                   16168     ; variable to restore the code bank after a task switch.  To get correct      *
                   16169     ; results, ?B_CURRENTBANK must be set to the code bank before the hardware    *
                   16170     ; switch is done, or the code banking sequences must be interrupt protected.  *
                   16171     ;******************************************************************************
                   16172     
                   16173                     NAME    ?BANK?SWITCHING
                   16174     
                   16175                     PUBLIC  ?B_NBANKS, ?B_MODE, ?B_CURRENTBANK, ?B_MASK
                   16176                     PUBLIC  ?B_FACTOR, ?B_RST_BANK
                             ENDIF
                   16180     
                   16181     ; Standard SFR Symbols required in L51_BANK.A51
  00E0             16182     ACC     DATA    0E0H
  00F0             16183     B       DATA    0F0H
  0082             16184     DPL     DATA    82H
  0083             16185     DPH     DATA    83H
  00A8             16186     IE      DATA    0A8H
  00AF             16187     EA      BIT     IE.7
                   16188     
                   16189     
                   16190     ; generate Mask and Bank Number Information
                             ELSEIF  ?B_NBANKS <= 16
  000F             16198       MASK          EQU     00001111B
A51 MACRO ASSEMBLER  L51_BANK                                                             09/20/2026 19:43:01 PAGE    69

                             ENDIF
                   16204     
