                   15997     $nomod51  NOLINES
                   15998     $nocond 
                   15999     ;------------------------------------------------------------------------------
                   16000     ;  This file is part of the BL51 / LX51 Banked Linker/Locater package
                   16001     ;  Copyright (c) 1988 - 2001 Keil Elektronik GmbH and Keil Software, Inc.
                   16002     ;  Version 2.21 (Code and Variable Banking for Classic 8051 Derivatives)
                   16003     ;------------------------------------------------------------------------------
A51 MACRO ASSEMBLER  L51_BANK                                                             09/18/2026 16:57:19 PAGE    67

                   16004     ;************************ Configuration Section *******************************
                   16005     ; Define maximum Number of Banks                                              *
  0010             16006     ?B_NBANKS       EQU  0x10;                  *
                   16007     ;                         ; following values are allowed: 2, 4, 8, 16, 32, 64 *
                   16008     ;                         ; for BL51 the maximum value for ?B_BANKS is 32     *
                   16009     ;                         ; for LX51 the maximum value for ?B_BANKS is 64     *
                   16010     ;                                                                             *
  0001             16011     ?B_MODE         EQU  1    ; 0 for Bank-Switching via 8051 Port                *
                   16012     ;                         ; 1 for Bank-Switching via XDATA Port               *
                   16013     ;                         ; 4 for user-provided bank switch code              *
                   16014     ;                                                                             *
  0000             16015     ?B_RTX          EQU  0    ; 0 for applications without real-time OS           *
                   16016     ;                         ; 1 for applications using the RTX-51 real-time OS  *
                   16017     ;                                                                             *
  0000             16018     ?B_VAR_BANKING  EQU  0    ; Variable Banking via L51_BANK (far memory support)*
                   16019     ;                         ; 0 Variable Banking does not use L51_BANK.A51      *
                   16020     ;                         ; 1 Variable Banking uses this L51_BANK.A51 module  *
                   16021     ; Notes: ?B_VAR_BANKING uses the 'far' and 'far const' C51 memory types to    *
                   16022     ;        extent the space for variables in RAM and/or ROM of classic 8051     *
                   16023     ;        device.  The same hardware as for code banking is used.  Program     *
                   16024     ;        code banking and variable banking share the same hardware I/O pins.  *
                   16025     ;        The C51 Compiler must be used with the VARBANKING directive.         *
                   16026     ;        Variable Banking is only supported with the LX51 linker/locater.     *
                   16027     ;                                                                             *
  00FF             16028     ?B_RST_BANK     EQU  0xFF ; specifies the active code bank number after CPU   *
                   16029     ;                         ; Reset.  Used to reduce the entries in the         *
                   16030     ;                         ; INTERBANK CALL TABLE.  The value 0xFF disables    *
                   16031     ;                         ; this LX51 linker/locater optimization.            *
                   16032     ; Note:  Interbank Call Table optimization is only possible with LX51.        *
                   16033     ;                                                                             *
                   16034     ;-----------------------------------------------------------------------------*
                   16035     ;                                                                             *
                             ENDIF;                                                                        *
                   16048     ;                                                                             *
                   16049     IF  ?B_MODE = 1;                                                              *
                   16050     ;-----------------------------------------------------------------------------*
                   16051     ; if ?BANK?MODE is 1 define the following values                              *
                   16052     ; For Bank-Switching via XDATA Port define XDATA Port Address / Bits          *
  FFFF             16053     ?B_XDATAPORT    EQU     0FFFFH   ; default is XDATA Port Address 0FFFFH       *
  0000             16054     ?B_FIRSTBIT     EQU     0        ; default is Bit 0                           *
                   16055     ;-----------------------------------------------------------------------------*
                   16056     ENDIF;                                                                        *
                   16057     ;                                                                             *
                             ENDIF;                                                                        *
                   16116     ;                                                                             *
                             ENDIF;                                                                        *
                   16137     ;                                                                             *
                   16138     ;******************************************************************************
                   16139     ;                                                                             *
                   16140     ; THEORY OF OPERATION                                                         *
                   16141     ; -------------------                                                         *
                   16142     ; The section below describes the code generated by BL51 or LX51 and the      *
                   16143     ; operation of the L51_BANK.A51 module.  BL51/LX51 generates for each         *
                   16144     ; function that is located in a code memory bank and called from the common   *
                   16145     ; area or a different code bank and entry into the INTRABANK CALL TABLE.  The *
                   16146     ; INTRABANK CALL TABLE is located in the SEGMENT ?BANK?SELECT and listed in   *
                   16147     ; the Linker MAP file. The entries in that TABLE have the following format:   *
                   16148     ;                                                                             *
                   16149     ;   ?FCT?1:  MOV  DPTR,#FCT     ; Load Address of target FCT                  *
                   16150     ;            JMP  ?B_BANKn      ; Switch to Bank and Jump to Target Code      *
                   16151     ;                                                                             *
                   16152     ; Instead of directly calling the function FCT, the Linker changes the entry  *
                   16153     ; to ?FCT?1.  This entry selects the bank where the function FCT is located   *
                   16154     ; and calls that function via the routines defined in this L51_BANK.A51 file. *
                   16155     ; The L51_BANK.A51 file contains two sets of functions for each bank:         *
                   16156     ;                                                                             *
A51 MACRO ASSEMBLER  L51_BANK                                                             09/18/2026 16:57:19 PAGE    68

                   16157     ; ?B_BANKn    is a routine which saves the entry of the ?B_SWITCHn function   *
                   16158     ;             for the current active bank on the STACK and switches to the    *
                   16159     ;             bank 'n'.  Then it jumps to the address specified by the DPTR   *
                   16160     ;             register.  It is allowed to modify the following registers in   *
                   16161     ;             the ?B_BANKn routine:  A, B, R0, DPTR, PSW                      *
                   16162     ;                                                                             *
                   16163     ; ?B_SWITCHn  is a function which selects the bank 'n'.  This function is     *
                   16164     ;             used at the end of a user function to return to the calling     *
                   16165     ;             code bank.  Only the following registers may be altered in the  *
                   16166     ;             ?B_SWITCHn function:  R0, DPTR                                  *
                   16167     ;                                                                             *
                   16168     ; The current active bank is stored in ?B_CURRENTBANK.  RTX-51 uses this      *
                   16169     ; variable to restore the code bank after a task switch.  To get correct      *
                   16170     ; results, ?B_CURRENTBANK must be set to the code bank before the hardware    *
                   16171     ; switch is done, or the code banking sequences must be interrupt protected.  *
                   16172     ;******************************************************************************
                   16173     
                   16174                     NAME    ?BANK?SWITCHING
                   16175     
                   16176                     PUBLIC  ?B_NBANKS, ?B_MODE, ?B_CURRENTBANK, ?B_MASK
                   16177                     PUBLIC  ?B_FACTOR, ?B_RST_BANK
                             ENDIF
